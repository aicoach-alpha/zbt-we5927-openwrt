#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

start_service() {
	# A disabled automatic checker must not allocate a resident shell/sleep.
	# Manual firmware checks are provided by VeCI RPC independently.
	[ "$(uci -q get veci.update.auto_check 2>/dev/null)" = "1" ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/veci-update-agent
	procd_set_param respawn 3600 5 5
	procd_close_instance
}


service_triggers() {
	# Reconfigure this procd instance when auto_check changes via UCI
	# and the caller issues reload_config.
	procd_add_reload_trigger veci
}
