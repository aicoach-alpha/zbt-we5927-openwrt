#!/bin/sh
TAG=we5927-lte
CFG=we5927_lte.main
STATE=/tmp/we5927-lte.state
STATUS_CACHE=/tmp/we5927-lte.status.json
STATUS_CACHE_TS=/tmp/we5927-lte.status.ts
STATUS_CACHE_LOCK=/tmp/we5927-lte.status.lock

log() {
	logger -t "$TAG" "$*"
	echo "$*" >&2
}

cfg() {
	uci -q get "$CFG.$1"
}

enabled() {
	local v
	v="$(cfg enabled)"
	[ -n "$v" ] || v=1
	[ "$v" = "1" ]
}

gpio_path() {
	local n="$1"
	local p=""

	case "$n" in
		1)
			[ -e /sys/class/gpio/modem_power/value ] && p=/sys/class/gpio/modem_power
			;;
		46)
			[ -e /sys/class/gpio/sim_select/value ] && p=/sys/class/gpio/sim_select
			;;
	esac

	if [ -z "$p" ]; then
		p="/sys/class/gpio/gpio$n"
		if [ ! -e "$p/value" ]; then
			echo "$n" > /sys/class/gpio/export 2>/dev/null || true
			sleep 1
		fi
		[ -e "$p/value" ] || return 1
		[ -e "$p/direction" ] && echo out > "$p/direction" 2>/dev/null || true
	fi

	echo "$p"
}

gpio_set() {
	local n="$1"
	local v="$2"
	local p
	p="$(gpio_path "$n")" || return 1
	echo "$v" > "$p/value"
}

gpio_get() {
	local p
	p="$(gpio_path "$1")" || return 1
	cat "$p/value"
}

port_responds() {
	local p="$1"
	[ -c "$p" ] || return 1
	/usr/sbin/we5927-at "$p" AT 700 >/dev/null 2>&1
}

at_port() {
	local t p preferred devpath
	preferred="$(cfg at_port)"

	# CX07E verified AT function is USB interface 1.4.
	# Resolve the current ttyUSB name from sysfs instead of probing ports,
	# because probing the non-AT 1.5 function can enter uninterruptible I/O.
	for t in /sys/class/tty/ttyUSB*; do
		[ -e "$t/device" ] || continue
		devpath="$(readlink -f "$t/device" 2>/dev/null || true)"
		case "$devpath" in
			*/1-1:1.4/*)
				p="/dev/$(basename "$t")"
				[ -c "$p" ] && {
					echo "$p"
					return 0
				}
				;;
		esac
	done

	# Only the verified 1.4 interface may be used. On this hardware
	# ttyUSB3 is function 1.5 and probing it can hang USB I/O.
	for p in "$preferred" /dev/ttyUSB2; do
		[ "$p" = /dev/ttyUSB2 ] || continue
		[ -c "$p" ] && { echo "$p"; return 0; }
	done
	return 1
}

at() {
	local p
	local timeout
	local rc
	p="$(at_port)"
	timeout="$2"
	[ -n "$timeout" ] || timeout=2500
	[ -c "$p" ] || return 1

	# Serialize AT access between the watchdog daemon and LuCI status/actions.
	# util-linux flock is part of the selected LuCI/OpenWrt image.
	(
		# Never let LuCI/status wait indefinitely behind a stuck AT client.
		flock -n -x 9 || exit 75
		/usr/sbin/we5927-at "$p" "$1" "$timeout"
	) 9>/var/lock/we5927-at.lock
	rc=$?
	return "$rc"
}

usb_device_dir() {
	local d vid pid
	vid="$(cfg usb_vid)"
	pid="$(cfg usb_pid)"
	[ -n "$vid" ] || vid=05c6
	[ -n "$pid" ] || pid=902e

	for d in /sys/bus/usb/devices/*; do
		[ -f "$d/idVendor" ] || continue
		[ -f "$d/idProduct" ] || continue
		[ "$(cat "$d/idVendor" 2>/dev/null)" = "$vid" ] || continue
		[ "$(cat "$d/idProduct" 2>/dev/null)" = "$pid" ] || continue
		echo "$d"
		return 0
	done
	return 1
}

driver_name() {
	local x
	x="$(readlink -f "$1/driver" 2>/dev/null)" || return 1
	basename "$x"
}

repair_rndis() {
	local dev base i cls sub proto drv ctrl=""

	dev="$(usb_device_dir)" || return 1
	base="$(basename "$dev")"

	modprobe rndis_host >/dev/null 2>&1 || true

	for i in "$dev":1.*; do
		[ -d "$i" ] || continue
		cls="$(cat "$i/bInterfaceClass" 2>/dev/null)"
		sub="$(cat "$i/bInterfaceSubClass" 2>/dev/null)"
		proto="$(cat "$i/bInterfaceProtocol" 2>/dev/null)"
		drv="$(driver_name "$i" 2>/dev/null || true)"

		if [ "$cls" = "e0" ] && [ "$sub" = "01" ] && [ "$proto" = "03" ]; then
			ctrl="$(basename "$i")"
			[ "$drv" = "option" ] && echo "$(basename "$i")" > /sys/bus/usb/drivers/option/unbind 2>/dev/null || true
		elif [ "$cls" = "0a" ]; then
			[ "$drv" = "option" ] && echo "$(basename "$i")" > /sys/bus/usb/drivers/option/unbind 2>/dev/null || true
		fi
	done

	[ -n "$ctrl" ] || return 1
	drv="$(driver_name "/sys/bus/usb/devices/$ctrl" 2>/dev/null || true)"
	if [ "$drv" != "rndis_host" ]; then
		echo "$ctrl" > /sys/bus/usb/drivers/rndis_host/bind 2>/dev/null || true
	fi

	local n=0
	while [ "$n" -lt 10 ]; do
		ip link show usb0 >/dev/null 2>&1 && return 0
		n=$((n + 1))
		sleep 1
	done
	return 1
}

usb_repair() {
	# Do not unbind/rebind an already healthy RNDIS+AT pair.
	# Re-enumeration can interrupt active LTE traffic or SMS transactions.
	if ip link show usb0 >/dev/null 2>&1; then
		local live_port
		live_port="$(at_port)"
		[ -c "$live_port" ] && return 0
	fi
	modprobe usbserial >/dev/null 2>&1 || true
	modprobe usb_wwan >/dev/null 2>&1 || true
	modprobe option >/dev/null 2>&1 || true
	modprobe cdc_ether >/dev/null 2>&1 || true
	modprobe rndis_host >/dev/null 2>&1 || true

	bind_option
	sleep 1
	repair_rndis || true
}

bind_option() {
	local vid pid
	vid="$(cfg usb_vid)"
	pid="$(cfg usb_pid)"
	[ -n "$vid" ] || vid=05c6
	[ -n "$pid" ] || pid=902e

	# Safe to retry: duplicate IDs return an error which we intentionally ignore.
	# This makes serial AT binding robust even if another ttyUSB device exists.
	if [ -w /sys/bus/usb-serial/drivers/option1/new_id ]; then
		echo "$vid $pid" > /sys/bus/usb-serial/drivers/option1/new_id 2>/dev/null || true
	fi
}

wait_at() {
	local i p
	i=0
	usb_repair

	while [ "$i" -lt 30 ]; do
		p="$(at_port)"
		if [ -c "$p" ] && at AT 1000 >/dev/null 2>&1; then
			return 0
		fi
		[ $((i % 5)) -eq 0 ] && usb_repair
		i=$((i + 1))
		sleep 1
	done

	return 1
}

ensure_network() {
 local dev metric z changed key value spec
 dev="$(cfg data_if)"
 metric="$(cfg metric)"
 [ -n "$dev" ] || dev=usb0
 [ -n "$metric" ] || metric=5
 changed=0
 # Avoid repeated UCI flash writes and avoid changing LAN/Wi-Fi settings.
 if [ "$(uci -q get network.lte 2>/dev/null)" != interface ]; then
   uci set network.lte=interface
   changed=1
 fi
 for spec in "device:$dev" "proto:dhcp" "metric:$metric" "peerdns:1"; do
   key="$(echo "$spec" | cut -d: -f1)"
   value="$(echo "$spec" | cut -d: -f2-)"
   if [ "$(uci -q get "network.lte.$key" 2>/dev/null)" != "$value" ]; then
     uci set "network.lte.$key=$value"
     changed=1
   fi
 done
 [ "$changed" = 0 ] || uci commit network

 z="$(uci -q show firewall | sed -n "s/^\(firewall\.@zone\[[0-9]\+\]\)\.name='wan'$/\1/p" | head -n1)"
 if [ -n "$z" ] && ! uci -q get "$z.network" | grep -qw lte; then
   uci add_list "$z.network=lte"
   uci commit firewall
   /etc/init.d/firewall reload >/dev/null 2>&1 || true
 fi
}

set_sim() {
	local slot n v

	slot="$1"
	n="$(cfg sim_gpio)"
	[ -n "$n" ] || n=46

	case "$slot" in
		1)
			v="$(cfg sim1_value)"
			[ -n "$v" ] || v=1
			;;
		2)
			v="$(cfg sim2_value)"
			[ -n "$v" ] || v=0
			;;
		*)
			echo "usage: $0 sim 1|2" >&2
			return 2
			;;
	esac

	gpio_set "$n" "$v" || return 1
	# Always drive the physical GPIO on cold boot, but do not write flash
	# if the persisted SIM selection is already correct.
	if [ "$(cfg sim)" != "$slot" ]; then
		uci set "$CFG.sim=$slot"
		uci commit we5927_lte
	fi
	echo "sim=$slot" > "$STATE"
	log "SIM selector changed to SIM$slot (GPIO$n value=$v)"
}

power_on() {
	local n active
	n="$(cfg modem_gpio)"
	active="$(cfg modem_active)"
	[ -n "$n" ] || n=1
	[ -n "$active" ] || active=1
	gpio_set "$n" "$active"
}

power_cycle() {
	local n active off

	n="$(cfg modem_gpio)"
	active="$(cfg modem_active)"
	[ -n "$n" ] || n=1
	[ -n "$active" ] || active=1

	if [ "$active" = "1" ]; then
		off=0
	else
		off=1
	fi

	log "Hard power-cycle modem on GPIO$n"
	gpio_set "$n" "$off" || true
	sleep 3
	gpio_set "$n" "$active" || true
	sleep 10

	usb_repair
	wait_at || true
	ifup lte >/dev/null 2>&1 || true
}

apply_apn() {
	local apn

	apn="$(cfg apn)"
	[ -n "$apn" ] || apn=internet

	wait_at || return 1

	at "AT+CGDCONT=1,\"IPV4V6\",\"$apn\"" 3000 >/dev/null 2>&1 || \
	at "AT+CGDCONT=1,\"IP\",\"$apn\"" 3000 >/dev/null 2>&1 || true
}

sim_ready() {
	wait_at || return 1
	at 'AT+CPIN?' 2000 2>/dev/null | grep -q 'READY'
}

soft_reconnect() {
 local p rc
 log "Escalated LTE radio reconnect: exclusive AT lock"
 wait_at || return 1
 apply_apn || true
 p="$(at_port)"
 [ -c "$p" ] || return 1
 (
   # Shared lock prevents collision with active SMS send/read/delete.
   flock -n -x 9 || exit 75
   /usr/sbin/we5927-at "$p" "AT+CFUN=0" 3000 >/dev/null 2>&1 || exit 1
   sleep 2
   /usr/sbin/we5927-at "$p" "AT+CFUN=1" 8000 >/dev/null 2>&1 || exit 1
 ) 9>/var/lock/we5927-at.lock
 rc=$?
 [ "$rc" -eq 0 ] || {
   log "CFUN reconnect failed or SMS AT channel busy; no forced override"
   return 1
 }
 sleep 4
 usb_repair
 ifup lte >/dev/null 2>&1 || true
}

data_ok() {
 local dev host
 dev="$(cfg data_if)"
 host="$(cfg ping_host)"
 [ -n "$dev" ] || dev=usb0
 [ -n "$host" ] || host=1.1.1.1
 ip link show "$dev" >/dev/null 2>&1 || return 1
 ip -4 addr show dev "$dev" | grep -q "inet " || return 1
 # Two independent remote targets; never reset for one failed ping.
 ping -I "$dev" -c 1 -W 1 "$host" >/dev/null 2>&1 && return 0
 [ "$host" = "8.8.8.8" ] || ping -I "$dev" -c 1 -W 1 8.8.8.8 >/dev/null 2>&1
}

# HTTPS is diagnostic only when both public ICMP targets fail.
# Bounded five-second IPv4 request with normal CA validation.
https_ok() {
 command -v uclient-fetch >/dev/null 2>&1 || return 1
 uclient-fetch -4 -q -T 5 -O /dev/null \
    'https://www.cloudflare.com/cdn-cgi/trace' >/dev/null 2>&1
}

# VeCI PDP diagnostic on real degraded WAN events only.
# Read-only AT, shared lock, no SIM identity, no modem control.
wan_pdp_diag() {
  [ "$2" = icmp_and_https_failed ] || return 0
  local att pdp a c file
  att="$(at 'AT+CGATT?' 1500 2>/dev/null || true)"
  pdp="$(at 'AT+CGACT?' 1500 2>/dev/null || true)"
  case "$att" in *'+CGATT: 1'*) a=1;; *'+CGATT: 0'*) a=0;; *) a=unknown;; esac
  case "$pdp" in *'+CGACT: 1,1'*) c=1;; *'+CGACT: 1,0'*) c=0;; *) c=unknown;; esac
  file="/overlay/veci-reliability/wan-pdp-$(date +%Y%m%d).csv"
  [ -s "$file" ] || printf 'epoch,attached,cid1_active\n' >> "$file"
  printf '%s,%s,%s\n' "$1" "$a" "$c" >> "$file"
}

wan_diag_event() {
 # Write on degraded events, never on healthy ten-second polls.
 # No IP, SIM, MAC, location, APN, or SMS identifiers.
 local directory file free now
 directory=/overlay/veci-reliability
 [ -d "$directory" ] || return 0
 free="$(df -k /overlay 2>/dev/null | awk 'NR==2{print $4}')"
 case "$free" in ''|*[!0-9]*) return 0;; esac
 [ "$free" -ge 300 ] || return 0
 now="$(date +%s)"
 file="$directory/wan-health-$(date +%Y%m%d).csv"
 if [ ! -s "$file" ]; then
   printf 'epoch,classification,action\n' >> "$file"
 fi
 printf '%s,%s,%s\n' "$now" "$1" "$2" >> "$file"
  wan_pdp_diag "$now" "$1"
}

gateway_ok() {
 local dev gw
 dev="$(cfg data_if)"
 [ -n "$dev" ] || dev=usb0
 ip link show "$dev" >/dev/null 2>&1 || return 1
 ip -4 addr show dev "$dev" | grep -q "inet " || return 1
 gw="$(ip -4 route show default dev "$dev" 2>/dev/null | awk '/^default via /{print $3;exit}')"
 case "$gw" in ''|*[!0-9.]*) return 1 ;; esac
  ping -I "$dev" -c 1 -W 1 "$gw" >/dev/null 2>&1 && return 0
  # A missed gateway ICMP response is not proof that RNDIS/IPv4 is down.
  # Do not flap a configured modem datapath on a transient ICMP failure.
  [ "$(cat "/sys/class/net/$dev/carrier" 2>/dev/null)" = 1 ]
}

# Conservative last-resort guard. If RNDIS+IP remain present and the
# cellular packet service says "attached", do not toggle modem power for
# ICMP-only failures. An AT channel busy with SMS is not proof of radio loss.
# Read-only and privacy-preserving. RNDIS IP alone does not prove
# SIM/operator/PDP readiness. No IMSI, no CFUN, no SIM GPIO, no DHCP.
modem_readiness_phase() {
 local dev p response reg
 dev="$(cfg data_if)"
 [ -n "$dev" ] || dev=usb0
 ip link show "$dev" >/dev/null 2>&1 || { echo usb_missing; return 0; }
 p="$(at_port 2>/dev/null)" || { echo at_unavailable; return 0; }
 [ -c "$p" ] || { echo at_unavailable; return 0; }
 response="$(at 'AT+CPIN?' 1500 2>/dev/null)" ||
   { echo at_busy_or_unavailable; return 0; }
 case "$response" in
   *'+CPIN: READY'*) ;;
   *'+CPIN: SIM PIN'*) echo sim_pin_required; return 0 ;;
   *'+CPIN: SIM PUK'*) echo sim_puk_required; return 0 ;;
   *'+CPIN:'*) echo sim_not_ready; return 0 ;;
   *) echo sim_unknown; return 0 ;;
 esac
 response="$(at 'AT+CEREG?' 1500 2>/dev/null)" ||
   { echo registration_unavailable; return 0; }
 reg="$(printf '%s\n' "$response" |
   sed -n 's/.*+CEREG:[[:space:]]*[0-9]*,[[:space:]]*\([0-9]\).*/\1/p' | head -n 1)"
 case "$reg" in
   1|5) ;;
   3) echo registration_denied; return 0 ;;
   0|2|4) echo searching_for_operator; return 0 ;;
   *) echo registration_unknown; return 0 ;;
 esac
 response="$(at 'AT+CGATT?' 1500 2>/dev/null)" ||
   { echo packet_attach_unavailable; return 0; }
 case "$response" in
   *'+CGATT: 1'*) echo packet_attached; return 0 ;;
   *'+CGATT: 0'*) echo packet_detached; return 0 ;;
   *) echo packet_attach_unknown; return 0 ;;
 esac
}

radio_or_link_lost() {
 local dev p state carrier
 dev="$(cfg data_if)"
 [ -n "$dev" ] || dev=usb0
 # A disappearing USB/RNDIS interface is physical evidence of link loss.
 ip link show "$dev" >/dev/null 2>&1 || return 0
 carrier="$(cat "/sys/class/net/$dev/carrier" 2>/dev/null || true)"
 [ "$carrier" = 0 ] && return 0
 # Missing DHCP IPv4 alone is NOT proof that a healthy PDP session is down.
 # If modem AT is busy (for example SMS), fail closed: no radio reset.
 p="$(at_port)" || return 1
 [ -c "$p" ] || return 1
 state="$(at 'AT+CGATT?' 1500 2>/dev/null)" || return 1
 case "$state" in
   *'+CGATT: 0'*) return 0 ;;
   *) return 1 ;;
 esac
}

renew_lte() {
 local n
 log "LTE fast recovery: renew existing DHCP lease"
 # A failed ubus renew is not permission to run ifup, which may release
 # a still-valid DHCP lease and briefly remove the default route.
 if ! ubus call network.interface.lte renew '{}' >/dev/null 2>&1; then
   log "LTE DHCP renew request failed; keeping interface unchanged"
   return 1
 fi
 # The modem needs time after a renew. Public ICMP/HTTPS failure is
 # upstream-only evidence and must never trigger an immediate ifdown.
 n=0
 while [ "$n" -lt 5 ]; do
   sleep 2
   gateway_ok && return 0
   n=$((n + 1))
 done
 return 1
}

repair_lte_interface() {
 # Recheck the local gateway before any disruptive interface teardown.
 # A brief RNDIS carrier blip must not immediately release the lease.
 sleep 3
 if gateway_ok; then
   log "LTE local gateway recovered; skipping interface teardown"
   return 0
 fi
 log "LTE interface recovery: netifd LTE only, preserve Wi-Fi and modem"
 ifdown lte >/dev/null 2>&1 || true
 sleep 1
 ifup lte >/dev/null 2>&1 || true
 sleep 3
 gateway_ok
}

manual_reconnect() {
 # User-initiated recovery should never release a healthy DHCP lease or
 # reset LTE merely because a remote probe is filtered.
 if data_ok || gateway_ok; then
   log "LTE datapath is present; manual reconnect suppressed to avoid downtime"
   return 0
 fi
 renew_lte && return 0
 gateway_ok && return 0
 repair_lte_interface && return 0
 gateway_ok && return 0
 # CFUN changes the cellular registration and can interrupt active SMS.
 # Only permit it after independent evidence that the modem is detached.
 if radio_or_link_lost; then
   soft_reconnect
 else
   log "LTE reconnect held: RNDIS/PDP state does not prove radio loss"
   return 1
 fi
}

clamped_number() {
 case ${1:-} in ''|*[!0-9]*) echo "$2"; return ;; esac
 if [ "$1" -lt "$3" ]; then echo "$3"
 elif [ "$1" -gt "$4" ]; then echo "$4"
 else echo "$1"; fi
}

performance_state() {
 # tmpfs only; bounded metadata without APN, IMSI, SMS, IP or credentials.
 printf 'failures=%s recoveries=%s stage=%s modem_phase=%s timestamp=%s
' "$failures" "$recoveries" "$stage" "$radio_phase" "$(date +%s)" > /tmp/veci-lte-performance.state
}

clean_line() {
	tr '\r\n' '  ' | sed 's/[[:space:]][[:space:]]*/ /g; s/^ //; s/ $//'
}


refresh_status_cache() {
	. /usr/share/libubox/jshn.sh
	local tmp model_check imei_check operator_check
	tmp="$STATUS_CACHE.$$"

	status_json >"$tmp" 2>/dev/null || {
		rm -f "$tmp"
		return 1
	}

	json_load "$(cat "$tmp" 2>/dev/null)" 2>/dev/null || {
		rm -f "$tmp"
		return 1
	}
	json_get_var model_check model
	json_get_var imei_check imei
	json_get_var operator_check operator

	[ -n "$model_check$imei_check$operator_check" ] || {
		rm -f "$tmp"
		return 1
	}

	mv "$tmp" "$STATUS_CACHE"
	date +%s >"$STATUS_CACHE_TS"
	return 0
}

maybe_refresh_status_cache() {
	local now last
	now="$(date +%s 2>/dev/null)"
	last="$(cat "$STATUS_CACHE_TS" 2>/dev/null)"
	case "$last" in
		''|*[!0-9]*) last=0 ;;
	esac

	[ -n "$now" ] || return 0
	if [ ! -s "$STATUS_CACHE" ] || [ $((now - last)) -ge 60 ]; then
		(
			mkdir "$STATUS_CACHE_LOCK" 2>/dev/null || exit 0
			trap 'rmdir "$STATUS_CACHE_LOCK" 2>/dev/null' 0 1 2 15
			"$0" refresh-cache >/dev/null 2>&1
		) >/dev/null 2>&1 &
	fi
}


# Deliberately read-only and on demand; never used by the poller.
# This issues AT+CGSN only through the serialized, bounded AT transport.
imei_read_json() {
	local response number
	response="$(at 'AT+CGSN' 1500 2>/dev/null)" || {
		printf '{ "ok": false, "error": "modem_at_busy_or_unavailable" }\n'
		return
	}
	number="$(printf '%s\n' "$response" | tr -d '\r' | grep -E '^[[:space:]]*[0-9]{15}[[:space:]]*$' | head -n 1 | tr -dc '0-9')"
	case "$number" in
		???????????????) ;;
		*) number='' ;;
	esac
	case "$number" in
		''|*[!0-9]*)
			printf '{ "ok": false, "error": "modem_imei_not_returned" }\n'
			return
			;;
	esac
	. /usr/share/libubox/jshn.sh
	json_init
	json_add_boolean ok 1
	json_add_string imei "$number"
	json_add_string source 'at_cgsn_live'
	json_dump
}

status_fast_json() {
	. /usr/share/libubox/jshn.sh

	local dev sim p ip4 gateway online data_link runtime_stage modem_phase sample_time now
	local manufacturer model revision imei iccid sim_status operator access_tech
	local registration eps_registration circuit_registration registration_status
	local packet_attach packet_status extended_error csq signal_percent signal_dbm registration_denied

	manufacturer=""
	model=""
	revision=""
	imei=""
	iccid=""
	sim_status=""
	operator=""
	access_tech=""
	registration=""
	eps_registration=""
	circuit_registration=""
	registration_status=""
	packet_attach=""
	packet_status=""
	extended_error=""
	csq=""
	signal_percent=""
	signal_dbm=""
	registration_denied=0

	if [ -s "$STATUS_CACHE" ] && json_load "$(cat "$STATUS_CACHE" 2>/dev/null)" 2>/dev/null; then
		json_get_var manufacturer manufacturer
		json_get_var model model
		json_get_var revision revision
		json_get_var imei imei
		json_get_var iccid iccid
		json_get_var sim_status sim_status
		json_get_var operator operator
		json_get_var access_tech access_tech
		json_get_var registration registration
		json_get_var eps_registration eps_registration
		json_get_var circuit_registration circuit_registration
		json_get_var registration_status registration_status
		json_get_var packet_attach packet_attach
		json_get_var packet_status packet_status
		json_get_var extended_error extended_error
		json_get_var csq csq
		json_get_var signal_percent signal_percent
		json_get_var signal_dbm signal_dbm
		json_get_var registration_denied registration_denied
	fi

	dev="$(cfg data_if)"
	sim="$(cfg sim)"
	p="$(at_port)"
	[ -n "$dev" ] || dev=usb0
	[ -n "$sim" ] || sim=1
	[ -n "$p" ] || p=/dev/ttyUSB2

	ip4="$(ip -4 -o addr show dev "$dev" 2>/dev/null | awk '{print $4}' | head -1)"
	gateway="$(ip route show default dev "$dev" 2>/dev/null | awk '/default via/ {print $3; exit}')"
	# DHCP gateway means local USB connectivity only. A valid Internet
	# status requires a recent daemon reachability/HTTPS confirmation.
	data_link=0
	online=0
	[ -n "$ip4" ] && [ -n "$gateway" ] && data_link=1
	runtime_stage="$(awk '{for (i=1;i<=NF;i++) if ($i ~ /^stage=/) {sub(/^stage=/,"",$i);print $i;exit}}' /tmp/veci-lte-performance.state 2>/dev/null)"
	modem_phase="$(awk '{for (i=1;i<=NF;i++) if ($i ~ /^modem_phase=/) {sub(/^modem_phase=/,"",$i);print $i;exit}}' /tmp/veci-lte-performance.state 2>/dev/null)"
	sample_time="$(awk '{for (i=1;i<=NF;i++) if ($i ~ /^timestamp=/) {sub(/^timestamp=/,"",$i);print $i;exit}}' /tmp/veci-lte-performance.state 2>/dev/null)"
	now="$(date +%s 2>/dev/null)"
	case "$sample_time:$now" in *[!0-9:]*|:*) sample_time=0; now=0;; esac
	if [ "$data_link" = 1 ] && [ "$sample_time" -gt 0 ] &&
	   [ "$now" -ge "$sample_time" ] && [ $((now-sample_time)) -le 180 ]; then
		case "$runtime_stage" in
			healthy|icmp_degraded_https_ok) online=1;;
		esac
	fi
	[ -n "$modem_phase" ] || modem_phase=unknown

	json_init
	json_add_boolean enabled "$(enabled && echo 1 || echo 0)"
	json_add_string board "ZBT-WE5927 / WE2825-2SIM"
	json_add_string wifi "2.4 GHz single-band"
	json_add_string mode "RNDIS"
	json_add_string data_interface "$dev"
	json_add_string ipv4 "$ip4"
	json_add_string gateway "$gateway"
	json_add_int sim "$sim"
	json_add_string at_port "$p"
	json_add_string manufacturer "$manufacturer"
	json_add_string model "$model"
	json_add_string revision "$revision"
	json_add_string imei "$imei"
	json_add_string iccid "$iccid"
	json_add_string sim_status "$sim_status"
	json_add_string operator "$operator"
	json_add_string access_tech "$access_tech"
	json_add_string registration "$registration"
	json_add_string eps_registration "$eps_registration"
	json_add_string circuit_registration "$circuit_registration"
	json_add_string registration_status "$registration_status"
	json_add_string packet_attach "$packet_attach"
	json_add_string packet_status "$packet_status"
	json_add_string extended_error "$extended_error"
	json_add_string csq "$csq"
	case "$signal_percent" in
		''|*[!0-9]*) ;;
		*) json_add_int signal_percent "$signal_percent" ;;
	esac
	case "$signal_dbm" in
		''|'-'|*[!0-9-]*) ;;
		*) json_add_int signal_dbm "$signal_dbm" ;;
	esac
	case "$registration_denied" in
		1|true) json_add_boolean registration_denied 1 ;;
		*) json_add_boolean registration_denied 0 ;;
	esac
	json_add_boolean data_link_up "$data_link"
	json_add_boolean internet_verified "$online"
	json_add_boolean online "$online"
	json_add_string modem_phase "$modem_phase"
	json_add_string status_source "cached-safe"
	json_dump

	maybe_refresh_status_cache
}

status_json() {
	. /usr/share/libubox/jshn.sh

	local dev p sim
	local cpin iccid cops csq cgreg cereg creg cgatt ceer ati model manufacturer revision imei ip4 pct n dbm
	local operator_name access_code access_tech reg_code reg_status attach_code attach_status denied gateway

	dev="$(cfg data_if)"
	p="$(at_port)"
	sim="$(cfg sim)"
	[ -n "$dev" ] || dev=usb0
	[ -n "$sim" ] || sim=1

	cpin=""
	iccid=""
	cops=""
	csq=""
	cgreg=""
	cereg=""
	creg=""
	cgatt=""
	ceer=""
	ati=""
	model=""
	manufacturer=""
	revision=""
	imei=""
	ip4=""
	pct=0
	dbm=""
	operator_name=""
	access_code=""
	access_tech=""
	reg_code=""
	reg_status=""
	attach_code=""
	attach_status=""
	denied=0
	gateway=""

	if [ -c "$p" ] && at 'AT' 700 >/dev/null 2>&1; then
		cpin="$(at 'AT+CPIN?' 1200 2>/dev/null | grep '+CPIN:' | tail -1 | cut -d: -f2- | clean_line)"
		iccid="$(at 'AT+ICCID' 1200 2>/dev/null | sed -n 's/.*ICCID:[[:space:]]*\([0-9A-Fa-f]*\).*/\1/p' | tail -1 | sed 's/[Ff]$//')"
		cops="$(at 'AT+COPS?' 1200 2>/dev/null | grep '+COPS:' | tail -1 | clean_line)"
		csq="$(at 'AT+CSQ' 1200 2>/dev/null | grep '+CSQ:' | tail -1 | clean_line)"
		cgreg="$(at 'AT+CGREG?' 1200 2>/dev/null | grep '+CGREG:' | tail -1 | clean_line)"
		cereg="$(at 'AT+CEREG?' 1200 2>/dev/null | grep '+CEREG:' | tail -1 | clean_line)"
		creg="$(at 'AT+CREG?' 1200 2>/dev/null | grep '+CREG:' | tail -1 | clean_line)"
		cgatt="$(at 'AT+CGATT?' 1200 2>/dev/null | grep '+CGATT:' | tail -1 | clean_line)"
		ceer="$(at 'AT+CEER' 1500 2>/dev/null | grep -vE '^(AT|OK|ERROR)[[:space:]]*$' | clean_line)"
		ati="$(at 'ATI' 1500 2>/dev/null)"
		manufacturer="$(echo "$ati" | sed -n 's/^[[:space:]]*Manufacturer:[[:space:]]*//p' | head -1 | clean_line)"
		model="$(echo "$ati" | sed -n 's/^[[:space:]]*Model:[[:space:]]*//p' | head -1 | clean_line)"
		revision="$(echo "$ati" | sed -n 's/^[[:space:]]*Revision:[[:space:]]*//p' | head -1 | clean_line)"
		imei="$(echo "$ati" | sed -n 's/.*IMEI:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -1 | tr -dc '0-9')"
		[ -n "$imei" ] || imei="$(at 'AT+CGSN' 1200 2>/dev/null | grep -E '^[[:space:]]*[0-9]{15}[[:space:]]*$' | tail -1 | tr -dc '0-9')"
	fi

	ip4="$(ip -4 -o addr show dev "$dev" 2>/dev/null | awk '{print $4}' | head -1)"
	gateway="$(ip route show default dev "$dev" 2>/dev/null | awk '/default via/ {print $3; exit}')"

	n="$(echo "$csq" | sed -n 's/.*+CSQ:[[:space:]]*\([0-9][0-9]*\).*/\1/p')"
	case "$n" in
		""|99)
			pct=0
			;;
		*)
			[ "$n" -gt 31 ] && n=31
			pct=$((n * 100 / 31))
			dbm=$((-113 + 2 * n))
			;;
	esac

	operator_name="$(echo "$cops" | sed -n 's/.*+COPS:[^"]*"\([^"]*\)".*/\1/p')"
	access_code="$(echo "$cops" | sed -n 's/.*,[[:space:]]*\([0-9][0-9]*\)[[:space:]]*$/\1/p')"
	case "$access_code" in
		0) access_tech="GSM" ;;
		2) access_tech="UMTS" ;;
		7) access_tech="LTE" ;;
		9) access_tech="LTE NB-IoT" ;;
		11|12) access_tech="5G NR" ;;
		*) access_tech="$access_code" ;;
	esac

	reg_code="$(echo "$cereg" | sed -n 's/.*+CEREG:[[:space:]]*[0-9][0-9]*,[[:space:]]*\([0-9][0-9]*\).*/\1/p')"
	[ -n "$reg_code" ] || reg_code="$(echo "$cereg" | sed -n 's/.*+CEREG:[[:space:]]*\([0-9][0-9]*\).*/\1/p')"
	case "$reg_code" in
		1) reg_status="Registered (home)" ;;
		5) reg_status="Registered (roaming)" ;;
		2) reg_status="Searching" ;;
		3) reg_status="Registration denied"; denied=1 ;;
		4) reg_status="Unknown" ;;
		0) reg_status="Not registered" ;;
		*) reg_status="$cereg" ;;
	esac

	attach_code="$(echo "$cgatt" | sed -n 's/.*+CGATT:[[:space:]]*\([01]\).*/\1/p')"
	case "$attach_code" in
		1) attach_status="Attached" ;;
		0) attach_status="Detached" ;;
		*) attach_status="$cgatt" ;;
	esac

	json_init
	json_add_boolean enabled "$(enabled && echo 1 || echo 0)"
	json_add_string board "ZBT-WE5927 / WE2825-2SIM"
	json_add_string wifi "2.4 GHz single-band"
	json_add_string mode "RNDIS"
	json_add_string data_interface "$dev"
	json_add_string ipv4 "$ip4"
	json_add_string gateway "$gateway"
	json_add_int sim "$sim"
	json_add_string at_port "$p"
	json_add_string manufacturer "$manufacturer"
	json_add_string model "$model"
	json_add_string revision "$revision"
	json_add_string imei "$imei"
	json_add_string iccid "$iccid"
	json_add_string sim_status "$cpin"
	json_add_string operator "$operator_name"
	json_add_string access_tech "$access_tech"
	json_add_string registration "$cgreg"
	json_add_string eps_registration "$cereg"
	json_add_string circuit_registration "$creg"
	json_add_string registration_status "$reg_status"
	json_add_string packet_attach "$cgatt"
	json_add_string packet_status "$attach_status"
	json_add_string extended_error "$ceer"
	json_add_boolean registration_denied "$denied"
	json_add_string csq "$csq"
	json_add_int signal_percent "$pct"
	[ -n "$dbm" ] && json_add_int signal_dbm "$dbm"

	if data_ok; then
		json_add_boolean online 1
	else
		json_add_boolean online 0
	fi

	json_dump
}

auto_switch_sim() {
	local old="$1" new="$2" i

	log "automatic dual-SIM failover trial: SIM$old -> SIM$new"
	set_sim "$new" || return 1
	power_cycle

	if ! sim_ready; then
		log "SIM$new not detected; reverting to SIM$old"
		set_sim "$old" || true
		power_cycle
		apply_apn || true
		ifup lte >/dev/null 2>&1 || true
		return 1
	fi

	apply_apn || true
	ifup lte >/dev/null 2>&1 || true

	i=0
	while [ "$i" -lt 12 ]; do
		data_ok && {
			log "automatic dual-SIM failover succeeded on SIM$new"
			return 0
		}
		i=$((i + 1))
		sleep 2
	done

	log "SIM$new has no working data; reverting to SIM$old"
	set_sim "$old" || true
	power_cycle
	apply_apn || true
	ifup lte >/dev/null 2>&1 || true
	return 1
}

daemon() {
 local failures recoveries threshold interval hard_after auto sim_after sim next
 local last_hard last_sim last_upstream_check now gap stage classification radio_phase
 radio_phase=unknown
 last_upstream_check=0
 failures=0
 recoveries=0
 last_hard=0
 last_sim=0
 stage=starting
 enabled || exit 0

 ensure_network
 sim="$(cfg sim)"
 [ "$sim" = 2 ] || sim=1
 if data_ok; then
   radio_phase=internet_verified
   log "LTE already healthy; preserving GPIOs, RNDIS, APN and DHCP session"
 elif gateway_ok; then
   # RNDIS IP/gateway does not prove carrier registration or packet attach.
   # This read-only probe does not disturb IPv4, SMS, Wi-Fi or the modem.
   radio_phase="$(modem_readiness_phase)"
   log "LTE RNDIS gateway present but Internet unavailable; modem_phase=$radio_phase; holding DHCP and radio"
 else
   power_on || true
   # Only restore GPIO selection during actual cold-start/recovery.
   set_sim "$sim" >/dev/null 2>&1 || true
   usb_repair
   wait_at || log "AT port not ready yet"
   if ! sim_ready && [ "$(cfg auto_failover)" = 1 ]; then
     if [ "$sim" = 1 ]; then next=2; else next=1; fi
     auto_switch_sim "$sim" "$next" && sim="$next"
   fi
   apply_apn || true
   ifup lte >/dev/null 2>&1 || true
   radio_phase="$(modem_readiness_phase)"
   log "LTE cold-start readiness: modem_phase=$radio_phase"
 fi

 threshold="$(clamped_number "$(cfg fail_threshold)" 3 2 20)"
 interval="$(clamped_number "$(cfg ping_interval)" 10 5 120)"
 hard_after="$(clamped_number "$(cfg hard_reset_after)" 3 2 20)"
 auto="$(cfg auto_failover)"
 sim_after="$(clamped_number "$(cfg sim_failover_after)" 3 2 20)"
 log "LTE performance-first monitor started; checks every $interval sec; threshold $threshold"

 while enabled; do
   if data_ok; then
     if [ "$failures" -gt 0 ] || [ "$recoveries" -gt 0 ]; then
       log "LTE connectivity restored"
     fi
     failures=0
     recoveries=0
     stage=healthy
     radio_phase=internet_verified
   else
     failures=$((failures + 1))
     stage=checking
     if [ "$failures" -ge "$threshold" ]; then
       failures=0
       # A responding IPv4 gateway is not a broken DHCP interface.
       # Do not renew DHCP or flap modem on public ICMP-only loss.
       if gateway_ok; then
         stage=upstream_degraded
         recoveries=0
         now="$(date +%s)"
         case "$now" in ''|*[!0-9]*) now=0;; esac
         gap=$((now-last_upstream_check))
         if [ "$last_upstream_check" -eq 0 ] || [ "$gap" -ge 90 ]; then
           last_upstream_check="$now"
           if https_ok; then
             classification=icmp_failed_https_ok
             stage=icmp_degraded_https_ok
             radio_phase=internet_verified_https
           else
             classification=icmp_and_https_failed
             radio_phase="$(modem_readiness_phase)"
           fi
           log "LTE RNDIS link/IP/route present; $classification; modem_phase=$radio_phase; no DHCP renew or radio reset"
           wan_diag_event "$classification" "hold_gateway_healthy"
         fi
       else
         recoveries=$((recoveries + 1))
         stage=dhcp_renew
         # Only missing gateway/local LTE IP justifies DHCP renew.
         if renew_lte; then
           stage=recovered_dhcp
           recoveries=0
           wan_diag_event "local_gateway_failure" "dhcp_renew_recovered"
         elif gateway_ok; then
           stage=upstream_degraded
           recoveries=0
           wan_diag_event "gateway_recovered" "hold"
         else
           stage=interface_recovery
         if repair_lte_interface; then
           stage=recovered_interface
           recoveries=0
         else
           if [ "$recoveries" -ge 2 ] && radio_or_link_lost; then
             stage=modem_soft_reconnect
             soft_reconnect || true
             if data_ok; then
               stage=recovered_soft
               recoveries=0
             fi
           fi
           # Hard resets have a strict 15-min cooldown and require missing
           # both public reachability and RNDIS gateway.
           if [ "$recoveries" -ge "$hard_after" ] && ! data_ok && ! gateway_ok && radio_or_link_lost; then
             now="$(date +%s)"
             case "$now" in ''|*[!0-9]*) now=0 ;; esac
             gap=$((now - last_hard))
             if [ "$last_hard" -eq 0 ] || [ "$gap" -ge 900 ]; then
               last_hard="$now"
               stage=last_resort_power_cycle
               power_cycle
             else
               stage=power_cycle_cooldown
               log "Suppressing modem power-cycle during 900-second cooldown"
             fi
           fi
           if [ "$auto" = 1 ] && [ "$recoveries" -ge "$sim_after" ] && ! data_ok && ! gateway_ok; then
             now="$(date +%s)"
             case "$now" in ''|*[!0-9]*) now=0 ;; esac
             gap=$((now - last_sim))
             if [ "$last_sim" -eq 0 ] || [ "$gap" -ge 1800 ]; then
               last_sim="$now"
               sim="$(cfg sim)"
               if [ "$sim" = 1 ]; then next=2; else next=1; fi
               stage=opt_in_sim_failover
               auto_switch_sim "$sim" "$next" || true
             fi
           fi
         fi
       fi
       fi
     fi
   fi
   performance_state
   sleep "$interval"
 done
}

case "$1" in
	daemon)
		daemon
		;;
	status-fast)
		status_fast_json
		;;
	status)
		status_fast_json
		;;
	status-full)
		status_json
		;;
	imei-read)
		imei_read_json
		;;
	refresh-cache)
		refresh_status_cache
		;;
	reconnect)
		manual_reconnect
		;;
	power-cycle)
		power_cycle
		;;
	sim)
		set_sim "$2"
		power_cycle
		apply_apn
		ifup lte >/dev/null 2>&1 || true
		;;
	usb-repair)
		usb_repair
		ifup lte >/dev/null 2>&1 || true
		;;
	restart)
		/etc/init.d/we5927-lte restart
		;;
	*)
		echo "usage: $0 {status|reconnect|power-cycle|usb-repair|sim 1|sim 2|restart}" >&2
		exit 2
		;;
esac