#!/bin/sh /etc/rc.common
START=84
STOP=18
USE_PROCD=1
start_service() {
  [ "$(uci -q get veci_reliability.main.enabled)" = 1 ] || return 0
  mkdir -p /overlay/veci-reliability
  chmod 700 /overlay/veci-reliability
  procd_open_instance
  procd_set_param command /usr/sbin/veci-reliability daemon
  procd_set_param respawn 3600 5 5
  procd_set_param stdout 0
  procd_set_param stderr 0
  procd_close_instance
}
service_triggers() {
  procd_add_reload_trigger veci_reliability
}
