config modem 'main'
	option enabled '1'
	option apn 'internet'
	option at_port '/dev/ttyUSB2'
	option data_if 'usb0'
	option metric '5'
	option ping_host '1.1.1.1'
	option ping_interval '30'
	option fail_threshold '6'
	option hard_reset_after '2'
	option auto_failover '0'
	option sim_failover_after '2'
	option sim '1'
	option sim1_value '1'
	option sim2_value '0'
	option modem_gpio '1'
	option sim_gpio '46'
	option modem_active '1'
	option usb_vid '05c6'
	option usb_pid '902e'
