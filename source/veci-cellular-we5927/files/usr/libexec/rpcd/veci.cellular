#!/bin/sh

LTE=/usr/sbin/we5927-lte

emit_error() {
	printf '{ "ok": false, "error": "%s" }\n' "$1"
}

status() {
	[ -x "$LTE" ] || {
		emit_error "lte_manager_missing"
		return
	}

	raw="$($LTE status-fast 2>/dev/null)" || {
		emit_error "status_failed"
		return
	}

	. /usr/share/libubox/jshn.sh
	json_load "$raw" 2>/dev/null || {
		emit_error "invalid_status"
		return
	}

	json_get_var enabled enabled
	json_get_var online online
	json_get_var mode mode
	json_get_var data_interface data_interface
	json_get_var ipv4 ipv4
	json_get_var gateway gateway
	json_get_var sim sim
	json_get_var manufacturer manufacturer
	json_get_var model model
	json_get_var revision revision
	json_get_var sim_status sim_status
	json_get_var operator operator
	json_get_var access_tech access_tech
	json_get_var registration registration
	json_get_var registration_status registration_status
	json_get_var packet_attach packet_attach
	json_get_var packet_status packet_status
	json_get_var signal_percent signal_percent
	json_get_var signal_dbm signal_dbm
	json_get_var status_source status_source

	json_init
	case "$enabled" in 1|true) json_add_boolean enabled 1 ;; *) json_add_boolean enabled 0 ;; esac
	case "$online" in 1|true) json_add_boolean online 1 ;; *) json_add_boolean online 0 ;; esac
	json_add_string mode "$mode"
	json_add_string data_interface "$data_interface"
	json_add_string ipv4 "$ipv4"
	json_add_string gateway "$gateway"
	case "$sim" in 1|2) json_add_int sim "$sim" ;; esac
	json_add_string manufacturer "$manufacturer"
	json_add_string model "$model"
	json_add_string revision "$revision"
	json_add_string sim_status "$sim_status"
	json_add_string operator "$operator"
	json_add_string access_tech "$access_tech"
	json_add_string registration "$registration"
	json_add_string registration_status "$registration_status"
	json_add_string packet_attach "$packet_attach"
	json_add_string packet_status "$packet_status"
	case "$signal_percent" in ''|*[!0-9]*) ;; *) json_add_int signal_percent "$signal_percent" ;; esac
	case "$signal_dbm" in ''|'-'|*[!0-9-]*) ;; *) json_add_int signal_dbm "$signal_dbm" ;; esac
	json_add_string status_source "$status_source"
	json_dump
}

# Sensitive identity is intentionally excluded from the frequently polled status.
# This is an authenticated, explicit-on-demand read from the router AT status cache,
# not a query to the W907 web UI. Never persist or log the IMEI here.
identity() {
	[ -x "$LTE" ] || {
		emit_error "lte_manager_missing"
		return
	}

	raw="$("$LTE" status-fast 2>/dev/null)" || {
		emit_error "status_failed"
		return
	}
	. /usr/share/libubox/jshn.sh
	json_load "$raw" 2>/dev/null || {
		emit_error "invalid_status"
		return
	}
	json_get_var imei imei
	json_get_var status_source status_source

	# Do not reveal random identifiers if the AT parser/cache is invalid.
	case "$imei" in
		???????????????) ;;
		*) imei='' ;;
	esac
	case "$imei" in
		''|*[!0-9]*) imei='' ;;
	esac

	age=0
	cache_age_known=0
	if [ -r /tmp/we5927-lte.status.ts ]; then
		ts="$(cat /tmp/we5927-lte.status.ts 2>/dev/null)"
		now="$(date +%s 2>/dev/null)"
		case "$ts:$now" in
			*[!0-9:]*) ;;
			:)
				;;
			*)
				if [ -n "$ts" ] && [ -n "$now" ] && [ "$now" -ge "$ts" ] 2>/dev/null; then
					age=$((now - ts))
					cache_age_known=1
				fi
				;;
		esac
	fi

	json_init
	[ -n "$imei" ] && json_add_boolean available 1 || json_add_boolean available 0
	json_add_string imei "$imei"
	json_add_string source "router_modem_at_cache"
	json_add_string status_source "$status_source"
	[ "$cache_age_known" -eq 1 ] && json_add_int cache_age_seconds "$age" || json_add_int cache_age_seconds -1
	[ "$cache_age_known" -eq 0 ] || [ "$age" -gt 300 ] && json_add_boolean stale 1 || json_add_boolean stale 0
	json_dump
}

reconnect() {
	[ -x "$LTE" ] || {
		emit_error "lte_manager_missing"
		return
	}
	("$LTE" reconnect >/dev/null 2>&1) &
	printf '{ "ok": true, "queued": true }\n'
}

switch_sim() {
	[ -x "$LTE" ] || {
		emit_error "lte_manager_missing"
		return
	}
	input="$(cat)"
	sim="$(printf '%s' "$input" | jsonfilter -e '@.sim' 2>/dev/null)"
	case "$sim" in
		1|2) ;;
		*) emit_error "invalid_sim"; return ;;
	esac
	("$LTE" sim "$sim" >/dev/null 2>&1) &
	printf '{ "ok": true, "queued": true, "sim": %s }\n' "$sim"
}

case "$1" in
	list)
		printf '{ "status": {}, "identity": {}, "reconnect": {}, "switchSim": { "sim": "int" } }\n'
		;;
	call)
		case "$2" in
			status) status ;;
			identity) identity ;;
			reconnect) reconnect ;;
			switchSim) switch_sim ;;
			*) emit_error "method_not_found" ;;
		esac
		;;
esac
