#!/bin/sh

LTE=/usr/sbin/we5927-lte

emit_error() {
	printf '{ "ok": false, "error": "%s" }\n' "$1"
}

status() {
	[ -x "$LTE" ] || {
		emit_error "lte_manager_missing"
		return
	}

	raw="$($LTE status-fast 2>/dev/null)" || {
		emit_error "status_failed"
		return
	}

	. /usr/share/libubox/jshn.sh
	json_load "$raw" 2>/dev/null || {
		emit_error "invalid_status"
		return
	}

	json_get_var enabled enabled
	json_get_var online online
	json_get_var mode mode
	json_get_var data_interface data_interface
	json_get_var ipv4 ipv4
	json_get_var gateway gateway
	json_get_var sim sim
	json_get_var manufacturer manufacturer
	json_get_var model model
	json_get_var revision revision
	json_get_var sim_status sim_status
	json_get_var operator operator
	json_get_var access_tech access_tech
	json_get_var registration registration
	json_get_var registration_status registration_status
	json_get_var packet_attach packet_attach
	json_get_var packet_status packet_status
	json_get_var signal_percent signal_percent
	json_get_var signal_dbm signal_dbm
	json_get_var status_source status_source

	json_init
	case "$enabled" in 1|true) json_add_boolean enabled 1 ;; *) json_add_boolean enabled 0 ;; esac
	case "$online" in 1|true) json_add_boolean online 1 ;; *) json_add_boolean online 0 ;; esac
	json_add_string mode "$mode"
	json_add_string data_interface "$data_interface"
	json_add_string ipv4 "$ipv4"
	json_add_string gateway "$gateway"
	case "$sim" in 1|2) json_add_int sim "$sim" ;; esac
	json_add_string manufacturer "$manufacturer"
	json_add_string model "$model"
	json_add_string revision "$revision"
	json_add_string sim_status "$sim_status"
	json_add_string operator "$operator"
	json_add_string access_tech "$access_tech"
	json_add_string registration "$registration"
	json_add_string registration_status "$registration_status"
	json_add_string packet_attach "$packet_attach"
	json_add_string packet_status "$packet_status"
	case "$signal_percent" in ''|*[!0-9]*) ;; *) json_add_int signal_percent "$signal_percent" ;; esac
	case "$signal_dbm" in ''|'-'|*[!0-9-]*) ;; *) json_add_int signal_dbm "$signal_dbm" ;; esac
	json_add_string status_source "$status_source"
	json_dump
}

# Sensitive identity is intentionally excluded from the frequently polled status.
# This is an authenticated, explicit-on-demand read from the router AT status cache,
# not a query to the W907 web UI. Never persist or log the IMEI here.
identity() {
	[ -x "$LTE" ] || {
		emit_error "lte_manager_missing"
		return
	}

	raw="$("$LTE" status-fast 2>/dev/null)" || {
		emit_error "status_failed"
		return
	}
	. /usr/share/libubox/jshn.sh
	json_load "$raw" 2>/dev/null || {
		emit_error "invalid_status"
		return
	}
	json_get_var imei imei
	json_get_var status_source status_source

	# Do not reveal random identifiers if the AT parser/cache is invalid.
	case "$imei" in
		???????????????) ;;
		*) imei='' ;;
	esac
	case "$imei" in
		''|*[!0-9]*) imei='' ;;
	esac

	age=0
	cache_age_known=0
	if [ -r /tmp/we5927-lte.status.ts ]; then
		ts="$(cat /tmp/we5927-lte.status.ts 2>/dev/null)"
		now="$(date +%s 2>/dev/null)"
		case "$ts:$now" in
			*[!0-9:]*) ;;
			:)
				;;
			*)
				if [ -n "$ts" ] && [ -n "$now" ] && [ "$now" -ge "$ts" ] 2>/dev/null; then
					age=$((now - ts))
					cache_age_known=1
				fi
				;;
		esac
	fi

	json_init
	[ -n "$imei" ] && json_add_boolean available 1 || json_add_boolean available 0
	json_add_string imei "$imei"
	json_add_string source "router_modem_at_cache"
	json_add_string status_source "$status_source"
	[ "$cache_age_known" -eq 1 ] && json_add_int cache_age_seconds "$age" || json_add_int cache_age_seconds -1
	[ "$cache_age_known" -eq 0 ] || [ "$age" -gt 300 ] && json_add_boolean stale 1 || json_add_boolean stale 0
	json_dump
}


# On-demand AT+CGSN only. No IMEI is included in routine status polling.
# A failed/busy AT port is reported as unavailable, not a fabricated identity.
identity_live() {
	[ -x "$LTE" ] || { emit_error "lte_manager_missing"; return; }
	raw="$("$LTE" imei-read 2>/dev/null)" || { emit_error "at_query_failed"; return; }
	. /usr/share/libubox/jshn.sh
	json_load "$raw" 2>/dev/null || { emit_error "invalid_at_response"; return; }
	json_get_var ok ok
	json_get_var imei imei
	case "$ok" in 1|true) ;; *) emit_error "at_query_unavailable"; return ;; esac
	case "$imei" in ???????????????) ;; *) emit_error "invalid_modem_identity"; return ;; esac
	case "$imei" in *[!0-9]*) emit_error "invalid_modem_identity"; return ;; esac
	json_init
	json_add_boolean available 1
	json_add_string imei "$imei"
	json_add_string source "at_cgsn_live"
	json_dump
}

# Read-only, no probes, no AT access, no private identifiers.
# Truthfully report unavailable when the monitor has not started.
performance_status() {
    lte_stage=not_started
    wifi_stage=not_started
    lte_failures=0
    lte_recoveries=0
    wifi_failures=0
    wifi_auto=false
    lte_ts=0
    wifi_ts=0
    lte_interval=0
    wifi_interval=0
    if [ -r /tmp/veci-lte-performance.state ]; then
        for pair in $(head -c 256 /tmp/veci-lte-performance.state 2>/dev/null); do
            k="$(printf '%s' "$pair" | cut -d= -f1)"
            v="$(printf '%s' "$pair" | cut -d= -f2-)"
            case "$k" in
                stage)
                    case "$v" in
                        healthy|checking|dhcp_renew|recovered_dhcp|upstream_degraded|interface_recovery|recovered_interface|modem_soft_reconnect|recovered_soft|last_resort_power_cycle|power_cycle_cooldown|opt_in_sim_failover|starting)
                            lte_stage="$v" ;;
                    esac ;;
                failures)
                    case "$v" in ''|*[!0-9]*) ;; *) lte_failures="$v" ;; esac ;;
                recoveries)
                    case "$v" in ''|*[!0-9]*) ;; *) lte_recoveries="$v" ;; esac ;;
                timestamp)
                    case "$v" in ''|*[!0-9]*) ;; *)
                        [ "$(printf '%s' "$v" | wc -c)" -le 11 ] && lte_ts="$v" ;; esac ;;
            esac
        done
    fi
    if [ -r /tmp/veci-wifi-performance.state ]; then
        for pair in $(head -c 256 /tmp/veci-wifi-performance.state 2>/dev/null); do
            k="$(printf '%s' "$pair" | cut -d= -f1)"
            v="$(printf '%s' "$pair" | cut -d= -f2-)"
            case "$k" in
                wifi)
                    case "$v" in
                        ready|ap_not_ready|radio_recovery|hold_associated_or_unknown|cooldown_or_observe|intentionally_disabled|starting) wifi_stage="$v" ;;
                    esac ;;
                failures)
                    case "$v" in ''|*[!0-9]*) ;; *) wifi_failures="$v" ;; esac ;;
                auto_recover)
                    [ "$v" = 1 ] && wifi_auto=true ;;
                timestamp)
                    case "$v" in ''|*[!0-9]*) ;; *)
                        [ "$(printf '%s' "$v" | wc -c)" -le 11 ] && wifi_ts="$v" ;; esac ;;
            esac
        done
    fi
    lte_interval="$(uci -q get we5927_lte.main.ping_interval 2>/dev/null || true)"
    wifi_interval="$(uci -q get veci_performance.wifi.interval 2>/dev/null || true)"
    case "$lte_interval" in ''|*[!0-9]*) lte_interval=0 ;; esac
    case "$wifi_interval" in ''|*[!0-9]*) wifi_interval=0 ;; esac
    now="$(date +%s)"
    case "$now" in ''|*[!0-9]*) now=0 ;; esac
    # Status from a dead monitor must not remain healthy indefinitely.
    lte_ttl=$((3 * lte_interval + 15))
    wifi_ttl=$((3 * wifi_interval + 15))
    [ "$lte_ttl" -ge 75 ] || lte_ttl=75
    [ "$wifi_ttl" -ge 105 ] || wifi_ttl=105
    if [ "$lte_stage" != not_started ]; then
        if [ "$lte_ts" -le 0 ] || [ "$now" -lt "$lte_ts" ] || [ $((now - lte_ts)) -gt "$lte_ttl" ]; then lte_stage=stale; fi
    fi
    if [ "$wifi_stage" != not_started ]; then
        if [ "$wifi_ts" -le 0 ] || [ "$now" -lt "$wifi_ts" ] || [ $((now - wifi_ts)) -gt "$wifi_ttl" ]; then wifi_stage=stale; fi
    fi
    printf '{"ok":true,"source":"local_tmpfs_monitors","lte":{"stage":"%s","failures":%s,"recovery_cycles":%s,"check_interval_seconds":%s},"wifi":{"stage":"%s","failures":%s,"auto_recover":%s,"check_interval_seconds":%s}}\n'       "$lte_stage" "$lte_failures" "$lte_recoveries" "$lte_interval" "$wifi_stage" "$wifi_failures" "$wifi_auto" "$wifi_interval"
}

messaging_capabilities() {
	# Explicit on-demand AT test commands; no SMS body, USSD code or OTP.
	[ -x /usr/libexec/veci-modem-capabilities ] || {
		emit_error "capability_probe_unavailable"
		return
	}
	/usr/libexec/veci-modem-capabilities probe
}

reconnect() {
	[ -x "$LTE" ] || {
		emit_error "lte_manager_missing"
		return
	}
	("$LTE" reconnect >/dev/null 2>&1) &
	printf '{ "ok": true, "queued": true }\n'
}

switch_sim() {
	[ -x "$LTE" ] || {
		emit_error "lte_manager_missing"
		return
	}
	input="$(cat)"
	sim="$(printf '%s' "$input" | jsonfilter -e '@.sim' 2>/dev/null)"
	case "$sim" in
		1|2) ;;
		*) emit_error "invalid_sim"; return ;;
	esac
	("$LTE" sim "$sim" >/dev/null 2>&1) &
	printf '{ "ok": true, "queued": true, "sim": %s }\n' "$sim"
}

case "$1" in
	list)
		printf '{ "status": {}, "identity": {}, "identityLive": {}, "messagingCapabilities": {}, "performanceStatus": {}, "reconnect": {}, "switchSim": { "sim": "int" } }\n'
		;;
	call)
		case "$2" in
			status) status ;;
			identity) identity ;;
			identityLive) identity_live ;;
			messagingCapabilities) messaging_capabilities ;;
            performanceStatus) performance_status ;;
			reconnect) reconnect ;;
			switchSim) switch_sim ;;
			*) emit_error "method_not_found" ;;
		esac
		;;
esac
