#!/bin/sh
# VeCI WE5927: ONLY 3GPP AT test-commands; NO SMS send/read or USSD execution.
# This is explicit-on-demand and shares the existing we5927-at.lock.
set -eu
umask 077
LC_ALL=C
export LC_ALL

unavailable() {
    case "$1" in
        modem_port_unavailable|at_tool_unavailable|lock_unavailable|modem_busy) reason="$1" ;;
        *) reason=unavailable ;;
    esac
    printf '{ "ok": false, "state": "unavailable", "reason": "%s", "sms_mode": "not_tested", "sms_storage": "not_tested", "sms_notifications": "not_tested", "ussd": "not_tested" }\n' "$reason"
}

# Never probe W907 1.5 and NEVER fall back to a configured ttyUSB port.
# These low-impact diagnostics require both interface 1.4 and USB 05c6:902e.
# A future privileged SMS transport must additionally attest the opened FD.
find_at_port() {
    for entry in /sys/class/tty/ttyUSB*; do
        [ -e "$entry/device" ] || continue
        name="${entry##*/}"
        [ "$name" != ttyUSB3 ] || continue
        case "$name" in ttyUSB[0-9]|ttyUSB[0-9][0-9]) ;; *) continue ;; esac
        devpath="$(readlink -f "$entry/device" 2>/dev/null || :)"
        case "$devpath" in
            /sys/devices/*:1.4/*)
                interface_dir="${devpath%/*}"
                usbparent="${interface_dir%/*}"
                [ -r "$usbparent/idVendor" ] || continue
                [ -r "$usbparent/idProduct" ] || continue
                vid="$(cat "$usbparent/idVendor" 2>/dev/null || :)"
                pid="$(cat "$usbparent/idProduct" 2>/dev/null || :)"
                [ "$vid" = 05c6 ] || continue
                [ "$pid" = 902e ] || continue
                port="/dev/$name"
                [ -c "$port" ] && { printf '%s\n' "$port"; return 0; }
                ;;
        esac
    done
    return 1
}

# This internal function accepts NOTHING from ubus/browser. Commands and
# expected response prefixes are fixed literals in the call sites below.
test_at() {
    raw="$(/usr/sbin/we5927-at "$at_port" "$1" 1500 2>/dev/null)" || {
        printf 'unavailable\n'
        return
    }
    lines="$(printf '%s\n' "$raw" | tr -d '\r')"
    if printf '%s\n' "$lines" | grep -Fq "$2" &&
       printf '%s\n' "$lines" | grep -qx 'OK'; then
        printf 'supported\n'
    elif printf '%s\n' "$lines" | grep -Eq '^(\+CME ERROR|\+CMS ERROR|ERROR)(:|$)'; then
        # ERROR can be a temporary refusal, not proof of lack of hardware support.
        printf 'rejected\n'
    else
        printf 'unknown\n'
    fi
}

probe_capabilities() {
    [ -x /usr/sbin/we5927-at ] || { unavailable at_tool_unavailable; return; }
    command -v flock >/dev/null 2>&1 || { unavailable lock_unavailable; return; }
    at_port="$(find_at_port)" || { unavailable modem_port_unavailable; return; }

    # One nonblocking exclusive lock over all four probes, shared with
    # /usr/sbin/we5927-lte. Never wait indefinitely behind watchdog/IMEI.
    (
        flock -n -x 9 || { unavailable modem_busy; exit 0; }
        sms_mode="$(test_at 'AT+CMGF=?' '+CMGF:')"
        sms_storage="$(test_at 'AT+CPMS=?' '+CPMS:')"
        sms_notifications="$(test_at 'AT+CNMI=?' '+CNMI:')"
        ussd="$(test_at 'AT+CUSD=?' '+CUSD:')"
        printf '{ "ok": true, "state": "probed", "source": "read_only_at_test", "sms_mode": "%s", "sms_storage": "%s", "sms_notifications": "%s", "ussd": "%s" }\n' \
            "$sms_mode" "$sms_storage" "$sms_notifications" "$ussd"
    ) 9>/var/lock/we5927-at.lock
}

# On-demand SMS *storage count* only. AT+CPMS? is a READ query.
# NEVER read SMS PDUs, sender addresses, SMS body, PIN/OTP or USSD text.
# Reject malformed, duplicated, extra, unsolicited or partial responses.
storage_parse() {
    awk '
        /^[[:space:]]*$/ { next }
        {
            gsub(/\r/, "", $0)
            if ($0 == "") next
            if ($0 == "AT+CPMS?") { if (seen || ok) bad=1; next }
            if ($0 == "OK") { if (ok || !seen) bad=1; ok=1; next }
            if ($0 ~ /^[[:space:]]*\+CPMS:[[:space:]]*/) {
                if (seen || ok) { bad=1; next }
                gsub(/[[:space:]]/, "", $0)
                sub(/^\+CPMS:/, "", $0)
                n=split($0, values, ",")
                if (n != 9) { bad=1; next }
                for (i=1; i<=9; i+=3) {
                    if (values[i] !~ /^"[A-Z][A-Z]"$/ ||
                        values[i+1] !~ /^[0-9]+$/ ||
                        values[i+2] !~ /^[0-9]+$/ ||
                        values[i+1]+0 > values[i+2]+0 ||
                        values[i+2]+0 > 65535) bad=1
                }
                if (bad) next
                memory=values[1]
                gsub(/"/, "", memory)
                used=values[2]+0
                total=values[3]+0
                seen=1
                next
            }
            bad=1
        }
        END {
            if (!bad && seen && ok) {
                printf "%s %d %d\n",memory,used,total
                exit 0
            }
            exit 1
        }
    '
}

storage_error() {
    case "$1" in
        modem_busy|modem_port_unavailable|at_tool_unavailable|query_failed|invalid_response) reason="$1" ;;
        *) reason=unavailable ;;
    esac
    printf '{ "ok": false, "state": "unavailable", "reason": "%s" }\n' "$reason"
}
storage_query() {
    [ -x /usr/sbin/we5927-at ] || { storage_error at_tool_unavailable; return; }
    command -v flock >/dev/null 2>&1 || { storage_error unavailable; return; }
    at_port="$(find_at_port)" || { storage_error modem_port_unavailable; return; }
    (
        flock -n -x 9 || { storage_error modem_busy; exit 0; }
        raw="$(/usr/sbin/we5927-at "$at_port" 'AT+CPMS?' 1500 2>/dev/null)" ||
            { storage_error query_failed; exit 0; }
        compact="$(printf '%s\n' "$raw" | storage_parse)" ||
            { storage_error invalid_response; exit 0; }
        # compact is emitted by a strict awk parser: "SM 0 30", no secrets.
        set -- $compact
        [ "$#" -eq 3 ] || { storage_error invalid_response; exit 0; }
        printf '{ "ok": true, "state": "queried", "source": "read_only_at_cpms", "memory": "%s", "used": %s, "total": %s }\n' "$1" "$2" "$3"
    ) 9>/var/lock/we5927-at.lock
}

[ "$#" -eq 1 ] || { echo 'usage: veci-modem-capabilities probe|storage' >&2; exit 2; }
case "$1" in
    probe) probe_capabilities ;;
    storage) storage_query ;;
    *) echo 'unsupported operation' >&2; exit 2 ;;
esac
