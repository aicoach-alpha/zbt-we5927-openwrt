#!/bin/sh
# VeCI router uplink usage, not authenticated carrier quota.
set -eu
umask 077
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
STATE=/etc/veci-data-meter/baseline.json
DIR=/etc/veci-data-meter
fail(){ printf '{"ok":false,"reason":"%s","carrier_authenticated":false}\n' "$1"; exit 0; }
num(){ case "$1" in ''|*[!0-9]*) return 1;; esac; [ "$(printf %s "$1" | wc -c)" -le 14 ]; }
read_num(){ [ -r "$1" ] || fail uplink_unavailable; n="$(cat "$1" 2>/dev/null || :)"; num "$n" || fail bad_counter; [ "$n" -le 90000000000000 ] || fail bad_counter; printf '%s' "$n"; }
field(){ jsonfilter -i "$STATE" -e "@.$1" 2>/dev/null || :; }
private(){
 [ -d "$DIR" ] && [ ! -L "$DIR" ] && [ -f "$STATE" ] && [ ! -L "$STATE" ] || return 1
 [ "$(ls -ldn "$DIR" | awk '{print $1" "$3}')" = "drwx------ 0" ] || return 1
 [ "$(ls -ldn "$STATE" | awk '{print $1" "$3}')" = "-rw------- 0" ] || return 1
 [ "$(wc -c < "$STATE")" -le 512 ]
}
sample(){
 [ -r /proc/sys/kernel/random/boot_id ] || fail boot_id_missing
 boot="$(cat /proc/sys/kernel/random/boot_id)"
 case "$boot" in ????????-????-????-????-????????????) ;; *) fail bad_boot_id;; esac
 ix="$(read_num /sys/class/net/usb0/ifindex)"
 rx="$(read_num /sys/class/net/usb0/statistics/rx_bytes)"
 tx="$(read_num /sys/class/net/usb0/statistics/tx_bytes)"
 now="$(date +%s)"
 num "$now" || fail bad_clock
}
status(){
 sample
 if ! private; then
  printf '{"schema":1,"state":"needs_baseline","source":"router_traffic","carrier_authenticated":false,"interface":"usb0","rx_bytes":%s,"tx_bytes":%s,"estimated_remaining_bytes":null}\n' "$rx" "$tx"
  return
 fi
 oldboot="$(field boot_id)"; oldix="$(field ifindex)"
 oldrx="$(field rx)"; oldtx="$(field tx)"
 amount="$(field remaining_mb)"; epoch="$(field epoch)"
 for n in "$oldix" "$oldrx" "$oldtx" "$amount" "$epoch"; do num "$n" || fail saved_invalid; done
 [ "$amount" -ge 1 ] && [ "$amount" -le 1048576 ] || fail saved_invalid
 if [ "$boot" != "$oldboot" ] || [ "$ix" != "$oldix" ] ||
    [ "$rx" -lt "$oldrx" ] || [ "$tx" -lt "$oldtx" ] ||
    [ "$now" -lt "$epoch" ] || [ $((now-epoch)) -gt 2678400 ]; then
  echo '{"schema":1,"state":"baseline_expired","source":"router_traffic","carrier_authenticated":false,"estimated_remaining_bytes":null}'
  return
 fi
 used=$((rx-oldrx+tx-oldtx))
 baseline=$((amount*1000000))
 remain=$((baseline-used))
 [ "$remain" -ge 0 ] || remain=0
 printf '{"schema":1,"state":"estimated","source":"manual_baseline_minus_uplink_traffic","carrier_authenticated":false,"interface":"usb0","baseline_epoch":%s,"traffic_since_baseline_bytes":%s,"estimated_remaining_bytes":%s,"baseline_bytes":%s}\n' "$epoch" "$used" "$remain" "$baseline"
}
set_baseline(){
 sample
 [ ! -L "$DIR" ] && [ ! -L "$STATE" ] || fail insecure_path
 if [ -e "$STATE" ]; then private || fail insecure_existing_state; fi
 body="$(head -c 129)"
 [ "$(printf '%s' "$body" | wc -c)" -le 128 ] || fail too_large
 amount="$(printf '%s\n' "$body" | jsonfilter -e '@.remaining_mb' 2>/dev/null || :)"
 num "$amount" || fail invalid_amount
 [ "$amount" -ge 1 ] && [ "$amount" -le 1048576 ] || fail invalid_amount
 free="$(df -k /overlay | awk 'NR==2{print $4}')"
 num "$free" && [ "$free" -ge 16 ] || fail no_space
 if [ ! -d "$DIR" ]; then mkdir -m 700 "$DIR" || fail storage_failed; fi
 [ ! -L "$DIR" ] && [ "$(ls -ldn "$DIR" | awk '{print $1" "$3}')" = "drwx------ 0" ] || fail insecure_dir
 tmp="$STATE.$$"
 [ ! -e "$tmp" ] && [ ! -L "$tmp" ] || fail temp_exists
 trap 'rm -f "$tmp"' EXIT
 printf '{"schema":1,"boot_id":"%s","ifindex":%s,"rx":%s,"tx":%s,"remaining_mb":%s,"epoch":%s}\n' "$boot" "$ix" "$rx" "$tx" "$amount" "$now" > "$tmp" || fail write_failed
 chmod 600 "$tmp" || fail mode_failed
 mv -f "$tmp" "$STATE" || fail commit_failed
 trap - EXIT
 echo '{"ok":true,"state":"estimated","carrier_authenticated":false}'
}
[ "$(id -u)" = 0 ] || fail root_required
case "$1:$2" in
 list:) echo '{"status":{},"setBaseline":{"remaining_mb":"int"}}';;
 call:status) status;;
 call:setBaseline) set_baseline;;
 *) fail unknown_method;;
esac