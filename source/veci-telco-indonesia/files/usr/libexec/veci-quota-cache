#!/bin/sh
# VeCI Indonesia: strictly local, bounded, sanitized carrier-quota cache reader.
# NEVER performs network I/O and NEVER accepts account credentials.
# Future authenticated carrier client is the only intended quota producer.
set -eu

empty_status() {
    case "$1" in
        not_connected|stale|unavailable) state="$1" ;;
        *) state=unavailable ;;
    esac
    printf '{ "schema": 1, "provider": "xl", "state": "%s", "total_bytes": null, "remaining_bytes": null, "used_bytes": null, "expires_at": null, "fetched_at": null, "source": null, "buckets": [] }\n' "$state"
}

canonical_number() {
    case "$1" in
        ''|*[!0-9]*|0[0-9]*) return 1 ;;
    esac
    [ "${#1}" -le 13 ]
}

get_field() {
    jsonfilter -i "$cache" -e "@.$1" 2>/dev/null || :
}

read_cache() {
    cache="$1"
    parent="$(dirname "$cache")"
    if [ ! -f "$cache" ]; then empty_status not_connected; return; fi
    # Do not traverse a symlinked file/directory under the root-only cache.
    if [ -L "$cache" ] || [ -L "$parent" ] || [ ! -d "$parent" ]; then
        empty_status unavailable; return
    fi
    owner="$(id -u)"
    dir_uid="$(stat -c %u "$parent" 2>/dev/null || :)"
    file_uid="$(stat -c %u "$cache" 2>/dev/null || :)"
    dir_mode="$(stat -c %a "$parent" 2>/dev/null || :)"
    file_mode="$(stat -c %a "$cache" 2>/dev/null || :)"
    bytes="$(stat -c %s "$cache" 2>/dev/null || :)"
    if [ "$dir_uid" != "$owner" ] || [ "$file_uid" != "$owner" ] ||
       [ "$dir_mode" != 700 ] || [ "$file_mode" != 600 ] ||
       ! canonical_number "$bytes" || [ "$bytes" -gt 4096 ]; then
        empty_status unavailable; return
    fi
    schema="$(get_field schema)"
    provider="$(get_field provider)"
    state="$(get_field state)"
    source="$(get_field source)"
    remaining="$(get_field remaining_bytes)"
    total="$(get_field total_bytes)"
    timestamp="$(get_field fetched_epoch)"
    fetched_at="$(get_field fetched_at)"
    if [ "$schema" != 1 ] || [ "$provider" != xl ] ||
       [ "$state" != ready ] || [ "$source" != carrier_authenticated ] ||
       ! canonical_number "$remaining" || ! canonical_number "$timestamp"; then
        empty_status unavailable; return
    fi
    now="$(date +%s 2>/dev/null || :)"
    if ! canonical_number "$now"; then empty_status unavailable; return; fi
    if [ "$timestamp" -gt "$now" ]; then empty_status unavailable; return; fi
    if [ $((now - timestamp)) -gt 1800 ]; then empty_status stale; return; fi
    if ! canonical_number "$total"; then total=null; fi
    if ! printf '%s\n' "$fetched_at" | grep -Eq '^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'; then
        fetched_json=null
    else
        fetched_json="\"$fetched_at\""
    fi
    # Do not echo source JSON; raw operator payload can contain credentials.
    printf '{ "schema": 1, "provider": "xl", "state": "ready", "total_bytes": %s, "remaining_bytes": %s, "used_bytes": null, "expires_at": null, "fetched_at": %s, "source": "carrier_authenticated", "buckets": [] }\n' "$total" "$remaining" "$fetched_json"
}

case "${1:-}" in
    status) read_cache "${2:-/tmp/veci-telco/quota-xl.json}" ;;
    *) echo 'usage: veci-quota-cache status [path]' >&2; exit 2 ;;
esac
