#!/bin/sh
# VeCI Indonesia — protected operator-readonly quota pipeline, STAGED.
# WARNING: NOT live myXL login. Requires a separately authorized local
# session. No cache writes are permitted until source+units are proven.
#
# Direct TLS quota request -> private JSON envelope -> URL-safe xdata ->
# native AES-CBC decrypt -> finite DATA parser -> parsed_only JSON.
# Every raw response and decrypted payload stays inside a 0700 /tmp folder.
# No developer server, no SMS, no USSD, no app credential is embedded.
set -eu
umask 077
LC_ALL=C
export LC_ALL
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
HTTP=/usr/libexec/veci-xl-quota-http
CRYPTO=/usr/libexec/veci-xl-crypto
PARSER=/usr/libexec/veci-xl-quota-normalize
JSONFILTER=/usr/bin/jsonfilter
PRIVATE=/tmp/veci-telco-private
fail() {
  printf 'VECI_XL_CHAIN_ERROR=%s\n' "$1" >&2
  exit 1
}
[ "$#" -eq 1 ] && [ "$1" = "--read-only" ] || fail usage
[ "$(id -u)" = "0" ] || fail root_required
[ ! -t 1 ] || fail output_must_be_piped
for executable in "$HTTP" "$CRYPTO" "$PARSER" "$JSONFILTER"; do
  [ -x "$executable" ] || fail native_component_missing
done
[ -d "$PRIVATE" ] && [ ! -L "$PRIVATE" ] || fail session_not_configured
[ -f "$PRIVATE/xdata_key" ] && [ ! -L "$PRIVATE/xdata_key" ] ||
  fail session_not_configured
# HTTP transport separately verifies root ownership, 0700/0600 secrets,
# hostname+CA TLS, fixed-only quota POST and read-only no-redirect response.
work="$(mktemp -d /tmp/veci-xl-chain.XXXXXX)" || fail ram_unavailable
trap 'rm -rf "$work"' EXIT
trap 'exit 130' INT TERM
"$HTTP" quota > "$work/envelope.json" 2>/dev/null || fail operator_request_unavailable
[ "$(wc -c < "$work/envelope.json" | tr -d '[:space:]')" -le 65536 ] ||
  fail response_too_large
"$JSONFILTER" -i "$work/envelope.json" -e '@.xtime' > "$work/xtime" 2>/dev/null ||
  fail invalid_operator_envelope
"$JSONFILTER" -i "$work/envelope.json" -e '@.xdata' > "$work/xdata" 2>/dev/null ||
  fail invalid_operator_envelope
xtime="$(cat "$work/xtime")"
case "$xtime" in
  ?????????????) ;;
  *) fail invalid_xtime ;;
esac
case "$xtime" in *[!0-9]*) fail invalid_xtime ;; esac
[ "$(wc -l < "$work/xdata" | tr -d '[:space:]')" -eq 1 ] ||
  fail invalid_ciphertext
n="$(wc -c < "$work/xdata" | tr -d '[:space:]')"
[ "$n" -ge 5 ] && [ "$n" -le 8193 ] || fail invalid_ciphertext
grep -Eq '^[A-Za-z0-9_+/=-]+$' "$work/xdata" || fail invalid_ciphertext
"$CRYPTO" decrypt "$xtime" "$PRIVATE/xdata_key" < "$work/xdata" > "$work/decrypted.json" 2>/dev/null ||
  fail invalid_encrypted_quota
"$PARSER" < "$work/decrypted.json" > "$work/parsed.json" 2>/dev/null ||
  fail quota_schema_unverified
# This stage does NOT authenticate quota units or assert cache trust.
# The parser's output is restricted to its canonical parsed_only payload.
[ "$(wc -c < "$work/parsed.json" | tr -d '[:space:]')" -le 256 ] ||
  fail malformed_parser_result
[ "$("$JSONFILTER" -i "$work/parsed.json" -e '@.parsed_only' 2>/dev/null)" = "true" ] ||
  fail malformed_parser_result
[ "$("$JSONFILTER" -i "$work/parsed.json" -e '@.provider' 2>/dev/null)" = "xl" ] ||
  fail malformed_parser_result
cat "$work/parsed.json"
