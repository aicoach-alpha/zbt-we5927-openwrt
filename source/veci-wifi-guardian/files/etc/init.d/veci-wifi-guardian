#!/bin/sh /etc/rc.common
START=78
STOP=20
USE_PROCD=1
start_service() {
  [ "$(uci -q get veci_performance.wifi.enabled)" = 1 ] || return 0
  procd_open_instance
  procd_set_param command /usr/sbin/veci-wifi-guardian daemon
  procd_set_param respawn 30 5 3
  procd_set_param stdout 0
  procd_set_param stderr 0
  procd_close_instance
}
service_triggers() {
  procd_add_reload_trigger veci_performance
}
