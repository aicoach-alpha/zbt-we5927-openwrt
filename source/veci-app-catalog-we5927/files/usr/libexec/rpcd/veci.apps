#!/bin/sh
# WE5927 signed-feed verifier. No custom URL or package installation.
set -u
release_file=/etc/veci-release.json
repo_file=/etc/apk/repositories.d/veci-apps.list
channel_file=/etc/veci-release-channel
keys_dir=/etc/apk/keys
lock=/tmp/veci-app-feed-verify.lock
fail() { printf '{ "ok": false, "reason": "%s", "verified": false }\n' "$1"; }
build_id() {
    [ -r "$release_file" ] || return 1
    id="$(jsonfilter -i "$release_file" -e '@.build_id' 2>/dev/null || true)"
    case "$id" in ''|*[!a-f0-9]*) return 1;; esac
    [ "$(printf '%s' "$id" | wc -c | tr -d ' ')" -eq 40 ] || return 1
    printf '%s' "$id"
}
overlay_free() { df -Pk /overlay 2>/dev/null | awk 'NR==2 && $4 ~ /^[0-9]+$/ {print $4}'; }
memory_free() { awk '/^MemAvailable:/ {print $2; exit}' /proc/meminfo 2>/dev/null; }
feed_contract_valid() {
    id="$(build_id)" || return 1
    [ "$(cat "$channel_file" 2>/dev/null)" = published ] || return 1
    [ "$(uci -q get veci.main.app_feed_build_id 2>/dev/null)" = "$id" ] || return 1
    [ -r "$repo_file" ] || return 1
    [ "$(wc -l < "$repo_file" | tr -d ' ')" -eq 4 ] || return 1
    base="https://raw.githubusercontent.com/aicoach-alpha/zbt-we5927-openwrt/app-feed/feeds/$id"
    for suffix in targets/ramips/mt76x8/packages/packages.adb \
                  packages/mipsel_24kc/base/packages.adb \
                  packages/mipsel_24kc/luci/packages.adb \
                  packages/mipsel_24kc/packages/packages.adb; do
        grep -Fxq "$base/$suffix" "$repo_file" || return 1
    done
    return 0
}
method_status() {
    overlay="$(overlay_free)"
    mem="$(memory_free)"
    case "$overlay" in ''|*[!0-9]*) overlay=0;; esac
    case "$mem" in ''|*[!0-9]*) mem=0;; esac
    configured=false
    verified=false
    ready=false
    if feed_contract_valid; then
        configured=true
        id="$(build_id)"
        if [ "$(uci -q get veci.main.app_feed_verified_build_id 2>/dev/null)" = "$id" ]; then
            verified=true
            if [ "$(uci -q get veci.main.app_feed_enabled 2>/dev/null)" = 1 ] &&
               [ "$overlay" -ge 2048 ] && [ "$mem" -ge 8192 ] &&
               command -v apk >/dev/null 2>&1; then ready=true; fi
        fi
    fi
    printf '{ "feed_configured": %s, "feed_verified": %s, "feed_ready": %s, "overlay_free_kb": %s, "minimum_overlay_kb": 2048 }\n' \
       "$configured" "$verified" "$ready" "$overlay"
}
method_verify() {
    feed_contract_valid || { fail feed_contract_invalid_or_unpublished; return; }
    command -v apk >/dev/null 2>&1 || { fail apk_unavailable; return; }
    command -v uclient-fetch >/dev/null 2>&1 || { fail tls_fetch_unavailable; return; }
    [ -d "$keys_dir" ] && [ -n "$(find "$keys_dir" -maxdepth 1 -type f -size +0c 2>/dev/null | head -n 1)" ] || {
        fail trusted_keys_missing; return;
    }
    mem="$(memory_free)"
    tmp_kb="$(df -Pk /tmp 2>/dev/null | awk 'NR==2 {print $4}')"
    case "$mem:$tmp_kb" in ''|*[!0-9:]*) fail memory_unknown; return;; esac
    [ "$mem" -ge 16384 ] && [ "$tmp_kb" -ge 12288 ] || {
        fail insufficient_volatile_memory; return;
    }
    mkdir "$lock" 2>/dev/null || { fail verification_busy; return; }
    dir="$(mktemp -d /tmp/veci-app-feed.XXXXXX)" || {
        rmdir "$lock" 2>/dev/null || true
        fail tempdir_failed; return;
    }
    chmod 700 "$dir"
    id="$(build_id)"
    base="https://raw.githubusercontent.com/aicoach-alpha/zbt-we5927-openwrt/app-feed/feeds/$id"
    failure=''
    for suffix in targets/ramips/mt76x8/packages/packages.adb \
                  packages/mipsel_24kc/base/packages.adb \
                  packages/mipsel_24kc/luci/packages.adb \
                  packages/mipsel_24kc/packages/packages.adb; do
        # Fixed HTTPS URL allowlist; no arbitrary package/index download.
        if ! uclient-fetch -T 30 -O "$dir/index.adb" "$base/$suffix" >/dev/null 2>&1; then
            failure=feed_download_failed; break
        fi
        bytes="$(wc -c < "$dir/index.adb" | tr -d ' ')"
        case "$bytes" in ''|*[!0-9]*) failure=invalid_index_size; break;; esac
        if [ "$bytes" -lt 100 ] || [ "$bytes" -gt 6291456 ]; then
            failure=invalid_index_size; break
        fi
        if ! apk --keys-dir "$keys_dir" verify "$dir/index.adb" >/dev/null 2>&1; then
            failure=untrusted_signed_index; break
        fi
        rm -f "$dir/index.adb"
    done
    rm -rf "$dir"
    rmdir "$lock" 2>/dev/null || true
    if [ -n "$failure" ]; then fail "$failure"; return; fi
    # Do not enable feed as a side effect. Attest only a published matched repo.
    if ! uci set "veci.main.app_feed_verified_build_id=$id" ||
       ! uci commit veci; then
        fail verification_stamp_failed; return
    fi
    printf '{ "ok": true, "verified": true }\n'
}
case "$1" in
  list) printf '{ "status": {}, "verifyFeed": {} }\n' ;;
  call)
    case "$2" in
       status) method_status;;
       verifyFeed) method_verify;;
       *) fail method_not_found;;
    esac;;
esac
