# Reproducible isolated build tools (firmware sources pinned separately).
# The image is BUILD-ONLY; it never receives router SSH keys or router access.
FROM ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential bison flex gawk gettext git libncurses-dev libssl-dev \
    python3 python3-setuptools python3-pyelftools python3-yaml python3-venv \
    rsync unzip wget file curl ca-certificates xz-utils zlib1g-dev \
    subversion swig zstd bc cmake ninja-build patch perl pkg-config \
    libelf-dev ccache && rm -rf /var/lib/apt/lists/*
ENV HOME=/tmp
WORKDIR /build
USER 1000:1000
