#!/bin/sh
# Source-only v1.6.1. NEVER deployed until physical CNMI routing is verified.
# Max 30 modem-referenced SMS parts; destination and PDU kept as SHA256 only.
# No serial/modem commands, no logging of message content.
set -eu
umask 077
LC_ALL=C;export LC_ALL
STORE=/etc/veci-sms-delivery-map
FLAG=/etc/veci-sms-feature
fail(){ printf '{"ok":false,"reason":"delivery_unavailable"}\n';exit 1; }
[ "$(id -u)" = 0 ] || fail
[ "$(cat /tmp/sysinfo/board_name 2>/dev/null || :)" = zbtlink,zbt-we5927 ] || fail
[ -f "$FLAG" ] && [ ! -L "$FLAG" ] && [ "$(cat "$FLAG" 2>/dev/null || :)" = 1 ] || fail
[ -f "$STORE" ] && [ ! -L "$STORE" ] && [ "$(wc -c < "$STORE")" -le 9000 ] || fail
number(){ case "$1" in ''|*[!0-9]*)return 1;;*)return 0;;esac; }
mr_ok(){ number "$1" && [ "$(printf %s "$1"|wc -c)" -le 3 ] && [ "$1" -le 255 ]; }
sha(){ printf %s "$1" | sha256sum | awk '{print $1}'; }
norm(){
 value="$1"
 case "$value" in +*)value="$(printf %s "$value"|cut -c 2-)";;esac
 number "$value" || return 1
 size="$(printf %s "$value"|wc -c)"
 [ "$size" -ge 3 ] && [ "$size" -le 15 ] || return 1
 case "$value" in 08*)value="62$(printf %s "$value"|cut -c 2-)";;esac
 printf %s "$value"
}
check(){
 awk -F'|' '
 NF!=6||$1 !~ /^[0-9]+$/||length($1)>11||
 $2 !~ /^[0-9]+$/||$2+0>255||
 $3 !~ /^[0-9a-f]+$/||length($3)!=64||
 $4 !~ /^[0-9a-f]+$/||length($4)!=64||
 ($5!="accepted"&&$5!="pending"&&$5!="delivered"&&$5!="failed"&&$5!="unknown")||
 $6 !~ /^[0-9]+$/||$6+0>255 {bad=1}
 {if(NR>30)bad=1}END{exit bad}' "$STORE"
}
pdu_to(){
 printf %s "$1" | awk '
 function h(c){c=toupper(c);if(c~/^[0-9]$/)return c+0;return index("ABCDEF",c)+9}
 {
  s=$0;first=substr(s,3,2);
  if(substr(s,1,2)!="00"||(first!="21"&&first!="61"))exit 1;
  len=h(substr(s,7,1))*16+h(substr(s,8,1));
  if(len<3||len>15)exit 1;
  toa=substr(s,9,2);if(toa!="81"&&toa!="91")exit 1;
  if(length(s)<10+2*int((len+1)/2))exit 1;
  str=(toa=="91"?"+":"");
  for(i=0;i<len;i++){
   o=substr(s,11+2*int(i/2),2);
   d=i%2?substr(o,1,1):substr(o,2,1);
   if(d !~ /^[0-9]$/)exit 1;
   str=str d
  }
  if(len%2==1 && substr(s,11+2*int(len/2),1)!="F")exit 1;
  print str
 }'
}
atomic(){
 tmp="$STORE.new.$$"
 cat > "$tmp" || { rm -f "$tmp"; fail; }
 chmod 600 "$tmp" && mv -f "$tmp" "$STORE" || { rm -f "$tmp"; fail; }
}
check || fail
[ "$#" -ge 1 ] || fail
case "$1" in
 --track)
  [ "$#" = 2 ] && mr_ok "$2" || fail
  pdu="$(head -c 385)" || fail
  size="$(printf %s "$pdu"|wc -c)"
  [ "$size" -ge 22 ] && [ "$size" -le 384 ] && [ "$((size%2))" = 0 ] || fail
  case "$pdu" in *[!0-9A-F]*)fail;;esac
  recipient="$(pdu_to "$pdu")" || fail
  normalized="$(norm "$recipient")" || fail
  rcpt_hash="$(sha "$normalized")";pdu_hash="$(sha "$pdu")"
  now="$(date +%s)";number "$now" || fail
  awk -F'|' -v key="$pdu_hash" '$4==key{duplicate=1}END{exit duplicate}' "$STORE" || fail
  (tail -n 29 "$STORE";printf '%s|%s|%s|%s|accepted|255\n' "$now" "$2" "$rcpt_hash" "$pdu_hash") | atomic
  unset pdu recipient normalized
  printf '{"ok":true,"tracked":true}\n'
  ;;
 --apply)
  # Privileged future report receiver only. Never public HTTP API.
  [ "$#" = 4 ] && mr_ok "$2" && mr_ok "$4" || fail
  normalized="$(norm "$3")" || fail
  rcpt_hash="$(sha "$normalized")"
  status="$4";state=unknown
  if [ "$status" -eq 0 ];then state=delivered
  elif [ "$status" -ge 32 ] && [ "$status" -lt 64 ];then state=pending
  elif [ "$status" -ge 64 ] && [ "$status" -lt 128 ];then state=failed;fi
  now="$(date +%s)";number "$now" || fail
  # Ambiguous TP-MR reuse or mismatched recipient MUST NEVER mark Delivered.
  awk -F'|' -v mr="$2" -v rcpt="$rcpt_hash" -v now="$now" '
   $2==mr && $3==rcpt && now-$1>=0 && now-$1<=172800{matched++}
   END{exit matched==1?0:1}' "$STORE" || fail
  awk -F'|' -v OFS='|' -v mr="$2" -v rcpt="$rcpt_hash" -v now="$now" -v state="$state" -v st="$status" '
   $2==mr && $3==rcpt && now-$1>=0 && now-$1<=172800 {
     if($5!="delivered" || state=="delivered"){$5=state;$6=st}
   }
   {print}' "$STORE" | atomic
  printf '{"ok":true,"matched":true}\n'
  ;;
 --list)
  [ "$#" = 1 ] || fail
  awk -F'|' '
    BEGIN{printf "{\"ok\":true,\"source\":\"local_delivery\",\"count\":"}
    {digest[NR]=$4;state[NR]=$5;st[NR]=$6}
    END{
      printf "%d,\"reports\":[",NR;
      for(i=NR;i>=1;i--){
       if(i<NR)printf ",";
       printf "{\"pdu_sha\":\"%s\",\"state\":\"%s\",\"tp_st\":%s}",digest[i],state[i],st[i]
      }
      print "]}"
    }' "$STORE"
  ;;
 *)fail;;
esac
