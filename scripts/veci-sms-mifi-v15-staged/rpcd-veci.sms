#!/bin/sh
# OPTIONAL WE5927 rpcd exec plugin: status-changing SMS listing; no general AT.
# Expose via dedicated WRITE-only ubus ACL, never read/public ACL.
set -eu
umask 077
LC_ALL=C; export LC_ALL
WORKER=/usr/libexec/veci-sms-inbox-index
RATE_FILE=/tmp/veci-sms-inbox-last-attempt
RATE_LOCK=/var/lock/veci-sms-inbox-rpc.lock


STATE_FILE=/etc/veci-sms-feature
SMS_MIFI=/usr/libexec/veci-sms-mifi-inbox

sms_state() {
  [ ! -L "$STATE_FILE" ] && [ -f "$STATE_FILE" ] || return 1
  [ "$(cat "$STATE_FILE" 2>/dev/null || :)" = 1 ]
}
config() {
  [ "$(id -u)" -eq 0 ] || { deny admin_required; return; }
  if sms_state; then
    printf '{"ok":true,"enabled":true}\n'
  else
    printf '{"ok":true,"enabled":false}\n'
  fi
}
toggle() {
  [ "$(id -u)" -eq 0 ] || { deny admin_required; return; }
  command -v jsonfilter >/dev/null 2>&1 || { deny invalid_request; return; }
  input="$(head -c 129)" || { deny invalid_request; return; }
  [ "$(printf %s "$input" | wc -c)" -le 128 ] || { deny invalid_request; return; }
  state="$(jsonfilter -s "$input" -e '@.state' 2>/dev/null || :)"
  unset input
  case "$state" in on) next=1 ;; off) next=0 ;; *) deny invalid_request; return ;; esac
  unset state
  [ ! -L "$STATE_FILE" ] && [ -f "$STATE_FILE" ] ||
      { deny index_unavailable; return; }
  # State is on persistent flash only upon an explicit user switch.
  temp="$STATE_FILE.new.$$"
  (umask 077; printf '%s\n' "$next" > "$temp") ||
      { deny index_unavailable; return; }
  chmod 600 "$temp" || { rm -f "$temp"; deny index_unavailable; return; }
  mv -f "$temp" "$STATE_FILE" ||
      { rm -f "$temp"; deny index_unavailable; return; }
  if [ "$next" -eq 1 ]; then
    printf '{"ok":true,"enabled":true}\n'
  else
    printf '{"ok":true,"enabled":false}\n'
  fi
}
list_messages() {
  [ "$(id -u)" -eq 0 ] || { deny admin_required; return; }
  sms_state || { deny sms_disabled; return; }
  [ -x "$SMS_MIFI" ] || { deny worker_unavailable; return; }
  command -v flock >/dev/null 2>&1 || { deny index_unavailable; return; }
  # Only explicit calls; never query modem in getConfig or page render.
  (
    flock -n -x 8 || { deny request_busy; exit 0; }
    result="$("$SMS_MIFI" --list-pdu-once 2>/dev/null)" ||
        { deny index_unavailable; exit 0; }
    sms_state || { unset result; deny sms_disabled; exit 0; }
    [ "$(printf '%s' "$result" | wc -c)" -le 10000 ] ||
        { unset result; deny index_unavailable; exit 0; }
    # Worker owns strict PDU validation. Never print unparsed AT response.
    case "$result" in
      '{"ok":true,"source":"on_demand_cmgl_pdu","count":'*)
        printf '%s\n' "$result" ;;
      *) deny index_unavailable ;;
    esac
    unset result
  ) 8>"$RATE_LOCK"
}


SMS_DELETE=/usr/libexec/veci-sms-delete-one

delete_message(){
  [ "$(id -u)" -eq 0 ] || { deny admin_required; return; }
  sms_state || { deny sms_disabled; return; }
  [ -x "$SMS_DELETE" ] || { deny worker_unavailable; return; }
  command -v jsonfilter >/dev/null 2>&1 || { deny invalid_request; return; }
  input="$(head -c 1025)" || { deny invalid_request; return; }
  [ "$(printf %s "$input" | wc -c)" -le 1024 ] || { deny invalid_request; return; }
  idx="$(jsonfilter -s "$input" -e '@.index' 2>/dev/null || :)"
  store="$(jsonfilter -s "$input" -e '@.storage' 2>/dev/null || :)"
  pdu="$(jsonfilter -s "$input" -e '@.expectedPdu' 2>/dev/null || :)"
  unset input
  case "$idx" in ''|*[!0-9]*) deny invalid_request;return;;esac
  [ "$(printf %s "$idx"|wc -c)" -le 5 ] && [ "$idx" -le 65535 ] ||
      { deny invalid_request;return; }
  case "$store" in SM|ME);;*) deny invalid_request;return;;esac
  n="$(printf %s "$pdu"|wc -c)"
  [ "$n" -ge 4 ] && [ "$n" -le 512 ] && [ "$((n%2))" -eq 0 ] ||
      { deny invalid_request;return; }
  case "$pdu" in *[!0-9A-F]*) deny invalid_request;return;;esac
  (
    flock -n -x 8 || { deny request_busy;exit 0; }
    sms_state || { deny sms_disabled;exit 0; }
    result="$(printf %s "$pdu" | "$SMS_DELETE" "$idx" "$store" 2>/dev/null)" ||
      { deny index_unavailable;exit 0; }
    sms_state || { deny sms_disabled;exit 0; }
    expected="{\"ok\":true,\"deleted\":$idx,\"storage\":\"$store\"}"
    [ "$result" = "$expected" ] || { deny index_unavailable;exit 0; }
    printf '%s\n' "$expected"
  ) 8>"$RATE_LOCK"
}

deny() {
  case "$1" in
    admin_required|invalid_request|ack_required|worker_unavailable|index_unavailable|retry_later|request_busy|sms_disabled)
      reason="$1" ;;
    *) reason=index_unavailable ;;
  esac
  printf '{"ok":false,"reason":"%s","messages":[]}\n' "$reason"
}
list_index() {
  [ "$(id -u)" -eq 0 ] || { deny admin_required; return; }
  sms_state || { deny sms_disabled; return; }
  input="$(head -c 513)" || { deny invalid_request; return; }
  [ "$(printf %s "$input" | wc -c)" -le 512 ] ||
    { deny invalid_request; return; }
  command -v jsonfilter >/dev/null 2>&1 || { deny invalid_request; return; }
  scope="$(jsonfilter -s "$input" -e '@.scope' 2>/dev/null)" ||
    { deny invalid_request; return; }
  ack="$(jsonfilter -s "$input" -e '@.ack_unread_status' 2>/dev/null)" ||
    { deny invalid_request; return; }
  unset input
  if [ "$scope" != metadata_only ] ||
     [ "$ack" != I_ACCEPT_UNREAD_TO_READ ]; then
    deny ack_required
    return
  fi
  unset scope ack
  [ -x "$WORKER" ] || { deny worker_unavailable; return; }
  command -v flock >/dev/null 2>&1 || { deny index_unavailable; return; }
  # Per-device rate control prevents accidental repeated state-changing lists.
  # Reserve attempt BEFORE AT I/O, including if modem later times out.
  (
    flock -n -x 8 || { deny request_busy; exit 0; }
    now="$(date +%s)" || { deny index_unavailable; exit 0; }
    case "$now" in ''|*[!0-9]*) deny index_unavailable; exit 0 ;; esac
    last="$(cat "$RATE_FILE" 2>/dev/null || :)"
    case "$last" in
      ''|*[!0-9]*) ;;
      *)
        if [ "$now" -lt "$last" ] || [ "$((now - last))" -lt 60 ]; then
          deny retry_later
          exit 0
        fi
        ;;
    esac
    printf '%s\n' "$now" > "$RATE_FILE" ||
      { deny index_unavailable; exit 0; }
    result="$("$WORKER" --show-indices-only --ack-unread-may-be-marked-read 2>/dev/null)" ||
    { deny index_unavailable; return; }
  [ "$(printf %s "$result" | wc -c)" -le 1600 ] ||
    { deny index_unavailable; return; }
  # Only allow exact numeric metadata schema from validated worker, no PDU.
  if ! printf '%s\n' "$result" | grep -Eq \
     '^\{"ok":true,"source":"on_demand_cmgl","side_effect_acknowledged":true,"count":([0-9]|1[0-6]),"messages":\[(\{"index":[0-9]{1,5},"status":[0-4],"tpdu_octets":[0-9]{1,3}\}(,\{"index":[0-9]{1,5},"status":[0-4],"tpdu_octets":[0-9]{1,3}\}){0,15})?\]\}$'; then
    deny index_unavailable
    return
  fi
  printf '%s\n' "$result"
  ) 8>"$RATE_LOCK"
}
[ "$#" -ge 1 ] || exit 2
case "$1" in
  list)
    printf '{"listIndex":{"scope":"str","ack_unread_status":"str"},"getConfig":{},"setEnabled":{"state":"str"},"listMessages":{},"deleteMessage":{"index":"int","storage":"str","expectedPdu":"str"}}\n'
    ;;
  call)
    [ "$#" -ge 2 ] || { deny invalid_request; exit 0; }
    case "$2" in
      listIndex) list_index ;;
      getConfig) config ;;
      setEnabled) toggle ;;
      listMessages) list_messages ;;
      deleteMessage) delete_message ;;
      *) deny invalid_request ;;
    esac
    ;;
  *) exit 2 ;;
esac
