#!/bin/sh
set -eu
umask 077
fail() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 0; }
case "${1:-}:${2:-}" in
  list:*) echo '{"status":{},"setFailover":{"action":"String"}}'; exit 0 ;;
  call:status|call:setFailover) ;;
  *) fail unsupported_method ;;
esac
[ "$(cat /tmp/sysinfo/board_name)" = zbtlink,zbt-we5927 ] || fail unsupported_board
if [ "$2" = setFailover ]; then
  request=$(head -c 257)
  [ "${#request}" -le 256 ] || fail invalid_request
  action=$(jsonfilter -s "$request" -e '@.action') || fail invalid_request
  case "$action" in ENABLE_FAILOVER) desired=1 ;; DISABLE_FAILOVER) desired=0 ;; *) fail invalid_action ;; esac
  exec 9<"$0"
  flock -n 9 || fail busy
fi
cfg=we5927_lte.main
[ "$(uci -q get "$cfg")" = modem ] || fail no_modem_configuration
pending=$(uci -q changes we5927_lte) || fail config_unavailable
[ -z "$pending" ] || fail pending_lte_changes
value=$(uci -q get "$cfg.auto_failover" || :)
case "$value" in ''|0) value=0 ;; 1) ;; *) fail invalid_policy ;; esac
if [ "$2" = setFailover ] && [ "$value" != "$desired" ]; then
  tmp=$(mktemp -d /tmp/veci2-lte-policy.XXXXXX)
  trap 'rm -rf "$tmp"' EXIT
  trap 'exit 1' HUP INT TERM
  uci -q -t "$tmp" set "$cfg.auto_failover=$desired" &&
    uci -q -t "$tmp" commit we5927_lte || fail save_failed
  value=$(uci -q get "$cfg.auto_failover") || fail save_failed
  [ "$value" = "$desired" ] || fail save_failed
fi
slot=$(uci -q get "$cfg.sim" || :)
case "$slot" in 1|2) ;; *) slot=null ;; esac
case "$value" in 1) enabled=true ;; *) enabled=false ;; esac
printf '{"ok":true,"auto_failover":%s,"configured_slot":%s}\n' "$enabled" "$slot"
