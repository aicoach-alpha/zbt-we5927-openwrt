#!/bin/sh
set -eu
umask 077
fail() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 0; }
case "${1:-}:${2:-}" in
  list:*) echo '{"status":{},"queueSim":{"slot":"String"},"setFailover":{"action":"String"},"setApn":{"apn":"String"}}'; exit 0 ;;
  call:status|call:queueSim|call:setFailover|call:setApn) ;;
  *) fail unsupported_method ;;
esac
[ "$(cat /tmp/sysinfo/board_name)" = zbtlink,zbt-we5927 ] || fail unsupported_board
if [ "$2" != status ]; then
  request=$(head -c 257)
  [ "${#request}" -le 256 ] || fail invalid_request
  if [ "$2" = queueSim ]; then
    slot=$(jsonfilter -s "$request" -e '@.slot') || fail invalid_request
    case "$slot" in 1|2) ;; *) fail invalid_slot ;; esac
  elif [ "$2" = setApn ]; then
    option=apn
    desired=$(jsonfilter -s "$request" -e '@.apn') || fail invalid_request
    /usr/sbin/we5927-lte validate-apn "$desired" || fail invalid_apn
  else
    option=auto_failover
    action=$(jsonfilter -s "$request" -e '@.action') || fail invalid_request
    case "$action" in ENABLE_FAILOVER) desired=1 ;; DISABLE_FAILOVER) desired=0 ;; *) fail invalid_action ;; esac
  fi
  exec 9<"$0"
  flock -n 9 || fail busy
fi
cfg=we5927_lte.main
[ "$(uci -q get "$cfg")" = modem ] || fail no_modem_configuration
pending=$(uci -q changes we5927_lte) || fail config_unavailable
[ -z "$pending" ] || fail pending_lte_changes
value=$(uci -q get "$cfg.auto_failover" || :)
case "$value" in ''|0) value=0 ;; 1) ;; *) fail invalid_policy ;; esac
if [ "$2" = queueSim ]; then
  /usr/sbin/we5927-lte queue-sim "$slot" || fail switch_unavailable
elif [ "$2" != status ] && [ "$(uci -q get "$cfg.$option" || :)" != "$desired" ]; then
  tmp=$(mktemp -d /tmp/veci2-lte-policy.XXXXXX)
  trap 'rm -rf "$tmp"' EXIT
  trap 'exit 1' HUP INT TERM
  uci -q -t "$tmp" set "$cfg.$option=$desired" &&
    uci -q -t "$tmp" commit we5927_lte || fail save_failed
  [ "$(uci -q get "$cfg.$option")" = "$desired" ] || fail save_failed
  [ "$option" != auto_failover ] || value=$desired
fi
slot=$(uci -q get "$cfg.sim" || :)
case "$slot" in 1|2) ;; *) slot=null ;; esac
selected=$(/usr/sbin/we5927-lte selector-slot 2>/dev/null) || selected=
case "$selected" in 1|2) ;; *) selected=null ;; esac
case "$value" in 1) enabled=true ;; *) enabled=false ;; esac
apn=$(uci -q get "$cfg.apn" || :)
[ -n "$apn" ] || apn=internet
if /usr/sbin/we5927-lte validate-apn "$apn"; then
  apn_json=$(printf '"%s"' "$apn")
else
  apn_json=null
fi
switch_state=$(/usr/sbin/we5927-lte sim-request-status) || switch_state=unknown
case "$switch_state" in queued|switching|interrupted|idle|expired|selector_changed|selection_failed|interface_started|restored|recovery_failed) ;; *) switch_state=unknown ;; esac
printf '{"ok":true,"switch_state":"%s","auto_failover":%s,"configured_slot":%s,"selector_slot":%s,"configured_apn":%s}\n' "$switch_state" "$enabled" "$slot" "$selected" "$apn_json"
