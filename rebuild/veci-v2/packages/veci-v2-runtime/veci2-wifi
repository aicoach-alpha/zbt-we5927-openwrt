#!/bin/sh
set -eu
umask 077
fail() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 0; }
ap=wireless.default_radio0
check_ap() {
  [ "$(cat /tmp/sysinfo/board_name)" = zbtlink,zbt-we5927 ] || fail unsupported_board
  [ "$(uci -q get "$ap")" = wifi-iface ] &&
    [ "$(uci -q get "$ap.device")" = radio0 ] &&
    [ "$(uci -q get "$ap.mode")" = ap ] || fail primary_ap_unavailable
  [ "$(uci -q get wireless.radio0)" = wifi-device ] &&
    [ "$(uci -q get wireless.radio0.band)" = 2g ] || fail channel_unavailable
  changes=$(uci -q changes wireless) || fail config_unavailable
  [ -z "$changes" ] || fail pending_wireless_changes
}
visibility() {
  case "$(uci -q get "$ap.hidden" || :)" in
    ''|0|false|off|no) visible=true ;;
    1|true|on|yes) visible=false ;;
    *) fail invalid_visibility ;;
  esac
}
# Use UCI and libubox jshn; do not require optional hexdump, od or base64.
ssid_value() {
  uci -q get "$ap.ssid"
}
primary_channel() {
  [ "$(uci -q get wireless.radio0)" = wifi-device ] &&
    [ "$(uci -q get wireless.radio0.band)" = 2g ] || return 1
  channel=$(uci -q get wireless.radio0.channel) || return 1
  case "$channel" in auto|[1-9]|1[0-4]) printf '%s' "$channel" ;; *) return 1 ;; esac
}
save_option() {
  local tmp
  tmp=$(mktemp -d /tmp/veci2-wifi.XXXXXX) || fail save_failed
  trap 'rm -rf "$tmp"' EXIT
  trap 'exit 1' HUP INT TERM
  uci -q -t "$tmp" set "$1=$2" && uci -q -t "$tmp" commit wireless || fail save_failed
  rm -rf "$tmp"
  trap - EXIT HUP INT TERM
}
# Optional dedicated STA on WAN-zoned DHCP. Provisioning is config-only; no live reload.
uplink=wireless.veci_uplink
uplink_revision() {
  for cfg in wireless network firewall; do [ -f "/etc/config/$cfg" ] && [ ! -L "/etc/config/$cfg" ] || return 1; done
  digest=$(sha256sum /etc/config/wireless /etc/config/network /etc/config/firewall) || return 1
  digest=$(printf '%s' "$digest" | sha256sum) || return 1
  printf '%s' "${digest%% *}"
}
# First-time WWAN provisioning is deliberately separate from credentials and
# activation. Never take over a foreign network, STA, or zone.
wwan_empty() {
  [ -z "$(uci -q get network.wwan || :)" ] &&
  [ -z "$(uci -q get "$uplink" || :)" ] || return 1
  [ "$(uci -q get firewall.@zone[0].name || :)" = lan ] &&
  [ "$(uci -q get firewall.@zone[1].name || :)" = wan ] &&
  [ "$(uci -q get firewall.@zone[1].input || :)" = REJECT ] &&
  [ "$(uci -q get firewall.@zone[1].masq || :)" = 1 ] || return 1
  zones=$(uci -q show firewall) || return 1
  # Reject any existing references to WWAN, including foreign rule bindings.
  if printf '%s\n' "$zones" | grep -Eq '(^|[^a-zA-Z0-9_])wwan([^a-zA-Z0-9_]|$)'; then return 1; fi
  [ "$(printf '%s\n' "$zones" | awk -F= 'BEGIN{q=sprintf("%c",39)} $1~/[.]name$/ && $2==q "wan" q {n++} END{print n+0}')" = 1 ] || return 1
  networks=$(uci -q get 'firewall.@zone[1].network') || return 1
  case " $networks " in *" wan "*) ;; *) return 1;; esac
  case " $networks " in *" lte "*) ;; *) return 1;; esac
  wifi=$(uci -q show wireless) || return 1
  if printf '%s\n' "$wifi" | grep -Eq "(^|[^a-zA-Z0-9_])wwan([^a-zA-Z0-9_]|$)|[.]mode='sta'$"; then return 1; fi
  net=$(uci -q show network) || return 1
  if printf '%s\n' "$net" | grep -Eq '(^|[^a-zA-Z0-9_])wwan([^a-zA-Z0-9_]|$)'; then return 1; fi
}
wwan_provision() {
  for cfg in network firewall wireless; do
    changes=$(uci -q changes "$cfg") || fail config_unavailable
    [ -z "$changes" ] || fail pending_changes
  done
  [ ! -e /var/run/veci2-reboot-requested ] || fail reboot_pending
  request=$(head -c 513)
  [ "${#request}" -le 512 ] || fail invalid_request
  set +u; . /usr/share/libubox/jshn.sh
  json_load "$request" || fail invalid_request
  json_get_var expected revision; json_get_var confirm confirmation
  [ "$confirm" = PROVISION_WWAN_DISABLED ] || fail confirmation_required
  [ -n "$expected" ] && [ "$expected" = "$(uplink_revision)" ] || fail stale_configuration
  wwan_empty || fail foreign_or_unsupported_topology
  tmp=$(mktemp -d /tmp/veci2-wwan.XXXXXX) || fail stage_failed
  trap 'rm -rf "$tmp"' EXIT
  for cfg in network firewall; do cp -p "/etc/config/$cfg" "$tmp/$cfg.original" || fail backup_failed; done
  change() { uci -q -t "$tmp" "$@"; }
  change set network.wwan=interface &&
  change set network.wwan.proto=dhcp &&
  change set network.wwan.metric=50 &&
  change set network.wwan.ipv6=0 &&
  change add_list 'firewall.@zone[1].network=wwan' || fail stage_failed
  [ "$expected" = "$(uplink_revision)" ] || fail stale_configuration
  for cfg in network firewall wireless; do
    changes=$(uci -q changes "$cfg") || fail config_unavailable
    [ -z "$changes" ] || fail pending_changes
  done
  rollback_wwan() {
    for cfg in network firewall; do cp -p "$tmp/$cfg.original" "/etc/config/$cfg" || return 1; done
  }
  if ! change commit network || ! change commit firewall || ! uplink_ready || ! fw4 check >/dev/null 2>&1; then
    rollback_wwan || fail rollback_failed
    fail validation_failed_rollback
  fi
  uplink_status
}
uplink_ready() {
  [ "$(uci -q get network.wwan || :)" = interface ] &&
  [ "$(uci -q get network.wwan.proto || :)" = dhcp ] &&
  [ -z "$(uci -q get network.wwan.device || :)" ] &&
  [ "$(uci -q get firewall.@zone[1].name || :)" = wan ] &&
  [ "$(uci -q get firewall.@zone[1].input || :)" = REJECT ] || return 1
  case " $(uci -q get firewall.@zone[1].network || :) " in *" wwan "*) ;; *) return 1;; esac
  case " $(uci -q get firewall.@zone[0].network || :) " in *" wwan "*) return 1;; esac
  # No other STA, including anonymous UCI sections.
  inventory=$(uci -q show wireless) || return 1
  sta=$(printf '%s\n' "$inventory" | sed -nE "s/^wireless\.([^.]*)\.mode='sta'$/\1/p")
  [ -z "$sta" ] || [ "$sta" = veci_uplink ] || return 1
  if [ -n "$(uci -q get "$uplink" || :)" ]; then
    [ "$(uci -q get "$uplink" || :)" = wifi-iface ] &&
    [ "$(uci -q get "$uplink.device" || :)" = radio0 ] &&
    [ "$(uci -q get "$uplink.mode" || :)" = sta ] &&
    [ "$(uci -q get "$uplink.network" || :)" = wwan ] || return 1
  fi
}
uplink_status() {
  ready=0; exists=0; enabled=0; provisionable=0
  if wwan_empty; then provisionable=1; fi
  if uplink_ready; then ready=1; fi
  if [ "$(uci -q get "$uplink" || :)" = wifi-iface ]; then
    exists=1
    case "$(uci -q get "$uplink.disabled" || :)" in 0) enabled=1;; 1) ;; *) ready=0;; esac
  fi
  set +u
  . /usr/share/libubox/jshn.sh
  json_init; json_add_boolean ok 1
  rev=$(uplink_revision) || fail config_unavailable
  json_add_string revision "$rev"
  json_add_boolean provisionable "$provisionable"
  json_add_boolean eligible "$ready"; json_add_boolean configured "$exists"
  json_add_boolean enabled "$enabled"
  json_add_string ssid "$(uci -q get "$uplink.ssid" || :)"
  json_add_boolean connection_verified 0
  json_dump
}
uplink_save() {
  uplink_ready || fail wwan_topology_unavailable
  for cfg in network firewall wireless; do
    changes=$(uci -q changes "$cfg") || fail config_unavailable
    [ -z "$changes" ] || fail pending_changes
  done
  request=$(head -c 1025)
  [ "${#request}" -le 1024 ] || fail invalid_request
  set +u
  . /usr/share/libubox/jshn.sh
  json_load "$request" || fail invalid_request
  json_get_var expected revision; json_get_var confirm confirmation
  json_get_var action action; json_get_var name ssid; json_get_var secret password
  [ -n "$expected" ] && [ "$expected" = "$(uplink_revision)" ] || fail stale_configuration
  case "$action:$confirm" in save:SAVE_UPLINK_DISABLED|enable:ENABLE_UPLINK_NEXT_BOOT|disable:DISABLE_UPLINK_NEXT_BOOT) ;; *) fail confirmation_required;; esac
  tmp=$(mktemp -d /tmp/veci2-uplink.XXXXXX) || fail stage_failed
  trap 'rm -rf "$tmp"' EXIT
  cp -p /etc/config/wireless "$tmp/wireless.original" || fail backup_failed
  change() { uci -q -t "$tmp" "$@"; }
  if [ "$action" = save ]; then
    [ -z "$(uci -q get "$uplink" || :)" ] || [ "$(uci -q get "$uplink.disabled" || :)" = 1 ] || fail disable_profile_first
    [ "${#name}" -ge 1 ] && [ "${#name}" -le 32 ] && [ "${#secret}" -ge 8 ] && [ "${#secret}" -le 63 ] || fail invalid_credentials
    # Restricted printable subset prevents UCI batch grammar injection.
    case "$name$secret" in *[!a-zA-Z0-9._@%+=,:!/?#~\ -]*) fail unsupported_credential_characters;; esac
    {
      printf 'set %s=wifi-iface\n' "$uplink"
      for pair in device=radio0 mode=sta network=wwan encryption=psk2 disabled=1; do printf 'set %s.%s\n' "$uplink" "$pair"; done
      printf "set %s.ssid='%s'\n" "$uplink" "$name"
      printf "set %s.key='%s'\n" "$uplink" "$secret"
    } | change batch >/dev/null 2>&1 || fail stage_failed
  else
    [ "$(uci -q get "$uplink" || :)" = wifi-iface ] || fail profile_unavailable
    if [ "$action" = enable ]; then
      [ "$(uci -q get "$uplink.encryption" || :)" = psk2 ] || fail unsupported_encryption
      secret=$(uci -q get "$uplink.key" || :)
      [ "${#secret}" -ge 8 ] && [ "${#secret}" -le 63 ] || fail invalid_credentials
      [ -n "$(uci -q get "$uplink.ssid" || :)" ] || fail invalid_ssid
      change set "$uplink.disabled=0" || fail stage_failed
    else change set "$uplink.disabled=1" || fail stage_failed; fi
  fi
  unset secret request
  [ "$expected" = "$(uplink_revision)" ] || fail stale_configuration
  for cfg in network firewall wireless; do
    changes=$(uci -q changes "$cfg") || fail config_unavailable
    [ -z "$changes" ] || fail pending_changes
  done
  if ! change commit wireless || ! uplink_ready; then
    cp -p "$tmp/wireless.original" /etc/config/wireless || fail rollback_failed
    fail validation_failed_rollback
  fi
  uplink_status
}
case "${1:-}:${2:-}" in
  list:*) echo '{"status":{},"uplinkStatus":{},"provisionWwan":{"revision":"String","confirmation":"String"},"saveUplink":{"revision":"String","confirmation":"String","action":"String","ssid":"String","password":"String"},"info":{},"survey":{},"setChannel":{"channel":"String"},"power":{},"setPower":{"dbm":"String","expected":"String","confirmation":"String"},"setAuth":{"mode":"String","key_hex":"String"},"setAccess":{"mode":"String","addresses":"String"},"setVisibility":{"action":"String"},"setSsid":{"ssid_hex":"String"},"setAutoChannel":{"action":"String"},"activationStatus":{},"activateAp":{"confirmation":"String"}}'; exit 0 ;;
  call:uplinkStatus|call:saveUplink|call:provisionWwan)
    exec 8>/var/lock/veci2-ipv6.lock; flock -n 8 || fail network_busy
    exec 9<"$0"; flock -n 9 || fail wifi_busy
    check_ap
    if [ "$2" = uplinkStatus ]; then uplink_status; else
      exec 7</usr/libexec/rpcd/veci.v2.firewall; flock -n 7 || fail firewall_busy
      if [ "$2" = provisionWwan ]; then wwan_provision; else uplink_save; fi
    fi
    exit 0 ;;
  call:activationStatus|call:activateAp)
    check_ap
    if [ "$2" = activationStatus ]; then
      phase=idle
      if [ -r /tmp/veci2-wifi-activate.state ]; then
        raw=$(cat /tmp/veci2-wifi-activate.state 2>/dev/null) || raw=
        case "$raw" in
          preflight|saving|prepared_next_reboot) phase=$raw ;;
          failed:*)
            reason=$(printf %s "$raw" | sed 's/^failed://')
            case "$reason" in ''|*[!a-z0-9_]*) phase=failed ;; *) phase="failed:$reason" ;; esac ;;
        esac
      fi
      eligible=false
      key=$(uci -q get "$ap.key" 2>/dev/null || :)
      key_length=$(printf %s "$key" | wc -c | tr -d ' ')
      unset key
      if [ "$(uci -q get "$ap.disabled" 2>/dev/null || :)" = 1 ] &&
         [ "$(uci -q get "$ap.encryption" 2>/dev/null || :)" = psk2 ] &&
         [ "$key_length" -ge 8 ] && [ "$key_length" -le 63 ] &&
         [ -n "$(ssid_value)" ]; then eligible=true; fi
      case "$phase" in failed:*|preflight|saving|prepared_next_reboot) eligible=false ;; esac
      # After the separately approved manual reboot, /tmp phase disappears.
      # A persisted AP config alone is NOT proof that the radio or client works.
      if [ "$(uci -q get "$ap.disabled" 2>/dev/null || :)" = 0 ] &&
         [ "$phase" = idle ]; then phase=enabled_unverified; fi
      printf '{"ok":true,"phase":"%s","eligible":%s,"beacon_verified":false}\n' "$phase" "$eligible"
    else
      request=$(head -c 257)
      [ "$(printf %s "$request" | wc -c | tr -d ' ')" -le 256 ] || fail invalid_request
      action=$(jsonfilter -s "$request" -e '@.confirmation' 2>/dev/null) || fail invalid_request
      [ "$action" = PREPARE_WPA2_AP_NEXT_BOOT ] || fail explicit_confirmation_required
      [ -x /usr/libexec/veci2-wifi-activate ] || fail activation_helper_missing
      [ "$(uci -q get "$ap.disabled" 2>/dev/null || :)" = 1 ] || fail ap_already_enabled
      case "$(cat /tmp/veci2-wifi-activate.state 2>/dev/null)" in
        preflight|saving) fail activation_already_running ;;
        prepared_next_reboot) fail manual_reboot_required_before_retry ;;
        failed:*) fail previous_activation_failed_manual_review_required ;;
      esac
      ( /usr/libexec/veci2-wifi-activate ) </dev/null >/dev/null 2>&1 &
      printf '{"ok":true,"queued":true,"internet_verified":false,"beacon_verified":false}\n'
    fi
    exit 0 ;;
  call:info|call:survey|call:setChannel|call:setAuth|call:setAccess|call:power|call:setPower)
    . /usr/libexec/veci2-wifi-controls
    check_ap
    case "$2" in
      info) advanced_info ;;
      power) power_status ;;
      survey) exec 9<"$0"; flock -n 9 || fail busy; survey ;;
      *)
        request=$(head -c 1025)
        test "$(printf '%s' "$request" | wc -c)" -le 1024 || fail invalid_request
        exec 9<"$0"; flock -n 9 || fail busy
        check_ap; advanced_write "$@" ;;
    esac
    exit 0 ;;
  call:status) check_ap; visibility ;;
  call:setVisibility|call:setSsid|call:setAutoChannel)
    request=$(head -c 257)
    [ "${#request}" -le 256 ] || fail invalid_request
    exec 9<"$0"
    flock -n 9 || fail busy
    check_ap
    visibility
    if [ "$2" = setAutoChannel ]; then
      action=$(jsonfilter -s "$request" -e '@.action') || fail invalid_request
      [ "$action" = AUTO_CHANNEL_2G ] || fail invalid_action
      channel=$(primary_channel) || fail channel_unavailable
      if [ "$channel" != auto ]; then
        save_option wireless.radio0.channel auto
        [ "$(primary_channel)" = auto ] || fail save_failed
      fi
    elif [ "$2" = setVisibility ]; then
      action=$(jsonfilter -s "$request" -e '@.action') || fail invalid_request
      case "$action" in SHOW_SSID) desired=true; hidden=0 ;; HIDE_SSID) desired=false; hidden=1 ;; *) fail invalid_action ;; esac
      if [ "$visible" != "$desired" ]; then
        save_option "$ap.hidden" "$hidden"
        check_ap
        visibility
        [ "$visible" = "$desired" ] || fail save_failed
      fi
    else
      desired=$(jsonfilter -s "$request" -e '@.ssid_hex') || fail invalid_request
      case "$desired" in ''|*[!0123456789abcdef]*) fail invalid_ssid ;; esac
      [ "${#desired}" -le 64 ] && [ $((${#desired} % 2)) -eq 0 ] || fail invalid_ssid
      remaining=$desired
      name=
      while [ -n "$remaining" ]; do
        rest=${remaining#??}
        pair=${remaining%"$rest"}
        case "$pair" in 0?|1?|7f) fail invalid_ssid ;; esac
        name=$name$(printf '%b' "$(printf '\\%03o' "0x$pair")")
        remaining=$rest
      done
      current=$(ssid_value) || fail config_unavailable
      if [ "$current" != "$name" ]; then
        save_option "$ap.ssid" "$name"
        check_ap
        [ "$(ssid_value)" = "$name" ] || fail save_failed
      fi
    fi ;;
  *) fail unsupported_method ;;
esac
configured=$(ssid_value) || fail config_unavailable
channel=$(primary_channel) || channel=
# libubox jshn uses intentionally unset dynamic JSON variables.
set +u
. /usr/share/libubox/jshn.sh || fail json_encoder_unavailable
json_init
json_add_boolean ok 1
case "$visible" in true) json_add_boolean configured_visible 1 ;;
  *) json_add_boolean configured_visible 0 ;; esac
json_add_string ssid "$configured"
json_add_string configured_channel "$channel"
json_dump
