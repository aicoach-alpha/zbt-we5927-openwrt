#!/bin/sh
set -eu
umask 077
fail() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 0; }
case "${1:-}:${2:-}" in
  list:*) echo '{"reliability":{},"systemLog":{},"kernelLog":{},"lookup":{"target":"String"},"ping":{"target":"String"},"trace":{"target":"String"}}'; exit 0 ;;
  call:reliability|call:systemLog|call:kernelLog|call:lookup|call:ping|call:trace) ;;
  *) fail invalid_method ;;
esac
[ "$(cat /tmp/sysinfo/board_name)" = zbtlink,zbt-we5927 ] || fail board_mismatch
case "$2" in
  lookup|ping|trace)
    request=$(head -c 513)
    [ "${#request}" -le 512 ] || fail invalid_request
    target=$(jsonfilter -s "$request" -e '@.target') || fail invalid_target
    case "$target" in ''|-*|.*|*..*|*[!a-zA-Z0-9.-]*) fail invalid_target ;; esac
    [ "${#target}" -le 253 ] || fail invalid_target ;;
esac
exec 9<"$0"
flock -n 9 || fail busy
tmp=$(mktemp /tmp/veci2-diag.XXXXXX) || fail unavailable
trap 'rm -f "$tmp"' EXIT
trap 'exit 1' HUP INT TERM
run() {
  case "$2" in
    reliability) timeout 3 /usr/libexec/veci2-reliability 9<&- ;;
    systemLog) timeout 4 logread -l 80 ;;
    kernelLog) timeout 4 dmesg ;;
    lookup) timeout 5 nslookup "$target" ;;
    ping) timeout 7 ping -c 3 -W 1 "$target" ;;
    trace) timeout 10 traceroute -n -q 1 -w 1 -m 6 "$target" ;;
  esac
}
rc=0
(ulimit -f 2048; run "$@") > "$tmp" 2>&1 || rc=$?
# Keep diagnostic output bounded, with single-byte printable text for JSON on any locale.
export LC_ALL=C
printf '{"ok":true,"exit_code":%d,"lines":[' "$rc"
tail -n 80 "$tmp" | tr -cd '\12\40-\176' | awk '{
  line=substr($0,1,320)
  printf "%s\"",NR==1 ? "" : ","
  for (i=1;i<=length(line);i++) {
    c=substr(line,i,1)
    if (c=="\\" || c=="\"") printf "\\"
    printf "%s",c
  }
  printf "\""
}'
printf ']}\n'
