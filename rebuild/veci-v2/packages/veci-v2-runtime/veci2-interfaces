#!/bin/sh
set -ef
umask 077
fail() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 0; }
case "$1:${2:-}" in
  list:*) echo '{"status":{},"pppoeStatus":{},"savePppoe":{"revision":"String","confirmation":"String","username":"String","password":"String","service":"String","ac":"String"},"pppoeDiscovery":{},"pppoeAction":{"action":"String","revision":"String","confirmation":"String"},"save":{"revision":"String","confirm":"String","lan":"String","lan_mask":"String","wan_mode":"String","wan":"String","wan_mask":"String","gateway":"String"}}'; exit 0 ;;
  call:save|call:status|call:pppoeStatus|call:pppoeDiscovery|call:pppoeAction|call:savePppoe) ;;
  *) fail unsupported_method ;;
esac
[ "$(cat /tmp/sysinfo/board_name)" = zbtlink,zbt-we5927 ] || fail board_mismatch
. /usr/share/libubox/jshn.sh
exec 9>/var/lock/veci2-ipv6.lock
flock -n 9 || fail busy
cfg=/etc/config/network
[ -f "$cfg" ] && [ ! -L "$cfg" ] || fail config_unavailable
revision() { digest=$(sha256sum "$cfg") || return 1; echo "${digest%% *}"; }
get() { uci -q get "network.$1" || :; }
[ "$(get lan)" = interface ] && [ "$(get wan)" = interface ] && [ "$(get lan.proto)" = static ] || fail unsupported_layout
# Ethernet PPPoE must never operate on the cellular RNDIS device.
pppoe_device() {
  dev=$(get wan.device)
  expected=$(jsonfilter -i /etc/board.json -e '@.network.wan.device' 2>/dev/null) || return 1
  [ "$dev" = eth0.2 ] && [ "$expected" = "$dev" ] && [ -d "/sys/class/net/$dev" ] || return 1
  [ "$(get lte.device)" = usb0 ] || return 1
  [ "$(get lan.device)" != "$dev" ] || return 1
  printf '%s' "$dev"
}
pppoe_status() {
  proto=$(get wan.proto)
  snapshot=$(ubus -t 3 call network.interface.wan status '{}') || fail wan_state_unavailable
  live_proto=$(printf '%s' "$snapshot" | jsonfilter -e '@.proto' || :)
  up=$(printf '%s' "$snapshot" | jsonfilter -e '@.up' || :)
  pending=$(printf '%s' "$snapshot" | jsonfilter -e '@.pending' || :)
  case "$up:$pending" in true:true|true:false|false:true|false:false) ;; *) fail invalid_wan_state;; esac
  ip=$(printf '%s' "$snapshot" | jsonfilter -e '@["ipv4-address"][0].address' || :)
  state=not_configured
  if [ "$proto" = pppoe ]; then
    state=disconnected
    if [ "$live_proto" != pppoe ]; then state=pending_activation
    elif [ "$pending" = true ]; then state=connecting
    elif [ "$up" = true ] && [ -n "$ip" ] && [ "$ip" != 0.0.0.0 ]; then state=connected
    elif [ "$up" = true ]; then state=link_up_no_ipv4; fi
  fi
  [ "$state" = connected ] || ip=
  json_init; json_add_boolean ok 1
  json_add_string revision "$(revision)"
  json_add_string configured_protocol "$proto"
  json_add_boolean credentials_configured "$(if [ "$proto" = pppoe ] && [ -n "$(get wan.username)" ] && [ -n "$(get wan.password)" ]; then echo 1; else echo 0; fi)"
  json_add_string state "$state"; json_add_string ipv4 "$ip"
  json_add_boolean internet_verified 0
  json_dump
}
case "$2" in
  savePppoe)
    dev=$(pppoe_device) || fail ethernet_wan_unverified
    [ -x /usr/sbin/pppd ] && [ -x /lib/netifd/proto/ppp.sh ] || fail pppoe_package_unavailable
    changes=$(uci -q changes network) || fail config_unavailable
    [ -z "$changes" ] || fail pending_network_changes
    input=$(head -c 1025)
    [ "${#input}" -le 1024 ] && json_load "$input" || fail invalid_request
    json_get_var token revision; json_get_var confirm confirmation
    json_get_var account username; json_get_var secret password
    json_get_var service service; json_get_var ac ac
    [ "$confirm" = SAVE_ETHERNET_PPPOE_NEXT_BOOT ] || fail confirmation_required
    [ "$token" = "$(revision)" ] || fail stale_configuration
    case "$(get wan.proto)" in dhcp|static|pppoe) ;; *) fail unsupported_wan_protocol;; esac
    # Strict printable credential subset: never evaluate strings or place them
    # in a process argument. The UCI batch receives them via stdin.
    [ -n "$account" ] && [ "${#account}" -le 128 ] && [ -n "$secret" ] && [ "${#secret}" -le 128 ] || fail invalid_credentials
    for value in "$account" "$secret"; do
      case "$value" in *[!a-zA-Z0-9._@%+=,:!/?#~-]*) fail unsupported_credential_characters;; esac
    done
    for value in "$service" "$ac"; do
      [ "${#value}" -le 64 ] || fail invalid_service
      case "$value" in *[!a-zA-Z0-9._@-]*) fail invalid_service;; esac
    done
    tmp=$(mktemp -d /tmp/veci2-pppoe.XXXXXX) || fail stage_failed
    trap 'rm -rf "$tmp"' EXIT
    change() { uci -q -t "$tmp" "$@"; }
    remove() { if change get "$1" >/dev/null 2>&1; then change delete "$1"; fi; }
    remove network.wan.ipaddr && remove network.wan.netmask && remove network.wan.gateway &&
      remove network.wan.service && remove network.wan.ac || fail stage_failed
    # printf is a shell builtin; no password in external process argv.
    {
      printf 'set network.wan.proto=pppoe\n'
      printf "set network.wan.username='%s'\n" "$account"
      printf "set network.wan.password='%s'\n" "$secret"
      [ -z "$service" ] || printf "set network.wan.service='%s'\n" "$service"
      [ -z "$ac" ] || printf "set network.wan.ac='%s'\n" "$ac"
    } | change batch >/dev/null 2>&1 || fail stage_failed
    unset secret input value
    pending=$(uci -q changes network) || fail config_unavailable
    [ "$token" = "$(revision)" ] && [ -z "$pending" ] || fail stale_configuration
    change commit network || fail commit_failed
    [ "$(get wan.proto)" = pppoe ] || fail commit_failed
    json_init; json_add_boolean ok 1; json_add_boolean saved 1
    json_add_string revision "$(revision)"
    json_add_string state pending_manual_activation
    json_add_boolean internet_verified 0
    json_dump; exit 0;;
  pppoeStatus) pppoe_status; exit 0;;
  pppoeDiscovery)
    dev=$(pppoe_device) || fail ethernet_wan_unverified
    [ -x /usr/sbin/pppoe-discovery ] || fail discovery_tool_unavailable
    # Discovery only, no session establishment or link reset.
    rc=0
    output=$(timeout 12 /usr/sbin/pppoe-discovery -I "$dev" 2>&1) || rc=$?
    json_init; json_add_boolean ok 1; json_add_int exit_code "$rc"
    json_add_string interface "$dev"
    json_add_string output "$(printf '%s' "$output" | head -c 2048)"
    json_add_boolean session_established 0
    json_dump; exit 0;;
  pppoeAction)
    [ ! -e /var/run/veci2-reboot-requested ] || fail reboot_pending
    dev=$(pppoe_device) || fail ethernet_wan_unverified
    [ "$(get wan.proto)" = pppoe ] || fail pppoe_not_configured
    changes=$(uci -q changes network) || fail config_unavailable
    [ -z "$changes" ] || fail pending_network_changes
    request=$(head -c 513)
    [ "${#request}" -le 512 ] && json_load "$request" || fail invalid_request
    json_get_var token revision; json_get_var action action; json_get_var confirm confirmation
    [ "$token" = "$(revision)" ] || fail stale_configuration
    case "$action:$confirm" in disconnect:DISCONNECT_ETHERNET_PPPOE|reconnect:RECONNECT_ETHERNET_PPPOE) ;; *) fail confirmation_required;; esac
    snapshot=$(ubus -t 3 call network.interface.wan status '{}') || fail wan_state_unavailable
    [ "$(printf '%s' "$snapshot" | jsonfilter -e '@.proto')" = pppoe ] || fail pending_activation
    live_dev=$(printf '%s' "$snapshot" | jsonfilter -e '@.device' || :)
    [ "$live_dev" = "$dev" ] || fail ethernet_wan_unverified
    # Scope netifd to Ethernet WAN only. No network reload, LTE restart or modem action.
    ubus -t 5 call network.interface.wan down '{}' >/dev/null || fail disconnect_failed
    if [ "$action" = reconnect ]; then
      ubus -t 5 call network.interface.wan up '{}' >/dev/null || fail reconnect_failed
    fi
    json_init; json_add_boolean ok 1; json_add_boolean requested 1
    json_add_string state pending_verification; json_add_boolean internet_verified 0
    json_dump; exit 0;;
esac
mode=$(get wan.proto)
case "$mode" in dhcp|static|pppoe) ;; *) fail unsupported_wan_protocol ;; esac
pending=$(uci -q changes network) || fail config_unavailable
[ -z "$pending" ] || fail pending_network_changes
lan=$(get lan.ipaddr); lan_mask=$(get lan.netmask)
wan=$(get wan.ipaddr); wan_mask=$(get wan.netmask); gateway=$(get wan.gateway)
# Never replace a list of existing addresses or an ambiguous CIDR/netmask pair.
for section in lan wan; do
  address=$(get "$section.ipaddr"); mask=$(get "$section.netmask")
  case "$address" in *[[:space:]]*) fail multiple_addresses ;; */*)
    [ -z "$mask" ] || fail ambiguous_mask
    if [ "$section" = lan ]; then lan=${address%/*}; lan_mask=${address##*/}; else wan=${address%/*}; wan_mask=${address##*/}; fi ;;
  esac
done
current=$(revision) || fail config_unavailable
if [ "$2" = save ]; then
  # Explicit Ethernet protocol retirement; ordinary saves cannot remove PPPoE.
  old_mode="$mode"
  old_lan="$lan"; old_lan_mask="$lan_mask"
  input=$(head -c 1025)
  [ "${#input}" -le 1024 ] && json_load "$input" || fail invalid_request
  json_get_var token revision ''; json_get_var confirm confirm ''
  [ "$token" = "$current" ] || fail stale_configuration
  case "$confirm" in SAVE_NETWORK|REPLACE_PPPOE_NEXT_BOOT) ;; *) fail confirmation_required;; esac
  json_get_var lan lan ''; json_get_var lan_mask lan_mask ''; json_get_var mode wan_mode ''
  json_get_var wan wan ''; json_get_var wan_mask wan_mask ''; json_get_var gateway gateway ''
  retire_pppoe=0
  case "$old_mode:$mode" in
    pppoe:dhcp|pppoe:static)
      [ "$confirm" = REPLACE_PPPOE_NEXT_BOOT ] || fail explicit_pppoe_replacement_required
      pppoe_device >/dev/null || fail ethernet_wan_unverified
      retire_pppoe=1 ;;
    pppoe:pppoe|dhcp:dhcp|dhcp:static|static:dhcp|static:static)
      [ "$confirm" = SAVE_NETWORK ] || fail confirmation_required ;;
    *) fail use_dedicated_pppoe_configuration ;;
  esac
  case "$mode" in dhcp|pppoe) wan=; wan_mask=; gateway= ;; static) ;; *) fail invalid_wan_mode ;; esac
  # Convert each mask to prefix length and validate usable, disjoint subnets.
  for arg in "$lan" "$lan_mask" "$wan" "$wan_mask" "$gateway"; do
    case "$arg" in *[!0-9.]*) fail invalid_address ;; esac
  done
  masks=$(awk -v lan="$lan" -v lm="$lan_mask" -v mode="$mode" -v wan="$wan" -v wm="$wan_mask" -v gw="$gateway" '
    function ip(s, a,i,n,v) {
      n=split(s,a,"[.]"); if(n!=4)return -1
      for(i=1;i<=4;i++){if(a[i]!~/^(0|[1-9][0-9]?[0-9]?)$/ || a[i]+0>255)return -1; v=v*256+a[i]}
      return v
    }
    function block(p, i,n){n=1;for(i=p;i<32;i++)n*=2;return n}
    function prefix(s, v,p){if(s~/^([1-9]|[12][0-9]|30)$/)return s+0
      v=ip(s); for(p=1;p<=30;p++)if(v==4294967296-block(p))return p;return -1}
    function host(v,size, first){first=int(v/16777216);return v>=0 && first>0 && first!=127 && first<224 && v%size!=0 && v%size!=size-1}
    BEGIN {a=ip(lan);p=prefix(lm);s=block(p);if(p<1 || !host(a,s))exit 1
      if(mode=="static"){b=ip(wan);q=prefix(wm);t=block(q);g=ip(gw)
        if(q<1 || !host(b,t) || !host(g,t) || b==g || int(b/t)!=int(g/t))exit 1
        z=s>t?s:t;if(int(a/z)==int(b/z))exit 1}
      print p,q+0
    }') || fail invalid_subnet_or_gateway
  set -- $masks
  # Preserve existing DHCP reservations; refuse incompatible subnet changes.
  # Lock DHCP only after the network lock, nonblocking to avoid lock inversion.
  dhcp_cfg=/etc/config/dhcp
  [ -f "$dhcp_cfg" ] && [ ! -L "$dhcp_cfg" ] || fail dhcp_config_unavailable
  exec 8>>/var/lock/veci2-dhcp.lock
  flock -n 8 || fail dhcp_busy
  dhcp_pending=$(uci -q changes dhcp) || fail dhcp_config_unavailable
  [ -z "$dhcp_pending" ] || fail pending_dhcp_changes
  dhcp_digest=$(sha256sum "$dhcp_cfg") || fail dhcp_config_unavailable
  if [ "$old_lan:$old_lan_mask" != "$lan:$lan_mask" ]; then
    [ "$(uci -q get dhcp.lan || :)" = dhcp ] &&
    [ "$(uci -q get dhcp.lan.interface || :)" = lan ] || fail unsupported_dhcp_layout
    pool_start=$(uci -q get dhcp.lan.start || :)
    pool_limit=$(uci -q get dhcp.lan.limit || :)
    pool_ignore=$(uci -q get dhcp.lan.ignore || :)
    case "$pool_ignore" in ''|0|1) ;; *) fail unsupported_dhcp_layout;; esac
    # Validate even a disabled pool so subsequent enable cannot use invalid bounds.
    awk -v ip="$lan" -v p="$1" -v a="$pool_start" -v n="$pool_limit" '
      BEGIN {
        if(a !~ /^[1-9][0-9]*$/ || n !~ /^[1-9][0-9]*$/ || length(a)>5 || length(n)>5)exit 1
        size=1;for(i=p;i<32;i++)size*=2;split(ip,x,".");router=((x[1]*256+x[2])*256+x[3])*256+x[4]
        off=router%size;end=a+n-1
        if(end>size-2 || (off>=a && off<=end))exit 1
      }' || fail dhcp_pool_conflicts_with_lan
    inventory=$(uci -q show dhcp) || fail dhcp_config_unavailable
    hosts=$(printf '%s\n' "$inventory" | awk -F= 'BEGIN{q=sprintf("%c",39)} $2=="host" || $2==q "host" q {print $1}')
    count=0
    for host in $hosts; do
      count=$((count+1)); [ "$count" -le 256 ] || fail reservation_limit
      ip=$(uci -q get "$host.ip" || :)
      [ -n "$ip" ] || fail unsupported_reservation
      awk -v router="$lan" -v p="$1" -v address="$ip" '
        function num(s,a,n,i,v){n=split(s,a,".");if(n!=4)return -1;for(i=1;i<=4;i++){if(a[i]!~/^(0|[1-9][0-9]?[0-9]?)$/||a[i]>255)return -1;v=v*256+a[i]}return v}
        BEGIN{r=num(router);v=num(address);size=1;for(i=p;i<32;i++)size*=2
          if(v<0 || v==r || int(r/size)!=int(v/size) || v%size==0 || v%size==size-1)exit 1}' || fail reservation_conflicts_with_lan
    done
  fi
  # Native Guest profile is intentionally supported only with standard LAN.
  if [ "$(get veci_guest)" = interface ]; then
    [ "$lan:$1" = 192.168.1.1:24 ] || fail guest_requires_standard_lan
    if [ "$mode" = static ]; then
      awk -v ip="$wan" -v p="$2" '
        BEGIN{split(ip,a,".");v=((a[1]*256+a[2])*256+a[3])*256+a[4];s=1;for(i=p;i<32;i++)s*=2;base=int(v/s)*s;g=10*16777216+20*65536;if(base<=g+255 && base+s-1>=g)exit 1}' || fail wan_overlaps_guest
    fi
  fi
  tmp=$(mktemp -d /tmp/veci2-interfaces.XXXXXX) || fail stage_failed
  trap 'rm -rf "$tmp"' EXIT
  cp -p "$cfg" "$tmp/network.original" || fail backup_failed
  change() { uci -q -t "$tmp" "$@"; }
  remove() { if change get "$1" >/dev/null; then change delete "$1"; fi; }
  change set "network.lan.ipaddr=$lan/$1" && remove network.lan.netmask &&
    change set "network.wan.proto=$mode" || fail stage_failed
  if [ "$retire_pppoe" = 1 ]; then
    for option in username password service ac; do remove "network.wan.$option" || fail stage_failed; done
  fi
  if [ "$mode" != pppoe ]; then
  remove network.wan.netmask || fail stage_failed
  if [ "$mode" = dhcp ]; then
    remove network.wan.ipaddr && remove network.wan.gateway || fail stage_failed
  else
    change set "network.wan.ipaddr=$wan/$2" && change set "network.wan.gateway=$gateway" || fail stage_failed
  fi
  fi
  pending=$(uci -q changes network) || fail config_unavailable
  [ "$(revision)" = "$current" ] && [ -z "$pending" ] || fail stale_configuration
  dhcp_pending=$(uci -q changes dhcp) || fail dhcp_config_unavailable
  [ -z "$dhcp_pending" ] && [ "$(sha256sum "$dhcp_cfg")" = "$dhcp_digest" ] || fail stale_dhcp_configuration
  if ! change commit network || [ "$(get wan.proto)" != "$mode" ] || [ "$(get lan.ipaddr)" != "$lan/$1" ]; then
    cp -p "$tmp/network.original" "$cfg" || fail rollback_failed
    fail commit_failed_rollback
  fi
  current=$(revision) || fail config_unavailable; lan_mask=$1; [ "$mode" != static ] || wan_mask=$2
fi
json_init
json_add_boolean ok 1
json_add_string revision "$current"
json_add_string lan "$lan"
json_add_string lan_mask "$lan_mask"
json_add_string wan_mode "$mode"
json_add_string wan "$wan"
json_add_string wan_mask "$wan_mask"
json_add_string gateway "$gateway"
json_dump
