#!/bin/sh
# Isolated addon configuration endpoint; reuses original VeCI source helper.
set -eu
umask 077
fail() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 0; }
case "$1" in
  list) echo '{"status":{},"setVpnStartup":{"action":"String","expected":"String"}}'; exit 0 ;;
  call) case "$2" in status|setVpnStartup) ;; *) fail unsupported_method ;; esac ;;
  *) fail unsupported_method ;;
esac
[ "$(cat /tmp/sysinfo/board_name)" = zbtlink,zbt-we5927 ] || fail unsupported_board
. /usr/share/libubox/jshn.sh
. /usr/libexec/veci2-addon-profiles
if [ "$2" = status ]; then profile_status; else set_vpn_startup; fi
