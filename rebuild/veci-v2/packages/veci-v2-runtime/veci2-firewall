#!/bin/sh
# Exact-board owner-controlled WAN -> LAN forwarding.
# Never modify default WAN input policy or expose router admin itself.
set -eu
umask 077
fail() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 0; }
valid_ipv4() {
  case "$1" in ''|*[!0-9.]*|.*|*..*|*.) return 1 ;; esac
  old=$IFS; IFS=.; set -- $1; IFS=$old
  [ "$#" -eq 4 ] || return 1
  for x in "$@"; do
    case "$x" in 0|[1-9]|[1-9][0-9]|[1-9][0-9][0-9]) ;; *) return 1 ;; esac
    [ "$x" -le 255 ] || return 1
  done
  [ "$1" -gt 0 ] && [ "$1" -ne 127 ] && [ "$1" -lt 224 ]
}
valid_port() {
  case "$1" in ''|*[!0-9]*|0*) return 1 ;; esac
  [ "$(printf %s "$1" | wc -c)" -le 5 ] || return 1
  [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}
lan_host() {
  valid_ipv4 "$1" || return 1
  [ "$1" != "$(uci -q get network.lan.ipaddr)" ] || return 1
  ipcalc.sh "$(uci -q get network.lan.ipaddr)" "$(uci -q get network.lan.netmask)" 2>/dev/null |
    grep -Eq '^NETWORK=' || return 1
  # Firewall must not be changed for an unconfigured or unknown LAN subnet.
  ip route get "$1" 2>/dev/null | grep -Eq 'dev (br-lan|lan|eth0)' || return 1
}
[ "$#" -ge 1 ] || fail unsupported_method
case "$1" in
  list) echo '{"status":{},"addForward":{"from_port":"Integer","to_port":"Integer","protocol":"String","destination":"String","confirmation":"String"},"deleteForward":{"name":"String","confirmation":"String"},"setDmz":{"destination":"String","confirmation":"String"},"setDefaults":{"drop_invalid":"String","syn_flood":"String","revision":"String","confirmation":"String"},"setOffload":{"enabled":"String","revision":"String","confirmation":"String"},"setMacBlock":{"addresses":"String","revision":"String","confirmation":"String"},"parentStatus":{},"saveParent":{"slot":"String","mac":"String","enabled":"String","action":"String","start_time":"String","stop_time":"String","weekdays":"String","revision":"String","confirmation":"String"},"aclStatus":{},"saveAcl":{"slot":"String","mac":"String","enabled":"String","action":"String","revision":"String","confirmation":"String"},"ttlStatus":{},"setTtl":{"enabled":"String","ttl":"String","revision":"String","confirmation":"String"}}'; exit 0 ;;
  call) [ "$#" -ge 2 ] || fail unsupported_method
    case "$2" in status|addForward|deleteForward|setDmz|setDefaults|setOffload|setMacBlock|parentStatus|saveParent|aclStatus|saveAcl|ttlStatus|setTtl) ;; *) fail unsupported_method ;; esac ;;
  *) fail unsupported_method ;;
esac
[ "$(cat /tmp/sysinfo/board_name)" = zbtlink,zbt-we5927 ] || fail unsupported_board
[ "$(uci -q get firewall.@zone[0].name)" = lan ] || fail lan_zone_mismatch
[ "$(uci -q get firewall.@zone[1].name)" = wan ] || fail wan_zone_mismatch
[ "$(uci -q get firewall.@zone[1].input)" = REJECT ] || fail unsafe_wan_policy
mac_rule_owned() {
  [ "$(uci -q get firewall.veci_owner_mac_block || :)" = rule ] &&
  [ "$(uci -q get firewall.veci_owner_mac_block.name || :)" = VeCI_MAC_Block ] &&
  [ "$(uci -q get firewall.veci_owner_mac_block.src || :)" = lan ] &&
  [ "$(uci -q get firewall.veci_owner_mac_block.dest || :)" = wan ] &&
  [ "$(uci -q get firewall.veci_owner_mac_block.target || :)" = REJECT ]
}
status() {
  # libubox jshn internally unsets JSON namespace variables during init.
  # Read-only JSON serialization must not abort when nounset is active.
  set +u
  . /usr/share/libubox/jshn.sh
  json_init; json_add_boolean ok 1
  digest=$(sha256sum /etc/config/firewall) || fail config_unavailable
  json_add_string revision "${digest%% *}"
  json_add_string wan_input "$(uci -q get firewall.@zone[1].input)"
  json_add_string wan_forward "$(uci -q get firewall.@zone[1].forward)"
  json_add_array forwards
  i=0
  while [ "$i" -lt 128 ] && [ "$(uci -q get "firewall.@redirect[$i]" || :)" = redirect ]; do
    json_add_object ""
    json_add_int index "$i"
    json_add_string name "$(uci -q get "firewall.@redirect[$i].name" || :)"
    json_add_string source_port "$(uci -q get "firewall.@redirect[$i].src_dport" || :)"
    json_add_string destination "$(uci -q get "firewall.@redirect[$i].dest_ip" || :)"
    json_add_string destination_port "$(uci -q get "firewall.@redirect[$i].dest_port" || :)"
    json_add_string protocol "$(uci -q get "firewall.@redirect[$i].proto" || :)"
    json_close_object
    i=$((i+1))
  done
  named=$(uci -q show firewall | grep -E '^firewall[.]veci_port_(tcp|udp)_[0-9]+=redirect$' | cut -d= -f1 | cut -d. -f2 || :)
  for owner in $named; do
    json_add_object ""
    json_add_string name "$owner"
    json_add_string source_port "$(uci -q get "firewall.$owner.src_dport" || :)"
    json_add_string destination "$(uci -q get "firewall.$owner.dest_ip" || :)"
    json_add_string destination_port "$(uci -q get "firewall.$owner.dest_port" || :)"
    json_add_string protocol "$(uci -q get "firewall.$owner.proto" || :)"
    json_close_object
  done
  json_close_array
  json_add_array blocked_macs
  if mac_rule_owned; then
    for mac in $(uci -q get firewall.veci_owner_mac_block.src_mac || :); do
      printf '%s\n' "$mac" | grep -Eiq '^[0-9a-f]{2}(:[0-9a-f]{2}){5}$' || fail invalid_mac_rule
      json_add_string "" "$mac"
    done
  fi
  json_close_array
  json_add_string dmz_destination "$(uci -q get firewall.veci_owner_dmz.dest_ip || :)"
  json_dump; echo
}
# Native firewall4 table include; no shell include, no carrier-specific rule.
ttl_file=/etc/nftables.d/90-veci-ttl.nft
ttl_render() {
  printf 'chain veci_ttl_forward {\n  type filter hook forward priority mangle; policy accept;\n  iifname "br-lan" oifname { "eth0.2", "pppoe-wan", "usb0" } ip ttl set %s counter comment "VeCI managed IPv4 TTL"\n}\n' "$1"
}
ttl_read() {
  ttl_enabled=0; ttl_value=""; ttl_digest=absent
  [ ! -L "$ttl_file" ] || fail unsafe_ttl_path
  if [ -e "$ttl_file" ]; then
    [ -f "$ttl_file" ] || fail invalid_ttl_file
    ttl_value=$(sed -nE 's/.*ip ttl set ([0-9]+) counter comment "VeCI managed IPv4 TTL"$/\1/p' "$ttl_file")
    case "$ttl_value" in [1-9]|[1-9][0-9]|[1-9][0-9][0-9]) ;; *) fail invalid_ttl_file;; esac
    [ "$ttl_value" -le 255 ] || fail invalid_ttl_file
    ttl_digest=$(sha256sum "$ttl_file") || fail config_unavailable
    ttl_digest=${ttl_digest%% *}
    expected_digest=$(ttl_render "$ttl_value" | sha256sum)
    [ "$ttl_digest" = "${expected_digest%% *}" ] || fail foreign_ttl_file
    ttl_enabled=1
  fi
  fw_digest=$(sha256sum /etc/config/firewall) || fail config_unavailable
  ttl_revision=$(printf '%s:%s' "${fw_digest%% *}" "$ttl_digest" | sha256sum)
  ttl_revision=${ttl_revision%% *}
}
ttl_status() {
  ttl_read
  live=unknown
  if command -v nft >/dev/null 2>&1; then
    if chain=$(nft list chain inet fw4 veci_ttl_forward 2>/dev/null); then
      if [ "$ttl_enabled" = 1 ] && printf '%s\n' "$chain" | grep -Fq "ip ttl set $ttl_value counter"; then live=rule_present; else live=unexpected_rule; fi
    elif nft list table inet fw4 >/dev/null 2>&1; then live=rule_absent; fi
  fi
  set +u
  . /usr/share/libubox/jshn.sh
  json_init; json_add_boolean ok 1
  json_add_string revision "$ttl_revision"; json_add_string enabled "$ttl_enabled"
  json_add_string ttl "$ttl_value"; json_add_string runtime "$live"
  json_add_string scope lan_to_wan_ipv4_forward
  json_add_boolean packet_verified 0
  json_dump
}
if [ "$2" = ttlStatus ] || [ "$2" = setTtl ]; then
  exec 9<"$0"; flock -n 9 || fail busy
  if [ "$2" = ttlStatus ]; then ttl_status; exit 0; fi
  request=$(head -c 513)
  [ "${#request}" -le 512 ] || fail request_too_large
  enabled=$(jsonfilter -s "$request" -e '@.enabled') || fail invalid_request
  confirm=$(jsonfilter -s "$request" -e '@.confirmation') || fail invalid_request
  revision=$(jsonfilter -s "$request" -e '@.revision') || fail invalid_request
  case "$enabled:$confirm" in 0:DISABLE_FORWARD_TTL|1:ENABLE_FORWARD_TTL) ;; *) fail confirmation_required;; esac
  ttl_read
  [ "$revision" = "$ttl_revision" ] || fail stale_configuration
  pending=$(uci -q changes firewall) || fail config_unavailable
  [ -z "$pending" ] || fail pending_firewall_changes
  [ -d /etc/nftables.d ] && [ ! -L /etc/nftables.d ] || fail unsafe_ttl_path
  if [ "$enabled" = 1 ]; then
    value=$(jsonfilter -s "$request" -e '@.ttl') || fail invalid_request
    case "$value" in [1-9]|[1-9][0-9]|[1-9][0-9][0-9]) ;; *) fail invalid_ttl;; esac
    [ "$value" -le 255 ] || fail invalid_ttl
    for option in flow_offloading flow_offloading_hw; do
      case "$(uci -q get "firewall.@defaults[0].$option" || :)" in ''|0) ;; *) fail offload_must_be_disabled;; esac
    done
  fi
  tmp=$(mktemp -d /tmp/veci2-ttl.XXXXXX) || fail tmp_failed
  staged=$(mktemp /etc/nftables.d/.veci-ttl.XXXXXX) || { rm -rf "$tmp"; fail tmp_failed; }
  trap 'rm -rf "$tmp"; rm -f "$staged"' EXIT
  if [ "$ttl_enabled" = 1 ]; then cp "$ttl_file" "$tmp/previous" || fail backup_failed; fi
  if [ "$enabled" = 1 ]; then ttl_render "$value" > "$staged" && mv "$staged" "$ttl_file" || fail stage_failed
  else rm -f "$ttl_file" || fail stage_failed; fi
  if ! fw4 check >/dev/null 2>&1 || ! /etc/init.d/firewall reload >/dev/null 2>&1 ||
     { [ "$enabled" = 1 ] && ! nft list chain inet fw4 veci_ttl_forward 2>/dev/null | grep -Fq "ip ttl set $value counter"; } ||
     { [ "$enabled" = 0 ] && nft list chain inet fw4 veci_ttl_forward >/dev/null 2>&1; }; then
    if [ -f "$tmp/previous" ]; then cp "$tmp/previous" "$staged" && mv "$staged" "$ttl_file" || fail rollback_failed
    else rm -f "$ttl_file" || fail rollback_failed; fi
    /etc/init.d/firewall reload >/dev/null 2>&1 || fail rollback_failed
    fail ttl_apply_failed_rollback_attempted
  fi
  ttl_status; exit 0
fi
# Eight owned LAN-to-WAN deny slots. Never edit foreign or WAN input rules.
acl_owned() {
  local n="$1"
  [ "$(uci -q get "firewall.$n" || :)" = rule ] &&
  [ "$(uci -q get "firewall.$n.name" || :)" = "VeCI_ACL_$n" ] &&
  [ "$(uci -q get "firewall.$n.src" || :)" = lan ] &&
  [ "$(uci -q get "firewall.$n.dest" || :)" = wan ] &&
  [ "$(uci -q get "firewall.$n.target" || :)" = REJECT ] &&
  [ "$(uci -q get "firewall.$n.proto" || :)" = all ] &&
  [ "$(uci -q get "firewall.$n.family" || :)" = any ]
}
acl_status() {
  set +u
  . /usr/share/libubox/jshn.sh
  digest=$(sha256sum /etc/config/firewall) || fail config_unavailable
  json_init; json_add_boolean ok 1
  json_add_string revision "${digest%% *}"
  json_add_array rules
  for slot in 1 2 3 4 5 6 7 8; do
    n="${prefix:-veci_acl}_$slot"
    [ -n "$(uci -q get "firewall.$n" || :)" ] || continue
    acl_owned "$n" || fail foreign_acl_slot
    mac=$(uci -q get "firewall.$n.src_mac" || :)
    printf '%s\n' "$mac" | grep -Eiq '^[0-9a-f][02468ace](:[0-9a-f]{2}){5}$' || fail invalid_acl_mac
    [ "$mac" != 00:00:00:00:00:00 ] || fail invalid_acl_mac
    flag=$(uci -q get "firewall.$n.enabled" || :)
    case "$flag" in 0|1) ;; *) fail invalid_acl_state;; esac
    json_add_object ""; json_add_string slot "$slot"; json_add_string mac "$mac"
    json_add_string enabled "$flag"
    if [ "${prefix:-veci_acl}" = veci_parent ]; then
      start=$(uci -q get "firewall.$n.start_time" || :)
      stop=$(uci -q get "firewall.$n.stop_time" || :)
      days=$(uci -q get "firewall.$n.weekdays" || :)
      [ "$(uci -q get "firewall.$n.utc_time" || :)" = 1 ] || fail invalid_schedule
      valid_schedule "$start" "$stop" "$days" || fail invalid_schedule
      json_add_string start_time "$start"; json_add_string stop_time "$stop"
      json_add_string weekdays "$days"; json_add_string timezone UTC
    fi
    json_close_object
  done
  json_close_array; json_add_boolean runtime_verified 0; json_dump
}
valid_schedule() {
  # Explicit UTC, one same-day block interval; overnight needs two slots.
  printf '%s\n' "$1" "$2" | awk -F: '
    NF!=3 || $1 !~ /^[0-9][0-9]$/ || $2 !~ /^[0-9][0-9]$/ || $3!="00" || $1>23 || $2>59 {bad=1}
    NR==1 {a=$1*60+$2} NR==2 {b=$1*60+$2}
    END {exit (bad || NR!=2 || a>=b)}' || return 1
  [ -n "$3" ] || return 1
  seen=" "
  for day in $3; do
    case "$day" in Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday) ;; *) return 1;; esac
    case "$seen" in *" $day "*) return 1;; esac
    seen="$seen$day "
  done
}
prefix=veci_acl
case "$2" in parentStatus|saveParent) prefix=veci_parent;; esac
if [ "$2" = aclStatus ] || [ "$2" = parentStatus ]; then exec 9<"$0"; flock -n 9 || fail busy; acl_status; exit 0; fi
if [ "$2" = status ]; then status; exit 0; fi
request=$(head -c 513)
[ "$(printf %s "$request" | wc -c)" -le 512 ] || fail request_too_large
exec 9<"$0"
flock -n 9 || fail busy
pending=$(uci -q changes firewall) || fail config_state_unknown
[ -z "$pending" ] || fail pending_firewall_changes
tmp=$(mktemp -d /tmp/veci2-firewall.XXXXXX) || fail tmp_failed
trap 'rm -rf "$tmp"' EXIT
trap 'exit 1' HUP INT TERM
cp /etc/config/firewall "$tmp/previous" || fail backup_failed
if [ "$2" = setDefaults ] || [ "$2" = setOffload ] || [ "$2" = setMacBlock ] || [ "$2" = saveAcl ] || [ "$2" = saveParent ]; then
  digest=$(sha256sum /etc/config/firewall) || fail config_unavailable
  expected=$(jsonfilter -s "$request" -e '@.revision') || fail invalid_request
  [ "$expected" = "${digest%% *}" ] || fail stale_configuration
  confirm=$(jsonfilter -s "$request" -e '@.confirmation') || fail invalid_request
  [ "$(uci -q get 'firewall.@defaults[0]')" = defaults ] || fail defaults_missing
  if [ "$2" = setDefaults ]; then
    [ "$confirm" = SAVE_FIREWALL_DEFAULTS ] || fail confirmation_required
    drop=$(jsonfilter -s "$request" -e '@.drop_invalid') || fail invalid_request
    syn=$(jsonfilter -s "$request" -e '@.syn_flood') || fail invalid_request
    case "$drop:$syn" in 0:0|0:1|1:0|1:1) ;; *) fail invalid_flag;; esac
    uci -q -t "$tmp" set "firewall.@defaults[0].drop_invalid=$drop" &&
    uci -q -t "$tmp" set "firewall.@defaults[0].synflood_protect=$syn" || fail stage_failed
  elif [ "$2" = saveAcl ] || [ "$2" = saveParent ]; then
    slot=$(jsonfilter -s "$request" -e '@.slot') || fail invalid_request
    action=$(jsonfilter -s "$request" -e '@.action') || fail invalid_request
    case "$slot" in [1-8]) ;; *) fail invalid_slot;; esac
    n="${prefix}_$slot"
    existing=$(uci -q get "firewall.$n" || :)
    [ -z "$existing" ] || acl_owned "$n" || fail foreign_acl_slot
    if [ "$2" = saveParent ]; then
      case "$action:$confirm" in save:SAVE_PARENT_SCHEDULE|delete:DELETE_PARENT_SCHEDULE) ;; *) fail confirmation_required;; esac
    else
      case "$action:$confirm" in save:SAVE_LAN_ACL|delete:DELETE_LAN_ACL) ;; *) fail confirmation_required;; esac
    fi
    if [ "$action" = delete ]; then
      [ -n "$existing" ] || fail unknown_acl_slot
      uci -q -t "$tmp" delete "firewall.$n" || fail stage_failed
    else
      mac=$(jsonfilter -s "$request" -e '@.mac') || fail invalid_request
      enabled=$(jsonfilter -s "$request" -e '@.enabled') || fail invalid_request
      printf '%s\n' "$mac" | grep -Eiq '^[0-9a-f][02468ace](:[0-9a-f]{2}){5}$' || fail invalid_mac
      mac=$(printf '%s' "$mac" | tr A-F a-f)
      [ "$mac" != 00:00:00:00:00:00 ] || fail invalid_mac
      case "$enabled" in 0|1) ;; *) fail invalid_flag;; esac
      if [ "$2" = saveParent ]; then
        start=$(jsonfilter -s "$request" -e '@.start_time') || fail invalid_request
        stop=$(jsonfilter -s "$request" -e '@.stop_time') || fail invalid_request
        days=$(jsonfilter -s "$request" -e '@.weekdays') || fail invalid_request
        case "$days" in *[!a-zA-Z\ ]*) fail invalid_schedule;; esac
        valid_schedule "$start" "$stop" "$days" || fail invalid_schedule
      fi
      if [ -n "$existing" ]; then uci -q -t "$tmp" delete "firewall.$n" || fail stage_failed; fi
      uci -q -t "$tmp" set "firewall.$n=rule" || fail stage_failed
      for pair in "name=VeCI_ACL_$n" src=lan dest=wan proto=all family=any target=REJECT "src_mac=$mac" "enabled=$enabled"; do
        uci -q -t "$tmp" set "firewall.$n.$pair" || fail stage_failed
      done
      if [ "$2" = saveParent ]; then
        for pair in "start_time=$start" "stop_time=$stop" "weekdays=$days" utc_time=1; do
          uci -q -t "$tmp" set "firewall.$n.$pair" || fail stage_failed
        done
      fi
      if [ "$enabled" = 1 ]; then
        uci -q -t "$tmp" set 'firewall.@defaults[0].flow_offloading=0' &&
        uci -q -t "$tmp" set 'firewall.@defaults[0].flow_offloading_hw=0' || fail stage_failed
      fi
    fi
  elif [ "$2" = setMacBlock ]; then
    [ "$confirm" = SAVE_MAC_BLOCK ] || fail confirmation_required
    list=$(jsonfilter -s "$request" -e '@.addresses') || fail invalid_request
    case "$list" in *[!0-9a-fA-F:\ ]*) fail invalid_mac_list;; esac
    existing=$(uci -q get firewall.veci_owner_mac_block || :)
    [ -z "$existing" ] || mac_rule_owned || fail not_owner_rule
    seen=" "; count=0
    for mac in $list; do
      printf '%s\n' "$mac" | grep -Eiq '^[0-9a-f][02468ace](:[0-9a-f]{2}){5}$' || fail invalid_mac
      mac=$(printf '%s' "$mac" | tr A-F a-f)
      [ "$mac" != 00:00:00:00:00:00 ] || fail invalid_mac
      case "$seen" in *" $mac "*) continue;; esac
      count=$((count+1)); [ "$count" -le 16 ] || fail too_many_macs
      seen="$seen$mac "
    done
    if [ -n "$existing" ]; then uci -q -t "$tmp" delete firewall.veci_owner_mac_block || fail stage_failed; fi
    if [ "$count" -gt 0 ]; then
      # Native firewall4 rule only. Restrict forwarded LAN-to-WAN traffic,
      # not access to the router itself. No iptables or custom executable.
      for pair in rule name=VeCI_MAC_Block src=lan dest=wan proto=all family=any target=REJECT; do
        case "$pair" in rule) uci -q -t "$tmp" set firewall.veci_owner_mac_block=rule || fail stage_failed;;
          *) uci -q -t "$tmp" set "firewall.veci_owner_mac_block.$pair" || fail stage_failed;; esac
      done
      for mac in $seen; do uci -q -t "$tmp" add_list "firewall.veci_owner_mac_block.src_mac=$mac" || fail stage_failed; done
      # Prevent a newly configured MAC deny rule from being bypassed by
      # software/hardware flow offload. Explicitly disclose this policy.
      uci -q -t "$tmp" set 'firewall.@defaults[0].flow_offloading=0' &&
      uci -q -t "$tmp" set 'firewall.@defaults[0].flow_offloading_hw=0' || fail stage_failed
    fi
  else
    [ "$confirm" = SAVE_SOFTWARE_OFFLOAD ] || fail confirmation_required
    enabled=$(jsonfilter -s "$request" -e '@.enabled') || fail invalid_request
    case "$enabled" in 0|1) ;; *) fail invalid_flag;; esac
    if [ "$enabled" = 1 ] && mac_rule_owned; then fail mac_block_requires_offload_disabled; fi
    if [ "$enabled" = 1 ] && [ "$(uci -q get sqm.veci.enabled || :)" = 1 ]; then fail sqm_requires_offload_disabled; fi
    if [ "$enabled" = 1 ] && { [ -e "$ttl_file" ] || [ -L "$ttl_file" ]; }; then fail ttl_requires_offload_disabled; fi
    if [ "$enabled" = 1 ]; then
      for slot in 1 2 3 4 5 6 7 8; do
        for group in veci_acl veci_parent; do
        n="${group}_$slot"
        if [ -n "$(uci -q get "firewall.$n" || :)" ]; then
          acl_owned "$n" || fail foreign_acl_slot
          [ "$(uci -q get "firewall.$n.enabled" || :)" = 0 ] || fail acl_requires_offload_disabled
        fi
        done
      done
    fi
    # Software offload only. Do not enable an unverified hardware path.
    uci -q -t "$tmp" set "firewall.@defaults[0].flow_offloading=$enabled" &&
    uci -q -t "$tmp" set "firewall.@defaults[0].flow_offloading_hw=0" || fail stage_failed
  fi
  pending=$(uci -q changes firewall) || fail config_state_unknown
  [ -z "$pending" ] && [ "$(sha256sum /etc/config/firewall)" = "$digest" ] || fail stale_configuration
elif [ "$2" = addForward ]; then
  from=$(jsonfilter -s "$request" -e '@.from_port') || fail invalid_request
  to=$(jsonfilter -s "$request" -e '@.to_port') || fail invalid_request
  proto=$(jsonfilter -s "$request" -e '@.protocol') || fail invalid_request
  dest=$(jsonfilter -s "$request" -e '@.destination') || fail invalid_request
  confirm=$(jsonfilter -s "$request" -e '@.confirmation') || fail invalid_request
  valid_port "$from" && valid_port "$to" || fail invalid_port
  case "$proto" in tcp|udp) ;; *) fail invalid_protocol ;; esac
  lan_host "$dest" || fail invalid_lan_destination
  [ "$confirm" = "FORWARD_$from" ] || fail confirmation_required
  case "$from" in 22|23) fail refuse_router_management_port ;; esac
  name=$(printf "veci_port_%s_%s" "$proto" "$from")
  [ -z "$(uci -q get "firewall.$name" || :)" ] || fail port_forward_already_exists
  uci -q -t "$tmp" set "firewall.$name=redirect" || fail stage_failed
  uci -q -t "$tmp" set "firewall.$name.name=VeCI_$proto-$from" || fail stage_failed
  uci -q -t "$tmp" set "firewall.$name.src=wan" || fail stage_failed
  uci -q -t "$tmp" set "firewall.$name.dest=lan" || fail stage_failed
  uci -q -t "$tmp" set "firewall.$name.proto=$proto" || fail stage_failed
  uci -q -t "$tmp" set "firewall.$name.src_dport=$from" || fail stage_failed
  uci -q -t "$tmp" set "firewall.$name.dest_ip=$dest" || fail stage_failed
  uci -q -t "$tmp" set "firewall.$name.dest_port=$to" || fail stage_failed
  uci -q -t "$tmp" set "firewall.$name.target=DNAT" || fail stage_failed
elif [ "$2" = deleteForward ]; then
  name=$(jsonfilter -s "$request" -e '@.name') || fail invalid_request
  confirm=$(jsonfilter -s "$request" -e '@.confirmation') || fail invalid_request
  case "$name" in veci_port_tcp_*|veci_port_udp_*) ;; *) fail not_owner_redirect ;; esac
  case "$name" in *[!A-Za-z0-9_]*) fail invalid_name ;; esac
  [ "$confirm" = "DELETE_$name" ] || fail confirmation_required
  [ "$(uci -q get "firewall.$name" || :)" = redirect ] || fail unknown_forward
  uci -q -t "$tmp" delete "firewall.$name" || fail stage_failed
else
  dest=$(jsonfilter -s "$request" -e '@.destination') || fail invalid_request
  confirm=$(jsonfilter -s "$request" -e '@.confirmation') || fail invalid_request
  if [ "$dest" = DISABLE ]; then
    [ "$confirm" = DISABLE_DMZ ] || fail confirmation_required
    [ "$(uci -q get firewall.veci_owner_dmz || :)" = redirect ] || fail no_owner_dmz
    uci -q -t "$tmp" delete firewall.veci_owner_dmz || fail stage_failed
  else
    lan_host "$dest" || fail invalid_lan_destination
    [ "$confirm" = "ENABLE_DMZ_$dest" ] || fail confirmation_required
    [ -z "$(uci -q get firewall.veci_owner_dmz || :)" ] || fail dmz_already_exists
    uci -q -t "$tmp" set firewall.veci_owner_dmz=redirect || fail stage_failed
    uci -q -t "$tmp" set firewall.veci_owner_dmz.name=VeCI_DMZ || fail stage_failed
    uci -q -t "$tmp" set firewall.veci_owner_dmz.src=wan || fail stage_failed
    uci -q -t "$tmp" set firewall.veci_owner_dmz.dest=lan || fail stage_failed
    uci -q -t "$tmp" set "firewall.veci_owner_dmz.dest_ip=$dest" || fail stage_failed
    uci -q -t "$tmp" set firewall.veci_owner_dmz.target=DNAT || fail stage_failed
  fi
fi
if ! uci -q -t "$tmp" commit firewall || ! fw4 check >/dev/null 2>&1 || ! /etc/init.d/firewall reload >/dev/null 2>&1; then
  cp "$tmp/previous" /etc/config/firewall || fail rollback_failed
  /etc/init.d/firewall reload >/dev/null 2>&1 || fail rollback_failed
  fail firewall_apply_failed_rollback_attempted
fi
if [ "$2" = saveAcl ] || [ "$2" = saveParent ]; then acl_status; else status; fi
