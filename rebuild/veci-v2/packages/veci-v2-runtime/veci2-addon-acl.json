{
  "veci-v2-addon-admin": {
    "description": "Read addon profiles and opt-in WireGuard startup only",
    "read": {
      "ubus": {
        "veci.v2.addon": [
          "status",
          "ddnsStatus",
          "sqmStatus",
          "ddnsLookup",
          "openvpnStatus",
          "legacyTunnelStatus"
        ]
      }
    },
    "write": {
      "ubus": {
        "veci.v2.addon": [
          "setVpnStartup",
          "setPortalStartup",
          "setOptionalStartup",
          "saveSqm",
          "setOpenvpnStartup",
          "disableLegacyTunnel"
        ]
      }
    }
  }
}
