#!/bin/sh
set -e
set -f
umask 077
fail() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 0; }
case "$1:${2:-}" in
 list:*) echo '{"status":{},"savePool":{"revision":"String","start":"String","limit":"String","time":"String"},"saveLease":{"revision":"String","section":"String","mac":"String","ip":"String","name":"String"},"deleteLease":{"revision":"String","section":"String"},"changeDns":{"revision":"String","op":"String","server":"String"},"apply":{"revision":"String","confirm":"String"}}'; exit ;;
 call:status|call:savePool|call:saveLease|call:deleteLease|call:changeDns|call:apply) ;;
 *) fail invalid_method ;;
esac
[ "$(cat /tmp/sysinfo/board_name)" = zbtlink,zbt-we5927 ] || fail wrong_board
. /usr/share/libubox/jshn.sh
get() { uci -q get "dhcp.$1" 2>/dev/null || :; }
sections() { printf '%s\n' "$config" | sed -n 's/^dhcp\.\([^.=]*\)=host$/\1/p'; }
has_section() { sections | grep -Fqx -- "$1"; }
ipv4() {
 case "$1" in ''|*[!0-9.]*) return 1 ;; esac
 printf '%s\n' "$1" | awk -F. 'NF!=4 || $1==0 || $1==127 || $1>=224 {exit 1}
 {for(i=1;i<=4;i++) if($i !~ /^(0|[1-9][0-9]?[0-9]?)$/ || $i>255) exit 1}'
}
# Number of usable addresses in a contiguous IPv4 LAN prefix (ipaddr may contain CIDR).
lan_bounds() {
 addr=$(uci -q get network.lan.ipaddr) || return 1
 case "$addr" in */*) prefix=${addr##*/}; addr=${addr%/*};; *) prefix=;; esac
 ipv4 "$addr" || return 1
 mask=$(uci -q get network.lan.netmask || :)
 awk -v ip="$addr" -v candidate="${1:-}" -v p="$prefix" -v m="${mask:-255.255.255.0}" 'BEGIN {
   if (p!="") {if(p !~ /^[0-9]+$/ || p>30) exit 1}
   else { if(split(m,a,".")!=4) exit 1; p=0; zero=0;
     for(i=1;i<=4;i++){if(a[i] !~ /^[0-9]+$/ || a[i]>255)exit 1;
       for(b=128;b>=1;b/=2){if(int(a[i]/b)%2){if(zero)exit 1;p++}else zero=1}}}
   size=1; for(i=p;i<32;i++)size*=2; if(size<4) exit 1
   split(ip,a,"."); router=((a[1]*256+a[2])*256+a[3])*256+a[4]
   if(candidate!=""){
     split(candidate,a,"."); value=((a[1]*256+a[2])*256+a[3])*256+a[4]
     if(int(router/size)!=int(value/size) || value==router || value%size==0 || value%size==size-1) exit 1
   }
   printf "%.0f %.0f\n",size-2,router%size }'
}
exec 9>/var/lock/veci2-ipv6.lock
flock -n 9 || fail busy
pending=$(uci -q changes dhcp) || fail config_unavailable
[ -z "$pending" ] || fail pending_changes
pending=$(uci -q changes network) || fail config_unavailable
[ -z "$pending" ] || fail pending_network_changes
[ "$(get lan)" = dhcp ] && [ "$(get lan.interface)" = lan ] && [ "$(get '@dnsmasq[0]')" = dnsmasq ] || fail unsupported_config
revision=$(sha256sum /etc/config/dhcp) || fail config_unavailable
revision=${revision%% *}
config=$(uci -q show dhcp) || fail config_unavailable
if [ "$2" = status ]; then
 json_init
 json_add_boolean ok 1
 json_add_string revision "$revision"
 json_add_string start "$(get lan.start)"
 json_add_string limit "$(get lan.limit)"
 json_add_string time "$(get lan.leasetime)"
 json_add_array leases
 for s in $(sections); do
   json_add_object ''
   json_add_string section "$s"; json_add_string mac "$(get "$s.mac")"
   json_add_string ip "$(get "$s.ip")"; json_add_string name "$(get "$s.name")"
   json_close_object
 done
 json_close_array
 json_add_array servers
 for server in $(get '@dnsmasq[0].server'); do json_add_string '' "$server"; done
 json_close_array
 json_dump
 exit
fi
request=$(head -c 1025)
[ "${#request}" -le 1024 ] && json_load "$request" || fail invalid_request
json_get_var expected revision
[ "$expected" = "$revision" ] || fail stale_configuration
if [ "$2" = apply ]; then
 json_get_var confirm confirm
 [ "$confirm" = APPLY_DNSMASQ ] || fail confirmation_required
 /etc/init.d/dnsmasq reload 9<&- >/dev/null 2>&1 || fail reload_failed
 echo '{"ok":true}'; exit
fi
tmp=$(mktemp -d /tmp/veci2-dhcp.XXXXXX) || fail save_failed
trap 'rm -rf "$tmp"' EXIT
change() { uci -q -t "$tmp" "$@" || fail save_failed; }
case "$2" in
 savePool)
  json_get_vars start limit time
  for n in "$start" "$limit"; do
    case "$n" in ''|0*|*[!0-9]*) fail invalid_pool ;; esac
    [ "${#n}" -le 5 ] || fail invalid_pool
  done
  bounds=$(lan_bounds) || fail unsupported_lan
  capacity=${bounds% *}; router=${bounds#* }; end=$((start+limit-1))
  [ "$router" -lt "$start" ] || [ "$router" -gt "$end" ] || fail pool_contains_router
  [ "$end" -le "$capacity" ] || fail invalid_pool
  case "$time" in ''|*[!0-9mhdinfte]*) fail invalid_duration ;; infinite) ;; *) printf '%s\n' "$time" | grep -Eq '^[1-9][0-9]{0,5}[mhd]$' || fail invalid_duration ;; esac
  change set "dhcp.lan.start=$start"; change set "dhcp.lan.limit=$limit"; change set "dhcp.lan.leasetime=$time" ;;
 saveLease|deleteLease)
  json_get_var section section
  case "$section" in *[!a-zA-Z0-9_@\[\]-]*) fail unknown_lease ;; esac
  if [ -n "$section" ]; then has_section "$section" || fail unknown_lease; fi
  if [ "$2" = deleteLease ]; then
    [ -n "$section" ] || fail unknown_lease
    change delete "dhcp.$section"
  else
    json_get_vars name ip mac
    case "$name" in '' ) ;; -*|*-|*[!a-zA-Z0-9-]*) fail invalid_name ;; esac
    [ "${#name}" -le 63 ] || fail invalid_name
    ipv4 "$ip" && lan_bounds "$ip" >/dev/null || fail invalid_ip
    case "$mac" in *[!0-9a-fA-F:]*) fail invalid_mac ;; esac
    mac=$(printf '%s' "$mac" | tr A-F a-f)
    [ "$mac" != 00:00:00:00:00:00 ] && printf '%s\n' "$mac" | grep -Eq '^[0-9a-f][02468ace](:[0-9a-f]{2}){5}$' || fail invalid_mac
    for s in $(sections); do
      [ "$s" != "$section" ] || continue
      [ "$(get "$s.ip")" != "$ip" ] || fail duplicate_ip
      for existing in $(get "$s.mac" | tr A-F a-f); do [ "$existing" != "$mac" ] || fail duplicate_mac; done
    done
    if [ -z "$section" ]; then section=$(uci -q -t "$tmp" add dhcp host) || fail save_failed; fi
    change set "dhcp.$section.mac=$mac"; change set "dhcp.$section.ip=$ip"
    if [ -n "$name" ]; then change set "dhcp.$section.name=$name"; elif [ -n "$(get "$section.name")" ]; then change delete "dhcp.$section.name"; fi
  fi ;;
 changeDns)
  json_get_vars op server
  ipv4 "$server" || fail invalid_dns
  present=false
  for existing in $(get '@dnsmasq[0].server'); do [ "$existing" != "$server" ] || present=true; done
  case "$op:$present" in
   add:false) change add_list "dhcp.@dnsmasq[0].server=$server" ;;
   remove:true) change del_list "dhcp.@dnsmasq[0].server=$server" ;;
   add:true|remove:false) echo '{"ok":true}'; exit ;; *) fail invalid_action ;;
  esac ;;
esac
change commit dhcp
echo '{"ok":true}'
