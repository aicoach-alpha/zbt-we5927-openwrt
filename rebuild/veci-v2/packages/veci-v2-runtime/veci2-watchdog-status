#!/bin/sh
# Bounded, read-only exact-board kernel GPIO37 watchdog probe.
# Must NOT open /dev/watchdog, toggle GPIO, reset board or start new watchdog.
set -eu
fail() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 0; }
case "${1:-}:${2:-}" in
  list:*) echo '{"status":{}}'; exit 0 ;;
  call:status) ;;
  *) fail unsupported_method ;;
esac
[ "$(cat /tmp/sysinfo/board_name)" = zbtlink,zbt-we5927 ] || fail unsupported_board
result=$(timeout 3 /usr/libexec/veci2-gpio-watchdog 2>/dev/null) || fail watchdog_probe_unavailable
registration=$(printf '%s\n' "$result" | sed -n 's/^gpio37_watchdog=//p' | head -n 1)
case "$registration" in registered|unconfirmed|ambiguous) ;; *) fail invalid_watchdog_status ;; esac
state=unknown
case "$result" in *kernel_state=active*) state=active ;; *kernel_state=inactive*) state=inactive ;; esac
printf '{"ok":true,"registration":"%s","kernel_state":"%s","proof":"kernel_sysfs_read_only"}\n' "$registration" "$state"
