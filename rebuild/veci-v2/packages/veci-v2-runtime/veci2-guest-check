#!/bin/sh
# Read-only guest separation inventory. Never claim Wi-Fi/firewall runtime PASS.
set -eu
fail() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 0; }
case "${1:-}:${2:-}" in
  list:*) echo '{"status":{}}'; exit 0 ;;
  call:status) ;;
  *) fail unsupported_method ;;
esac
[ "$(cat /tmp/sysinfo/board_name)" = zbtlink,zbt-we5927 ] || fail unsupported_board
installed=false
configured=false
enabled=false
mode=not_installed
if [ -x /usr/libexec/rpcd/veci.app.guest ]; then
  installed=true
  mode=not_configured
  if [ "$(uci -q get wireless.veci_guest || :)" = wifi-iface ] &&
     [ "$(uci -q get network.veci_guest || :)" = interface ] &&
     [ "$(uci -q get dhcp.veci_guest || :)" = dhcp ] &&
     [ "$(uci -q get firewall.veci_guest_zone || :)" = zone ]; then
    configured=true
    mode=configuration_needs_audit
    if [ "$(uci -q get wireless.veci_guest.disabled || :)" = 0 ]; then
      enabled=true
    fi
    # The default firewall source must not accept or forward directly to LAN.
    if [ "$(uci -q get firewall.veci_guest_zone.input || :)" = REJECT ] &&
       [ "$(uci -q get firewall.veci_guest_zone.forward || :)" = REJECT ] &&
       [ "$(uci -q get wireless.veci_guest.network || :)" = veci_guest ] &&
       [ "$(uci -q get firewall.veci_guest_zone.network || :)" = veci_guest ]; then
      mode=configuration_separation_present
    fi
  fi
fi
# Observe radio state only. This endpoint never changes radio/network settings.
# A staged UCI enable does not prove the guest AP has actually been started.
ap_state=unavailable
if [ "$installed" = true ] && [ "$configured" = true ]; then
  ap_state=not_observed
  if command -v ubus >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1 &&
     command -v iw >/dev/null 2>&1; then
    wireless_state=$(ubus -S -t 3 call network.wireless status '{}' 2>/dev/null || :)
    guest_if=$(printf '%s' "$wireless_state" | jsonfilter -e '@.radio0.interfaces[@.section="veci_guest"].ifname' 2>/dev/null || :)
    case "$guest_if" in
      ''|*[!A-Za-z0-9_.-]*) ;;
      *)
        if iw dev "$guest_if" info 2>/dev/null | grep -Eq '^[[:space:]]*type AP$'; then
          hostapd_state=$(ubus -S -t 3 call "hostapd.$guest_if" get_status '{}' 2>/dev/null |
                          jsonfilter -e '@.status' 2>/dev/null || :)
          if [ "$hostapd_state" = ENABLED ]; then ap_state=ap_running_unverified; fi
        fi ;;
    esac
  fi
fi
# Isolasi runtime tidak dapat diklaim tanpa nft + actual guest/client UAT.
printf '{"ok":true,"installed":%s,"configured":%s,"enabled_configured":%s,"configuration_state":"%s","guest_ap_runtime":"%s","guest_isolation_verified":null}\n' "$installed" "$configured" "$enabled" "$mode" "$ap_state"
