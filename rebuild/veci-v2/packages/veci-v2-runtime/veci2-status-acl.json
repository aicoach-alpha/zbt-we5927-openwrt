{
  "veci-v2-dns": {
    "description": "Manage upstream DNS via authenticated local dnsmasq",
    "read": {
      "ubus": {
        "veci.v2.dns": [
          "status"
        ]
      }
    },
    "write": {
      "ubus": {
        "veci.v2.dns": [
          "set"
        ]
      }
    }
  },
  "veci-v2-firmware": {
    "description": "Verify a firmware upload in RAM",
    "write": {
      "ubus": {
        "veci.v2.firmware": [
          "verify",
          "apply"
        ]
      }
    }
  },
  "veci-v2-lte": {
    "description": "Read cellular preferences and change automatic SIM failover",
    "read": {
      "ubus": {
        "veci.v2.lte": [
          "status"
        ]
      }
    },
    "write": {
      "ubus": {
        "veci.v2.lte": [
          "setFailover",
          "setApn"
        ]
      }
    }
  },
  "veci-v2-runtime": {
    "description": "VeCI v2 read-only exact-board diagnostics",
    "read": {
      "ubus": {
        "veci.v2": [
          "status",
          "capabilities",
          "smsProvider",
          "ethernetPorts"
        ]
      }
    },
    "write": {
      "ubus": {}
    }
  },
  "veci-v2-wifi": {
    "description": "Primary AP name and visibility",
    "read": {
      "ubus": {
        "veci.v2.wifi": [
          "status"
        ]
      }
    },
    "write": {
      "ubus": {
        "veci.v2.wifi": [
          "setVisibility",
          "setSsid",
          "setAutoChannel"
        ]
      }
    }
  }
}
