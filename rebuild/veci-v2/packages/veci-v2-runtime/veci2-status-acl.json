{
  "veci-v2-runtime": {
    "description": "VeCI v2 read-only exact-board diagnostics",
    "read": {
      "ubus": {
        "veci.v2": [
          "status",
          "capabilities",
          "smsProvider",
          "ethernetPorts"
        ]
      }
    },
    "write": {
      "ubus": {}
    }
  },
  "veci-v2-firmware": {
    "description": "Verify a firmware upload in RAM",
    "write": {
      "ubus": {
        "veci.v2.firmware": [
          "verify"
        ]
      }
    }
  }
}
