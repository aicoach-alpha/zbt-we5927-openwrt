{
  "veci-v2-runtime": {
    "description": "VeCI v2 read-only exact-board diagnostics",
    "read": {
      "ubus": {
        "session": ["destroy"],
        "veci.v2": [
          "status",
          "capabilities",
          "smsProvider",
          "ethernetPorts"
        ]
      }
    },
    "write": {
      "ubus": {}
    }
  },
  "veci-v2-firmware": {
    "description": "Verify a firmware upload in RAM",
    "write": {
      "ubus": {
        "veci.v2.firmware": [
          "verify",
          "apply"
        ]
      }
    }
  },
  "veci-v2-wifi": {
    "description": "Primary AP name and visibility",
    "read": {
      "ubus": {
        "veci.v2.wifi": [
          "status",
          "info"
        ]
      }
    },
    "write": {
      "ubus": {
        "veci.v2.wifi": [
          "setVisibility",
          "setSsid",
          "setAutoChannel",
          "survey",
          "setChannel",
          "setAccess",
          "setAuth"
        ]
      }
    }
  },
  "veci-v2-lte": {
    "description": "Read cellular preferences and change automatic SIM failover",
    "read": {
      "ubus": {
        "veci.v2.simlock": ["status"],
        "veci.v2.ussd": ["status"],
        "veci.v2.lte": [
          "status"
        ]
      }
    },
    "write": {
      "ubus": {
        "veci.v2.simlock": ["unlock"],
        "veci.v2.ussd": ["send", "cancel"],
        "veci.v2.lte": [
          "setFailover",
          "setApn",
          "queueSim"
        ]
      }
    }
  },
  "veci-v2-firmware-policy": {
    "description": "Configure manual firmware installation policy",
    "read": {
      "ubus": {
        "veci.v2.updatepolicy": [
          "status"
        ]
      }
    },
    "write": {
      "ubus": {
        "veci.v2.updatepolicy": [
          "save"
        ]
      }
    }
  }
}
