#!/bin/sh
set -e
umask 077
fail() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 0; }
case "$1:${2:-}" in
 list:*) echo '{"status":{},"send":{"slot":"String","code":"String","confirm":"String"},"cancel":{"slot":"String","confirm":"String"}}'; exit 0 ;;
 call:status|call:send|call:cancel) ;;
 *) fail unsupported_method ;;
esac
[ "$(cat /tmp/sysinfo/board_name)" = zbtlink,zbt-we5927 ] || fail unsupported_board
manager=/usr/sbin/we5927-lte
at=/usr/sbin/we5927-at
exec 8<"$manager"; flock -n 8 || fail sim_busy
exec 9>/var/lock/we5927-at.lock; flock -n 9 || fail modem_busy
slot=$("$manager" selector-slot) || fail sim_unavailable
case "$slot" in 1|2) ;; *) fail sim_unavailable ;; esac
port=$("$manager" at-port) || fail modem_unavailable
pending=/var/run/veci2-ussd-slot-$slot
raw=$("$at" "$port" 'AT+CUSD=?' 1000) || fail unsupported_modem
available=false
printf '%s\n' "$raw" | tr -d '\r' | grep -Eq '^\+CUSD: *\((0-2|0,1,2)\)$' && available=true
if [ "$2" = status ]; then
  waiting=false; [ ! -f "$pending" ] || waiting=true
  printf '{"ok":true,"slot":%s,"available":%s,"pending":%s}\n' "$slot" "$available" "$waiting"
  exit 0
fi
[ "$available" = true ] || fail unsupported_modem
request=$(head -c 193)
[ "${#request}" -le 192 ] || fail invalid_request
field() { printf '%s' "$request" | jsonfilter -e "@.$1"; }
[ "$(field slot)" = "$slot" ] && [ "$("$manager" selector-slot)" = "$slot" ] || fail sim_changed
if [ "$2" = cancel ]; then
  [ "$(field confirm)" = CANCEL_USSD ] && [ -f "$pending" ] || fail no_pending_request
  "$at" "$port" 'AT+CUSD=2' 1500 >/dev/null || fail cancel_unconfirmed
  rm -f "$pending"
  echo '{"ok":true,"cancelled":true}'; exit 0
fi
[ "$(field confirm)" = SEND_USSD_ONCE ] || fail confirmation_required
[ ! -f "$pending" ] || fail previous_request_pending
code=$(field code) || fail invalid_code
case "$code" in *[!0-9#*]*|'') fail invalid_code ;; esac
case "$code" in [*#]*[0-9]*'#') ;; *) fail invalid_code ;; esac
[ "${#code}" -le 32 ] || fail invalid_code
: > "$pending"
reply=$(printf '%s\n' "$code" | "$at" "$port" --ussd-stdin 14000) || fail response_unconfirmed
m=$(printf '%s\n' "$reply" | sed -n 's/^+CUSD: *\([0-5]\)\(,.*\)\{0,1\}$/\1/p')
case "$m" in 1) ;; 0|2|3|4|5) rm -f "$pending" ;; *) fail response_unconfirmed ;; esac
. /usr/share/libubox/jshn.sh
json_init
json_add_boolean ok 1
json_add_int status "$m"
json_add_string response "$reply"
json_dump
