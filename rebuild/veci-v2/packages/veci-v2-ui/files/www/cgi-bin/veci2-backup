#!/bin/sh
# Export exactly the configuration archive generated by OpenWrt sysupgrade.
set -eu
umask 077
fail() {
  printf 'Status: %s\r\nContent-Type: text/plain\r\nCache-Control: no-store\r\n\r\n%s\n' "$1" "$2"
  exit 0
}
[ "${HTTPS:-}" = on ] || fail '403 Forbidden' https_required
[ "${REQUEST_METHOD:-}:${CONTENT_TYPE:-}:${CONTENT_LENGTH:-}" = POST:application/octet-stream:32 ] || fail '400 Bad Request' invalid_request
session=$(head -c 32)
case "$session" in *[!0-9a-f]*|00000000000000000000000000000000) fail '403 Forbidden' access_denied ;; esac
[ "${#session}" -eq 32 ] || fail '403 Forbidden' access_denied
authorized() {
  permit=$(ubus -t 3 call session access "{\"ubus_rpc_session\":\"$session\",\"scope\":\"ubus\",\"object\":\"veci.v2.backup\",\"function\":\"export\"}" | jsonfilter -e '@.access') && [ "$permit" = true ]
}
authorized || fail '403 Forbidden' access_denied
[ "$(cat /tmp/sysinfo/board_name)" = zbtlink,zbt-we5927 ] || fail '409 Conflict' unsupported_board
exec 9<"$0"
flock -n 9 || fail '409 Conflict' backup_busy
work=$(mktemp -d /tmp/veci2-backup.XXXXXX) || fail '507 Insufficient Storage' backup_failed
trap 'rm -rf "$work"' EXIT
trap 'exit 1' HUP INT TERM
(ulimit -f 2048 && sysupgrade -b "$work/config.tgz") >/dev/null 2>&1 || fail '507 Insufficient Storage' backup_failed
bytes=$(wc -c <"$work/config.tgz")
[ "$bytes" -gt 0 ] && [ "$bytes" -le 2097152 ] && gzip -t "$work/config.tgz" || fail '500 Internal Server Error' invalid_archive
digest=$(sha256sum "$work/config.tgz") || fail '500 Internal Server Error' digest_failed
authorized || fail '403 Forbidden' access_denied
printf 'Content-Type: application/gzip\r\nContent-Disposition: attachment; filename="VeCI-WE5927-config.tar.gz"\r\nCache-Control: no-store\r\nContent-Length: %s\r\nX-Archive-SHA256: %s\r\n\r\n' "$bytes" "${digest%% *}"
cat "$work/config.tgz"
