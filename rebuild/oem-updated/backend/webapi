#!/bin/sh
# OEM-compatible authenticated CGI gateway. Development only; no flash approval.
# Login is performed through native /ubus session.login, not this CGI.
set -e
umask 077
. /usr/share/libubox/jshn.sh
reply() {
    printf 'Content-Type: application/json\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n\r\n'
    printf '%s\n' "$1"
    exit 0
}
err() { json_init; json_add_string code "$1"; json_add_string reason "$2"; reply "$(json_dump)"; }
[ "${HTTPS:-}" = on ] || err -1 "HTTPS required"
QUERY_STRING="${QUERY_STRING:-}"
[ "${#QUERY_STRING}" -le 1024 ] || err -4 "query too large"
# Only the operation is consumed. No eval, shell-sourced input, or legacy CGI.
op=
op_seen=0
module_section=
module_seen=0
sim_seen=0
sim_preview=
host=
host_seen=0
version=4
version_seen=0
mode_seen=0
oldifs=$IFS; IFS='&'; set -f
for arg in $QUERY_STRING; do
    case "$arg" in
        op=*) [ "$op_seen" = 0 ] || err -4 "duplicate operation"; op_seen=1; op="${arg#op=}";;
        access_token=*|password=*|username=*) err -4 "credentials in URL refused";;
        module_section=*)
            [ "$module_seen" = 0 ] || err -4 "duplicate module"
            module_seen=1
            module_section="${arg#module_section=}"
            case "$module_section" in lte|4gwan|4gwan1) ;; *) err -4 "unknown modem";; esac;;
        SIMX=*)
            [ "$sim_seen" = 0 ] || err -4 "duplicate SIM preview"
            sim_seen=1; sim_preview="${arg#SIMX=}"
            case "$sim_preview" in SIM1|SIM2) ;; *) err -4 "invalid SIM preview";; esac;;
        host=*)
            [ "$host_seen" = 0 ] || err -4 "duplicate host"
            host_seen=1; host="${arg#host=}"
            case "$host" in ''|-*|*[!a-zA-Z0-9.:-]*) err -4 "invalid host";; esac;;
        ipversion=*)
            [ "$version_seen" = 0 ] || err -4 "duplicate IP version"
            version_seen=1; version="${arg#ipversion=}"
            case "$version" in 4|6) ;; *) err -4 "invalid IP version";; esac;;
        wifimode=*)
            [ "$mode_seen" = 0 ] || err -4 "duplicate Wi-Fi mode"
            mode_seen=1; [ "${arg#wifimode=}" = 2 ] || err -4 "only 2.4 GHz is supported";;
        t=*) ;;
        *) err -4 "unexpected parameter";;
    esac
done
IFS=$oldifs
case "$op" in ''|*[!a-zA-Z0-9_]*) err -4 "invalid operation";; esac
if [ "$module_seen" = 1 ]; then
    case "$op" in get_module_status|get_module_signal|get_4g|get_4g_log|set_4g|set_4g_sim) ;; *) err -4 "unexpected module parameter";; esac
fi
[ "$sim_seen" = 0 ] || [ "$op" = get_4g ] || err -4 "unexpected SIM parameter"
if [ "$host_seen" = 1 ] || [ "$version_seen" = 1 ]; then
    case "$op" in test_ping|test_nslookup|test_traceroute) ;; *) err -4 "unexpected diagnostic parameter";; esac
fi
[ "$mode_seen" = 0 ] || [ "$op" = site_survey ] || err -4 "unexpected Wi-Fi mode"
case "$op" in
    language_get)
        [ "${REQUEST_METHOD:-}" = GET ] || err -4 "method refused"
        reply '{"code":"1","reason":"success","language":""}' ;;
esac
session="${HTTP_X_OEM_SESSION:-}"
case "$session" in ''|*[!0-9a-f]*|00000000000000000000000000000000) err -1 "access denied";; esac
[ "${#session}" -eq 32 ] || err -1 "access denied"
# Require an authenticated native rpcd session with explicit OEM read scope.
permit="$(ubus -t 3 call session access "{\"ubus_rpc_session\":\"$session\",\"scope\":\"ubus\",\"object\":\"oem.updated\",\"function\":\"read\"}" | jsonfilter -e '@.access')" || err -1 "session unavailable"
[ "$permit" = true ] || err -1 "access denied"
case "$op" in
    activate_ngrokc|get_cloud_login|set_cloud_login|get_ac_info|set_ac_info|get_ac_switch|set_ac_switch)
        err -4 "Proprietary OEM cloud management is not supported; use authenticated local management" ;;
    set_wan_config_nocommit|setWiFi2_nocommit|guide_commit)
        err -4 "Legacy wizard staging is not supported; use explicit network or Wi-Fi save controls" ;;
    bootflag|setbootflag)
        err -4 "Legacy boot flag is not supported; use verified firmware recovery" ;;
    send_at) err -4 "Raw modem commands disabled on WE5927-2SIM" ;;
    set_imei) err -4 "Modem identity is read-only on WE5927-2SIM" ;;
    getWiFi5|setWiFi5|setWiFi5_nocommit|get_wifi_guest5|set_wifi_guest5)
        err -4 "5 GHz radio unavailable on WE5927-2SIM" ;;
    test_wget)
        # Fixed native LTE HTTPS diagnostic, not an arbitrary URL downloader.
        [ "${REQUEST_METHOD:-}" = GET ] || err -4 "method refused"
        permit="$(ubus -t 3 call session access "{\"ubus_rpc_session\":\"$session\",\"scope\":\"ubus\",\"object\":\"veci.v2\",\"function\":\"internetCheck\"}" | jsonfilter -e '@.access')" || err -1 "native diagnostic permission unavailable"
        [ "$permit" = true ] || err -1 "native diagnostic permission denied"
        exec 9>/var/lock/oem-internet-check.lock
        flock -n 9 || err -4 "internet diagnostic busy"
        native="$(ubus -t 17 call veci.v2 internetCheck '{}')" || err -4 "native diagnostic unavailable"
        field() { printf '%s' "$native" | jsonfilter -e "$1"; }
        [ "$(field '@.source')" = usb0_https ] || err -4 "unexpected diagnostic source"
        verified="$(field '@.verified')" || err -4 "invalid native result"
        case "$verified" in true|false) ;; *) err -4 "invalid native result";; esac
        reason="$(field '@.reason')" || err -4 "invalid native result"
        case "$reason" in
            verified_public_https_and_dns|hostname_dns_or_endpoint_unavailable|lte_interface_unavailable|public_and_modem_unavailable) ;;
            modem_connected_public_unavailable_check_quota) reason=modem_connected_public_unavailable ;;
            *) err -4 "unexpected native diagnostic result";;
        esac
        [ "$verified:$reason" != true:verified_public_https_and_dns ] || [ "$(field '@.https_code')" = 200 ] || err -4 "invalid native verification"
        case "$verified:$reason" in true:verified_public_https_and_dns|false:hostname_dns_or_endpoint_unavailable|false:lte_interface_unavailable|false:public_and_modem_unavailable|false:modem_connected_public_unavailable) ;; *) err -4 "inconsistent native result";; esac
        json_init; json_add_string code 1; json_add_string reason "$reason"
        json_add_string source usb0_https
        json_add_boolean verified "$(if [ "$verified" = true ]; then echo 1; else echo 0; fi)"
        json_add_string data "Fixed LTE HTTPS diagnostic: $reason"
        json_add_boolean arbitrary_url_supported 0
        reply "$(json_dump)" ;;
    test_ping|test_nslookup|test_traceroute|site_survey)
        [ "${REQUEST_METHOD:-}" = GET ] || err -4 "method refused"
        data="$(/usr/libexec/oem-updated/diagnostics-adapter "$op" "$host" "$version" "$session")" || err -4 "diagnostic unavailable"
        [ -n "$data" ] || err -4 "diagnostic unavailable"
        reply "$data" ;;
    get_ddns_log|get_log_list|get_4g_log)
        [ "${REQUEST_METHOD:-}" = GET ] || err -4 "method refused"
        permit="$(ubus -t 3 call session access "{\"ubus_rpc_session\":\"$session\",\"scope\":\"ubus\",\"object\":\"veci.v2.system\",\"function\":\"logs\"}" | jsonfilter -e '@.access')" || err -1 "native log permission unavailable"
        [ "$permit" = true ] || err -1 "native log permission denied"
        data="$(/usr/libexec/oem-updated/read-only-adapter "$op")" || err -4 "native log unavailable"
        reply "$data" ;;
    sysupgrade_backup)
        # Stream the existing native authenticated backup; never publish a
        # private archive in the document root or use a token in its URL.
        [ "${REQUEST_METHOD:-}" = POST ] || err -4 "POST required for private backup"
        printf '%s' "$session" | REQUEST_METHOD=POST CONTENT_TYPE=application/octet-stream CONTENT_LENGTH=32 QUERY_STRING= /usr/libexec/oem-updated/shared-backup
        exit 0 ;;
    home_json)
        [ "${REQUEST_METHOD:-}" = GET ] || err -4 "method refused"
        data="$(timeout 24 /usr/libexec/oem-updated/home-adapter)" || err -4 "dashboard unavailable or busy"
        [ -n "$data" ] || err -4 "dashboard unavailable"
        reply "$data" ;;
    logout)
        [ "${REQUEST_METHOD:-}" = POST ] || err -4 "method refused"
        ubus -t 3 call session destroy "{\"ubus_rpc_session\":\"$session\"}" >/dev/null || err -4 "logout failed"
        reply '{"code":"1","reason":"success"}' ;;
    long_link)
        [ "${REQUEST_METHOD:-}" = GET ] || err -4 "method refused"
        reply '{"code":"1","reason":"success"}' ;;
    set_acl_rule|set_acl_status|set_qos|set_ttl|ddns_detection|set_ddns|set_qos_status|pppoe_detection|pppoe_disconnect|pppoe_reconnect|set_wifi_client|set_wifi_power|setAutoreboot|set_mac_blacklist|set_fw_setting|set_nat_acceleration|set_wifi_guest|set_dhcp_config|set_static_dhcp|delete_static_dhcp|set_ntp|set_dmz|set_lan_config|set_wan_config|set_4g|set_4g_sim|set_netwatchdog|setWiFi2|set_static_route|set_redirect_dnat)
        [ "${REQUEST_METHOD:-}" = POST ] || err -4 "method refused"
        case "${CONTENT_TYPE:-}" in application/json|application/json\;*) ;; *) err -4 "JSON required";; esac
        case "${CONTENT_LENGTH:-}" in ''|*[!0-9]*) err -4 "invalid body length";; esac
        [ "${#CONTENT_LENGTH}" -le 4 ] && [ "$CONTENT_LENGTH" -gt 0 ] && [ "$CONTENT_LENGTH" -le 2048 ] || err -4 "invalid body length"
        permit="$(ubus -t 3 call session access "{\"ubus_rpc_session\":\"$session\",\"scope\":\"ubus\",\"object\":\"oem.updated\",\"function\":\"write\"}" | jsonfilter -e '@.access')" || err -1 "write permission unavailable"
        [ "$permit" = true ] || err -1 "write permission denied"
        body="$(head -c "$CONTENT_LENGTH")"
        [ "$(printf '%s' "$body" | wc -c)" = "$CONTENT_LENGTH" ] || err -4 "body length mismatch"
        data="$(printf '%s' "$body" | /usr/libexec/oem-updated/write-adapter "$op" "$session")" || err -4 "native write failed"
        [ -n "$data" ] || err -4 "native write unavailable"
        reply "$data" ;;
    get_sys_version|get_lan_config|get_dhcp_config|get_netwatchdog|get_nat_acceleration|get_web_msg|get_module_status|get_ntp|get_static_dhcp|get_dmz|get_module_signal|get_arp|get_dhcp_allocation|get_wan_config|getWiFi2|get_pppoe_status|get_4g|get_wifi_guest|get_static_route|get_redirect_dnat|get_lan_status|get_wan_status|get_system_status|get_wifi_client|get_fw_setting|get_port|get_network_topology|get_wan_traffic|online_upgrade_check|get_days_traffic|refresh_days_traffic|get_disk|get_wifi_power|get_imei|search_ctcode_and_channals|get_wifi_apclient_config|get_wifi_apclient_status|app_home|get_mac_blacklist|getAutoreboot|get_acl_rule|get_acl_status|get_ddns|get_ddns_stat|get_qos|get_qos_status|get_ttl|get_mptcp_info|get_openvpn_msg|get_openvpn_status|get_pptp_msg|get_l2tp_msg|get_pptp_status|get_l2tp_status|get_pptp_sl_status|get_l2tp_sl_status)
        [ "${REQUEST_METHOD:-}" = GET ] || err -4 "method refused"
        if [ "$sim_seen" = 1 ]; then
            data="$(/usr/libexec/oem-updated/read-only-adapter "$op" "$sim_preview")" || err -4 "backend unavailable"
        else
            data="$(/usr/libexec/oem-updated/read-only-adapter "$op")" || err -4 "backend unavailable"
        fi
        [ -n "$data" ] || err -4 "backend unavailable"
        reply "$data" ;;
    *) err -4 "operation not implemented" ;;
esac
