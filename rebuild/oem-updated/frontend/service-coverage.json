{
  "schema": 1,
  "state": "STAGED_NOT_RUNTIME_VERIFIED",
  "entry": "/oem-tools/",
  "auth": "independent HTTPS rpcd session, memory only",
  "services": {
    "sms": {
      "provider": "veci.sms",
      "methods": [
        "getConfig",
        "setEnabled",
        "listMessages",
        "sendMessage",
        "deleteMessage",
        "getSent",
        "getDrafts",
        "saveDraft",
        "deleteDraft"
      ]
    },
    "dns": {
      "provider": "veci.v2.dns",
      "methods": [
        "status",
        "set"
      ]
    },
    "configuration_backup": {
      "provider": "native veci2-backup",
      "route": "POST /cgi-bin/veci2-backup"
    },
    "configuration_restore": {
      "provider": "native veci2-restore",
      "phases": [
        "inspect",
        "apply"
      ]
    },
    "firmware_verification": {
      "provider": "native veci2-verify",
      "route": "POST /cgi-bin/oem-verify",
      "install_allowed": false
    },
    "dhcp_pool": {
      "provider": "veci.v2.dhcp",
      "methods": [
        "status",
        "setPool"
      ],
      "state": "SOURCE_INTEGRATED_NOT_UAT"
    },
    "traffic_history": {
      "provider": "veci.v2.observability",
      "methods": [
        "trafficHistory"
      ],
      "scope": "local trailing 24 hours, RAM only, not quota",
      "state": "SOURCE_INTEGRATED_NOT_UAT"
    },
    "guest_wifi": {
      "provider": "veci.v2.addon",
      "methods": [
        "status",
        "setPortalStartup"
      ],
      "default": "absent_disabled",
      "activation": "explicit manual configuration, subsequent manual reboot",
      "state": "SOURCE_INTEGRATED_FOR_PREPROVISIONED_PROFILE",
      "limitations": "safe first-time provisioning pending"
    },
    "firewall_defaults": {
      "provider": "veci.v2.firewall",
      "methods": [
        "status",
        "setDefaults",
        "setOffload"
      ],
      "state": "SOURCE_INTEGRATED_NOT_UAT"
    },
    "native_dashboard": {
      "provider": "OEM read adapters + shared OpenWrt runtime",
      "state": "SOURCE_STAGED_NOT_RUNTIME_VERIFIED",
      "polling": "10s single-flight",
      "cpu": "measured, vendor random reduction removed"
    },
    "mac_access_control": {
      "provider": "veci.v2.firewall",
      "methods": [
        "status",
        "setMacBlock"
      ],
      "scope": "LAN to WAN, not router management",
      "state": "SOURCE_STAGED_NOT_RUNTIME_VERIFIED",
      "original_oem_client_action": "source adapted; browser/runtime pending"
    },
    "wifi_power": {
      "provider": "veci.v2.wifi",
      "methods": [
        "power",
        "setPower"
      ],
      "state": "SOURCE_INTEGRATED_NOT_UAT"
    },
    "scheduled_reboot": {
      "provider": "veci.v2.cron",
      "methods": [
        "rebootStatus",
        "setReboot"
      ],
      "default": "disabled",
      "state": "SOURCE_INTEGRATED_NOT_UAT"
    },
    "language": {
      "provider": "browser local storage",
      "state": "SOURCE_INTEGRATED_NOT_UAT"
    },
    "native_acl_inventory": {
      "provider": "OpenWrt firewall UCI + native status",
      "scope": "read-only; no global ACL switch",
      "state": "SOURCE_INTEGRATED_NOT_UAT"
    },
    "pppoe": {
      "provider": "veci.v2.interfaces",
      "methods": [
        "pppoeStatus",
        "pppoeDiscovery",
        "pppoeAction"
      ],
      "scope": "existing Ethernet WAN profile; no LTE reset",
      "original_oem_buttons": "source patched and syntax checked",
      "state": "SOURCE_INTEGRATED_NOT_UAT",
      "limitations": "profile creation, physical device mapping, discovery and reconnect not verified"
    }
  },
  "remaining": [
    "integrate OEM navigation and legacy forms",
    "hardware and browser acceptance",
    "legacy seven-day chart adaptation / persistent history policy",
    "guest Wi-Fi activation without legacy network reload"
  ]
}
