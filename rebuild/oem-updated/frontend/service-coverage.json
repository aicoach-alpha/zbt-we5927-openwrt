{
  "schema": 1,
  "state": "STAGED_NOT_RUNTIME_VERIFIED",
  "entry": "/oem-tools/",
  "auth": "independent HTTPS rpcd session, memory only",
  "services": {
    "sms": {
      "provider": "veci.sms",
      "methods": [
        "getConfig",
        "setEnabled",
        "listMessages",
        "sendMessage",
        "deleteMessage",
        "getSent",
        "getDrafts",
        "saveDraft",
        "deleteDraft"
      ]
    },
    "dns": {
      "provider": "veci.v2.dns",
      "methods": [
        "status",
        "set"
      ]
    },
    "configuration_backup": {
      "provider": "native veci2-backup",
      "route": "POST /cgi-bin/veci2-backup"
    },
    "configuration_restore": {
      "provider": "native veci2-restore",
      "phases": [
        "inspect",
        "apply"
      ]
    },
    "firmware_verification": {
      "provider": "native veci2-verify",
      "route": "POST /cgi-bin/oem-verify",
      "install_allowed": false
    },
    "dhcp_pool": {
      "provider": "veci.v2.dhcp",
      "methods": [
        "status",
        "setPool"
      ],
      "state": "SOURCE_INTEGRATED_NOT_UAT"
    },
    "traffic_history": {
      "provider": "veci.v2.observability",
      "methods": [
        "trafficHistory"
      ],
      "scope": "local trailing 24 hours, RAM only, not quota",
      "state": "SOURCE_INTEGRATED_NOT_UAT"
    },
    "guest_wifi": {
      "provider": "veci.v2.addon",
      "methods": [
        "status",
        "setPortalStartup"
      ],
      "default": "absent_disabled",
      "activation": "explicit manual configuration, subsequent manual reboot",
      "state": "SOURCE_INTEGRATED_FOR_PREPROVISIONED_PROFILE",
      "limitations": "safe first-time provisioning pending"
    }
  },
  "remaining": [
    "integrate OEM navigation and legacy forms",
    "hardware and browser acceptance",
    "legacy seven-day chart adaptation / persistent history policy",
    "guest Wi-Fi activation without legacy network reload"
  ]
}
